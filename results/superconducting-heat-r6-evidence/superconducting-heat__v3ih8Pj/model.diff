     def fit(self, records):
-        raise NotImplementedError("Fit conductance from the calibration records")
+        """Fit the one apparatus parameter from weighted calibration data."""
+        if not records:
+            raise ValueError("records must not be empty")
+
+        inputs = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (values.ndim != 1 or sigmas.ndim != 1 or
+                not np.isfinite(values).all() or
+                not np.isfinite(sigmas).all() or np.any(sigmas <= 0)):
+            raise ValueError("record values and sigmas must be finite, positive arrays")
+
+        # With no rotating barrier and no oscillator, every readout (including
+        # a phase contrast) is exactly proportional to the conductance.
+        simple = all(float(e.get('amplitude', 0.)) == 0. and
+                     float(e.get('oscillator_coupling', 0.)) == 0.
+                     for e in inputs)
+        if simple:
+            unit = np.asarray([predict_at([e], 1.)[0] for e in inputs])
+            weights = 1. / sigmas**2
+            denominator = float(np.sum(weights * unit * unit))
+            if denominator <= 0. or not np.isfinite(denominator):
+                estimate = 50.
+            else:
+                estimate = float(np.sum(weights * unit * values) / denominator)
+        else:
+            def objective(conductance):
+                prediction = predict_at(inputs, float(conductance))
+                residual = (prediction - values) / sigmas
+                return float(residual @ residual)
+
+            result = minimize_scalar(objective, bounds=(20., 80.), method='bounded',
+                                     options={'xatol': 1e-8, 'maxiter': 100})
+            estimate = float(result.x)
+
+        self.conductance = float(np.clip(estimate, 20., 80.))
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.conductance)
 
 
