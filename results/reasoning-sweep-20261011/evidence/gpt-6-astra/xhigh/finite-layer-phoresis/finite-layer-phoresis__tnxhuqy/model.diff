+        """Fit inverse viscosity by Gaussian weighted least squares."""
+        records = list(records)
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+
+        values = np.array([r['value'] for r in records], dtype=float)
+        sigma = np.array([r['sigma'] for r in records], dtype=float)
+        if not np.isfinite(values).all() or not np.isfinite(sigma).all() or np.any(sigma <= 0):
+            raise ValueError('Calibration values must be finite and uncertainties positive.')
+
+        unit_response = predict_at((r['input'] for r in records), 1.)
+        weighted_response = unit_response / sigma
+        information = np.dot(weighted_response, weighted_response)
+        if information == 0:
+            raise ValueError('Calibration must contain a nonzero interaction response.')
+
+        inverse_viscosity = np.dot(weighted_response, values / sigma) / information
+        # The known physical range constrains the one-parameter likelihood.
+        inverse_viscosity = np.clip(inverse_viscosity, 1 / 1.6, 1 / .8)
+        self.viscosity = float(1 / inverse_viscosity)
+        return self
 
