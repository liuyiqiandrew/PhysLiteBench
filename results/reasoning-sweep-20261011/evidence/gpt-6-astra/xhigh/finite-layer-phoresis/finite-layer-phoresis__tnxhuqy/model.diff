+@lru_cache(256)
+def _response_moments(radius, width, strength):
+    """Integrate the two hydrodynamic weights at unit concentration gradient.
+
+    Write the dipolar concentration as exp(-U) * f(r) * cos(theta).
+    With negligible advection, (r**2 * exp(-U) * f')' = 2 * exp(-U) * f.
+    The solution outside the potential is r + C/r**2, so its far-field
+    condition can be imposed exactly at the outer edge of the layer.
+    """
+    end = radius + width
+
+    def equations(x, y):
+        r = radius + width * x
+        return np.array([
+            y[1],
+            -(2 * width / r + 2 * strength * (1 - x)) * y[1]
+            + 2 * width**2 * y[0] / r**2,
+        ])
+
+    def boundary(left, right):
+        return np.array([left[1], end * right[1] / width + 2 * right[0] - 3 * end])
+
+    grid = np.linspace(0., 1., 129)
+    r = radius + width * grid
+    initial = np.array([r + radius**3 / (2 * r**2), width * (1 - radius**3 / r**3)])
+    solution = solve_bvp(
+        equations, boundary, grid, initial, tol=2e-10, max_nodes=10000,
+    )
+    if not solution.success:
+        raise RuntimeError(solution.message)
+
+    def integrand(x):
+        z = width * x
+        r = radius + z
+        concentration = np.exp(-strength * (1 - x)**2) * solution.sol(x)[0]
+        # dU/dx already includes the Jacobian dr/dx of the radial integral.
+        derivative = -2 * strength * (1 - x)
+        weights = np.array([
+            z**2 * (2 * r + radius) / (2 * r),
+            z * (r + radius) / (2 * r),
+        ])
+        return weights * concentration * derivative
+
+    moments, _ = quad_vec(integrand, 0., 1., epsabs=2e-11, epsrel=2e-11)
+    return tuple(moments)
 
 
