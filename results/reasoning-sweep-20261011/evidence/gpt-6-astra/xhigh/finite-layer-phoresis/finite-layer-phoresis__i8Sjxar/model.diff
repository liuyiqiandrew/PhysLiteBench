     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Fit the sole unknown by Gaussian weighted least squares.
+
+        Predictions are linear in inverse viscosity, giving an exact
+        one-parameter fit constrained to the documented viscosity range.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+        values = np.array([r['value'] for r in records], dtype=float)
+        sigmas = np.array([r['sigma'] for r in records], dtype=float)
+        if not np.all(np.isfinite(values)):
+            raise ValueError("calibration values must be finite")
+        if not np.all(np.isfinite(sigmas) & (sigmas > 0)):
+            raise ValueError("calibration uncertainties must be finite and positive")
+
+        unit_response = predict_at([r['input'] for r in records], 1.0)
+        design = unit_response/sigmas
+        information = np.dot(design, design)
+        if information == 0:
+            raise ValueError("calibration records do not determine viscosity")
+        inverse_viscosity = np.dot(design, values/sigmas)/information
+        inverse_viscosity = np.clip(inverse_viscosity, 1/1.6, 1/0.8)
+        self.viscosity = float(1/inverse_viscosity)
+        return self
 
