+    def fit(self, records):
+        """Gaussian maximum-likelihood fit to the documented calibration.
+
+        Its prediction is c_i/friction, so weighted least squares in
+        inverse friction gives the constrained optimum directly.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required.")
+        sigma = np.array([r["sigma"] for r in records], dtype=float)
+        values = np.array([r["value"] for r in records], dtype=float)
+        if not np.all(np.isfinite(sigma) & (sigma > 0)):
+            raise ValueError("Calibration uncertainties must be finite and positive.")
+        if not np.all(np.isfinite(values)):
+            raise ValueError("Calibration values must be finite.")
+        c = coefficients([r["input"] for r in records], friction=1.0) / sigma
+        information = float(c @ c)
+        if not np.isfinite(information) or information <= 0:
+            raise ValueError("Calibration must identify the friction coefficient.")
+        inverse_friction = float(c @ (values / sigma)) / information
+        self.friction = float(1 / np.clip(inverse_friction, 1 / 1.6, 1 / 0.7))
+        return self
+
+    def predict(self, experiments):
+        if self.friction is None:
+            raise ValueError("Fit the model before predicting.")
+        return coefficients(experiments, self.friction)
