+def limiting_state(e, friction, points=129):
+    """Compute the finite excess density after matched-background subtraction.
+
+    Densities integrate to one in the phase coordinate; differentiation
+    still uses physical x.  Uniform y has already been integrated out.
+    """
+    phase, d = spatial_grid(points)
+    d = d * e["wavenumber"]
+    dx = 2 * np.pi / points
+    factors, gx, gy, q = contact_parameters(e, friction)
+    count = len(gx)
+    force = (e["force_x"], e["force_y"])
+    magnetic = e["magnetic"]
+    local_t = e["temperature"] * (1 + e["contrast"] * np.cos(phase))
+    temperatures = factors[:, None] * local_t
+
+    # Fast invariant second moments per unit spatial density and temperature.
+    unit0 = {(0, 0): np.ones((count, 1)) / count}
+    unit2 = solve_moments(2, unit0, factors[:, None], gx, gy, magnetic, q)
+    _, a1 = moment_operator(1, gx, gy, magnetic, q)
+    force_source = np.tile(np.array(force) / count, count)
+    diff_source = np.column_stack(
+        (unit2[2, 0][:, 0], unit2[1, 1][:, 0])
+    ).ravel()
+    velocity = -np.linalg.solve(a1, force_source).reshape(count, 2).sum(axis=0)
+    diffusion = -np.linalg.solve(a1, diff_source).reshape(count, 2).sum(axis=0)
+
+    # The leading stationary flux is velocity*rho - diffusion*d_x(T*rho).
+    operator = -d @ (
+        velocity[0] * np.eye(points) - diffusion[0] * d * local_t[None, :]
+    )
+    operator[-1] = dx
+    rhs = np.zeros(points)
+    rhs[-1] = 1.0
+    density = np.linalg.solve(operator, rhs)
+    zeroth = {(0, 0): np.tile(density / count, (count, 1))}
+    second = solve_moments(2, zeroth, temperatures, gx, gy, magnetic, q)
+    fourth = solve_moments(4, second, temperatures, gx, gy, magnetic, q)
+    first = solve_moments(
+        1, {}, temperatures, gx, gy, magnetic, q, d, force, zeroth, second
+    )
+    third = solve_moments(
+        3, first, temperatures, gx, gy, magnetic, q, d, force, second, fourth
+    )
+
+    # At order m, contact continuity requires Q*r_s = d_x(first_x,s).
+    # Only the SUM of the population corrections can be chosen freely:
+    # individual contacts generally have nonzero spatial corrections.
+    # Fix that freedom by sum_s r_s = 0 at every position.  A bordered
+    # solve enforces the constraint without inverting the singular Q.
+    population_operator = np.zeros((count + 1, count + 1))
+    population_operator[:count, :count] = q
+    population_operator[:count, count] = 1 / count
+    population_operator[count, :count] = 1
+    population_rhs = np.zeros((count + 1, points))
+    population_rhs[:count] = first[1, 0] @ d.T
+    density_correction = {
+        (0, 0): np.linalg.solve(population_operator, population_rhs)[:count]
+    }
+    second_correction = solve_moments(
+        2, density_correction, temperatures, gx, gy, magnetic, q,
+        d, force, first, third,
+    )
+
+    # The uniform force-free background is exactly background/m.  Locally
+    # the leading heat is background*rho/m, independent of local_t.
+    # Any omitted total-density correction would contribute background*rho2
+    # to BOTH measurements, and cancels against the measured residence.
+    background = float(np.sum(
+        gx * (unit2[2, 0][:, 0] / factors - 1 / count)
+        + gy * (unit2[0, 2][:, 0] / factors - 1 / count)
+    ))
+    population = density_correction[0, 0]
+    local = np.sum(
+        gx[:, None] * (second_correction[2, 0] / temperatures - population)
+        + gy[:, None] * (second_correction[0, 2] / temperatures - population),
+        axis=0,
+    ) - background * population.sum(axis=0)
+    return dict(
+        value=float(dx * local.sum()), local=local, phase=phase, density=density,
+        diffusion=diffusion, velocity=velocity, dx=dx, first=first, second=second,
+        density_correction=density_correction, second_correction=second_correction,
+        temperatures=temperatures, background=background,
+    )
