+@lru_cache(maxsize=4096)
+def entropy_rate(
+    force_x, force_y, drag_ratio, magnetic, temperature, contrast, wavenumber,
+    bath_contrast, switch_rate, friction, detector_phase=None, valve_cycle=None,
+    contact_drag_contrast=0.0,
+):
+    # In the calibration preparation the valve is immaterial, and every
+    # rate scales exactly as 1/friction, including the spatial anomaly.
+    if bath_contrast == 0 and magnetic == 0 and valve_cycle is None and friction != 1:
+        return entropy_rate(
+            force_x, force_y, drag_ratio, magnetic, temperature, contrast,
+            wavenumber, bath_contrast, switch_rate, 1.0, detector_phase,
+        ) / friction
+    e = dict(zip(INPUT_FIELDS, (
+        force_x, force_y, drag_ratio, magnetic, temperature, contrast,
+        wavenumber, bath_contrast, switch_rate,
+    )))
+    if valve_cycle is not None:
+        e.update(valve_cycle=valve_cycle, contact_drag_contrast=contact_drag_contrast)
+    state = limiting_state(e, friction)
+    weight = (
+        1.0 if detector_phase is None
+        else (1 + np.cos(state["phase"] - detector_phase)) / 2
+    )
+    return float(state["dx"] * np.sum(weight * state["local"]))
+
+
+def coefficients(experiments, friction=1.0):
+    return np.array([
+        entropy_rate(
+            *(e[f] for f in INPUT_FIELDS), float(friction), e.get("detector_phase"),
+            e.get("valve_cycle"), e.get("contact_drag_contrast", 0.0),
+        )
+        for e in experiments
+    ], dtype=float)
