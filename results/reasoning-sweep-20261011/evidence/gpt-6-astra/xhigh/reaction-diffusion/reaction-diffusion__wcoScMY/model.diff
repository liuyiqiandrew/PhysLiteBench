+    """Return free A, free B, free C and P, with species on the last axis."""
+    total = np.asarray(total, dtype=float)
+    a, b = total[..., 0], total[..., 1]
+    bound = np.zeros_like(a)
+    upper = np.minimum(a, b)
+    # The residual increases strictly on [0, min(a,b)], so the physical
+    # root is unique. Newton steps from zero approach it from below.
+    for _ in range(64):
+        free_a, free_b = a - bound, b - bound
+        anion = free_a + free_b
+        residual = bound - ASSOCIATION * free_a * free_b * anion**2
+        slope = 1 + ASSOCIATION * (anion**3 + 4 * free_a * free_b * anion)
+        updated = np.clip(bound - residual / slope, 0.0, upper)
+        converged = np.all(np.abs(updated - bound) <= 2e-14 * (1 + upper))
+        bound = updated
+        if converged:
+            break
+    return np.stack((a - bound, b - bound, a + b - 2 * bound, bound), axis=-1)
