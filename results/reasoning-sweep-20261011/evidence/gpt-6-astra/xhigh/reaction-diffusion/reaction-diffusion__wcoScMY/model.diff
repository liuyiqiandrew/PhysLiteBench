+def _refine_initial(x, initial):
+    """Resolve the specified linear interpolant, retaining every input node."""
+    refinement = max(1, int(np.ceil(256 / (len(x) - 1))))
+    mesh = np.linspace(x[0], x[-1], refinement * (len(x) - 1) + 1)
+    refined = np.column_stack([
+        np.interp(mesh, x, initial[:, channel]) for channel in range(2)
+    ])
+    return mesh, refined, refinement
+
+
+def _binary_rates(x):
+    """Neumann finite-volume eigenvalues, excluding the common scale D."""
+    intervals = len(x) - 1
+    laplacian = (2 * np.sin(np.arange(intervals + 1) * np.pi / (2 * intervals))
+                 / (x[1] - x[0]))**2
+    # Zero current for a single monovalent salt gives 2 D+ D-/(D+ + D-).
+    return laplacian[:, None] * np.array([4 / 3, 8 / 3])
+
+
+def fluctuation_matrices(totals, diffusivity):
+    """Constituent susceptibility and mobility after eliminating charge.
+
+    Ideal species have population covariance diag(c). Charge neutrality
+    conditions that covariance on zero charge. Mapping it to conserved
+    constituents also integrates over the fast association fluctuations;
+    imposing an additional fixed-cluster constraint would be incorrect.
+
+    The same charge projection, weighted by D_i*c_i instead of c_i, removes
+    the instantaneous electric current from the Brownian number fluxes.
+    Association noise itself has zero constituent stoichiometry.
+    """
+    concentration = equilibrium(totals)
+    population = np.diag(concentration)
+    population_charge = concentration * CHARGE
+    conditional = population - np.outer(population_charge, population_charge) / (
+        CHARGE @ population_charge
+    )
+    susceptibility = CONSTITUENTS @ conditional @ CONSTITUENTS.T
+
+    mobile_population = diffusivity * RELATIVE_DIFFUSIVITIES * concentration
+    mobile_charge = mobile_population * CHARGE
+    constrained = np.diag(mobile_population) - np.outer(mobile_charge, mobile_charge) / (
+        CHARGE @ mobile_charge
+    )
+    mobility = CONSTITUENTS @ constrained @ CONSTITUENTS.T
+    return susceptibility, mobility
+
+
+def equilibrium_correlations(t, totals, harmonic, diffusivity):
+    """Evaluate exp(-q**2 M chi**-1 t) chi in a symmetric eigenbasis."""
+    t = np.asarray(t, dtype=float)
+    covariance, mobility = fluctuation_matrices(totals, diffusivity)
+    # eigh gives V.T @ chi @ V = I and M @ V = chi @ V @ diag(rates).
+    # Thus chi @ V contains the right relaxation modes and reconstructs chi.
+    rates, vectors = eigh(mobility, covariance)
+    modes = covariance @ vectors
+    decay = np.exp(-t[:, None] * (harmonic * np.pi / CELL_LENGTH)**2 * rates)
+    result = np.einsum('ik,tk,jk->tij', modes, decay, modes)
+    result[t == 0] = covariance
+    return result
