 import numpy as np
 from scipy.optimize import brentq
 
 
 def response(e):
+    """Return a readout at unit speed; changing speed just rescales time.
+
+    Removing the rod lengths gives a Poisson gas of density
+    c = rho / (1 - rho * length). For positive current j, the reduced-space
+    observation point moves by the sum of the lengths of the j*t crossed
+    rods. Averaging over those lengths contributes their Laplace transform
+    M(z) = exp(-length*z) * cosh(length*contrast*z) to the current saddle:
+
+        |field| = s - log(M(c*sinh(s))),
+        scgf = c * (cosh(s) - 1).
+
+    This averages the frozen length sequence before taking the logarithm,
+    as required by the preparation. Reflection makes the SCGF even. Its
+    quadratic coefficient depends only on the mean length, so the variance
+    growth is independent of contrast.
+    """
     rho, mean = e['density'], e['length']
-    if e['statistic'] == 'mean':
-        return 0.
-    if e['statistic'] == 'variance':
-        return rho*(1-rho*mean)
+    statistic = e['statistic']
+    if statistic == 'mean':
+        return 0.0
+    if statistic == 'variance':
+        return rho * (1.0 - rho * mean)
+    if statistic != 'scgf':
+        raise ValueError(f'Unknown statistic: {statistic!r}')
+
     field = abs(e['counting_field'])
-    c = rho/(1-rho*mean)
-    s = brentq(lambda s: s+c*mean*np.sinh(s)-field, 0., field+1, xtol=1e-14)
-    return c*2*np.sinh(s/2)**2
+    if field == 0.0:
+        return 0.0
+    contrast = e['contrast']
+    c = rho / (1.0 - rho * mean)
+
+    def saddle(fraction):
+        # Solve for s/field to retain relative precision near zero field.
+        displacement = c * mean * sinh(field * fraction)
+        z = contrast * displacement
+        # Accurate log(cosh(z)) near zero; bounded throughout the domain.
+        log_cosh = log1p(2.0 * sinh(0.5 * z)**2)
+        return fraction + (displacement - log_cosh) / field - 1.0
+
+    # All rod lengths are positive, so the saddle is unique and 0 < s < field.
+    fraction = brentq(saddle, 0.0, 1.0, xtol=1e-14)
+    return 2.0 * c * sinh(0.5 * field * fraction)**2
 
 
