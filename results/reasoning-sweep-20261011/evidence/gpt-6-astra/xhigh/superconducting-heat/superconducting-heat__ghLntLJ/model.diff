+        result[key] *= rate * KB**3 * 1e36
+    result['mu'] = state['mu'].tolist()
+    return result
+
+
+def gate_third(e, conductance, nodes=192, count=64):
+    return gate_statistics(e, conductance, nodes=nodes, count=count)
