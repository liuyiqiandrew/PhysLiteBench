     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        """Fit the common mobility by bounded Gaussian maximum likelihood."""
+        records = list(records)
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+        rates = np.asarray([response(r['input']) for r in records])
+        values = np.asarray([r['value'] for r in records], dtype=float)
+        sigmas = np.asarray([r['sigma'] for r in records], dtype=float)
+        if not np.all(np.isfinite(sigmas) & (sigmas > 0)):
+            raise ValueError('Calibration sigmas must be finite and positive.')
+        x, y = rates / sigmas, values / sigmas
+        information = np.dot(x, x)
+        if not np.isfinite(information) or information <= 0:
+            raise ValueError('Calibration must contain informative finite rates.')
+        if not np.all(np.isfinite(y)):
+            raise ValueError('Calibration values must be finite.')
+        self.mobility = float(np.clip(np.dot(x, y) / information, 0.8, 1.3))
+        return self
 
