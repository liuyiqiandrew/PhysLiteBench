+"""Long-time heat fluctuations for the stationary circulating trap.
+
+In time units tau = mobility * stiffness * t, the mean heat rate is
+2*r**2. Heat is circulating work minus the change in trap energy. For
+E[exp(-lambda*Q)], the interior scaled cumulant generating function is
+1 - Omega, where Omega = sqrt(1 + 4*r**2*lambda*(1-lambda)). Integrating
+over both stationary, unconditioned endpoints requires
+1 + Omega > 2*abs(lambda), in addition to a real Omega.
+
+The rate is the supremum of Omega - 1 - 2*r**2*z*lambda on that open
+domain. Its upper boundary lambda=1 produces the negative-heat linear
+tail. When r**2 < 1/3, the lower boundary (r**2-1)/(r**2+1) also produces
+a positive-heat linear tail. Otherwise the positive tail retains the
+interior saddle. The formulas below include the limiting boundary values.
+"""
+
 import numpy as np
 
 
 def response(e):
+    """Reported inverse-time rate at unit mobility."""
     r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
-    return e['stiffness']*rate
+    a = r * r
+    if z <= -1.0:
+        rate = -2.0 * a * z
+    elif a < 1.0 / 3.0 and z >= (3.0 - a) / (1.0 - 3.0 * a):
+        rate = 2.0 * a * ((1.0 - a) * z - 2.0) / (1.0 + a)
+    else:
+        # Rationalize sqrt((1+a)*(1+a*z*z)) - 1 - a*z to avoid
+        # cancellation close to the zero of the rate at z=1.
+        root = np.sqrt((1.0 + a) * (1.0 + a * z * z))
+        rate = a * (z - 1.0)**2 / (root + 1.0 + a * z)
+    return e['stiffness'] * rate
 
 
 def predict_at(experiments, mobility):
-    return mobility*np.asarray([response(e) for e in experiments])
+    return mobility * np.asarray([response(e) for e in experiments], dtype=float)
 
 
