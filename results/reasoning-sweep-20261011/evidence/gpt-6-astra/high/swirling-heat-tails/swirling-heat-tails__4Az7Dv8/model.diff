+"""Long-time heat fluctuations for the stationary circulating trap.
+
+In time units tau = mobility * stiffness * t, the mean heat rate is
+2*r**2.  Heat is circulating work minus the change in potential energy.
+For the Laplace convention E[exp(-lam*Q)], the interior scaled cumulant
+generator is 1 - Omega, with Omega = sqrt(1 + 4*r**2*lam*(1-lam)).
+Integrating both stationary endpoints requires
+    1 + Omega + 2*lam > 0 and 1 + Omega - 2*lam > 0.
+These restrict the transform domain and produce linear heat-rate tails;
+discarding the endpoint energy would incorrectly retain the work rate.
+"""
+
 import numpy as np
 
 
 def response(e):
+    """Return the heat rate at unit mobility, including endpoint tails."""
     r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
-    return e['stiffness']*rate
+    a = r * r
+    q = 2 * a * z
+
+    if z < -1:
+        # The maximizing Laplace parameter reaches the upper limit lam=1.
+        rate = -q
+    elif a < 1 / 3 and z > (3 - a) / (1 - 3 * a):
+        # For weak circulation the initial-energy overlap also limits lam,
+        # at lam=(a-1)/(a+1), before the square-root branch point.
+        rate = ((1 - a) * q - 4 * a) / (1 + a)
+    else:
+        # Interior Legendre transform: sqrt((1+a)*(1+a*z*z))-1-a*z.
+        # Rationalization avoids cancellation near the minimum z=1.
+        root = np.sqrt((1 + a) * (1 + a * z * z))
+        rate = a * (z - 1) ** 2 / (root + 1 + a * z)
+    return e['stiffness'] * rate
 
 
 def predict_at(experiments, mobility):
-    return mobility*np.asarray([response(e) for e in experiments])
+    return mobility * np.asarray([response(e) for e in experiments], dtype=float)
 
 
