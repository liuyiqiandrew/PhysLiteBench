+    def fit(self, records):
+        """Fit the shared reference coupling by Gaussian maximum likelihood."""
+        records = list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required")
+        experiments = [r['input'] for r in records]
+        values = np.asarray([r['value'] for r in records], dtype=float)
+        sigma = np.asarray([r['sigma'] for r in records], dtype=float)
+        if not np.all(np.isfinite(values)) or not np.all(np.isfinite(sigma) & (sigma > 0)):
+            raise ValueError("Calibration values must be finite and sigmas positive")
 
-    def predict(self,experiments):
-        return predict_at(experiments,self.coupling)
+        def objective(coupling):
+            residual = (predict_at(experiments, coupling) - values) / sigma
+            return np.dot(residual, residual)
+
+        result = minimize_scalar(objective, bounds=(0.7, 1.4), method='bounded',
+                                 options={'xatol': 1e-11})
+        # Include endpoints: the constrained MLE can lie on either bound.
+        self.coupling = float(min((0.7, result.x, 1.4), key=objective))
+        return self
+
+    def predict(self, experiments):
+        if self.coupling is None:
+            raise ValueError("Fit the model before predicting")
+        return predict_at(experiments, self.coupling)
 
 
