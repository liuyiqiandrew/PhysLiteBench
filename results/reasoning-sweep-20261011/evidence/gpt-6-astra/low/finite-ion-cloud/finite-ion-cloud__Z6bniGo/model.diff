+def three_ion_angular(gamma, d1, d2, modes=48):
+    """Joint angle average, including the closed three-pair Fourier loop.
+
+    For f(q,theta)=|1-q*exp(i*theta)|**gamma, its kth Fourier
+    coefficient is (-gamma/2)_k q**k / k! times
+    2F1(k-gamma/2, -gamma/2; k+1; q**2).
+    Angular integration of the triangle retains equal modes on all edges,
+    giving c0(q1)c0(q2)c0(q1*q2) + 2 sum_{k>=1} ck(q1)ck(q2)ck(q1*q2).
+    """
+    gaps = np.asarray([d1, d2, d1 + d2])
+    q2 = np.exp(-2 * gaps)
+    alpha = -gamma / 2
+    angular = np.prod(hyp2f1(alpha, alpha, 1, q2), axis=0)
+    prefactor = 1.0
+    for k in range(1, modes + 1):
+        prefactor *= (alpha + k - 1) / k
+        if prefactor == 0:
+            break  # Even integer Gamma gives a finite Fourier polynomial.
+        term = (prefactor ** 3 * np.exp(-2 * k * (d1 + d2))
+                * np.prod(hyp2f1(k + alpha, alpha, k + 1, q2), axis=0))
+        angular += 2 * term
+    return angular
+
