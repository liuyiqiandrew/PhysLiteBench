+        """Fit inverse friction by uncertainty-weighted least squares.
+
+        Calibration has identical baths and zero magnetic field.  Every
+        predicted rate is then exactly proportional to inverse friction;
+        the independent contact label has no effect on the dynamics.
+        """
+        records=list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required.")
+        values=np.asarray([r['value'] for r in records],dtype=float)
+        sigma=np.asarray([r['sigma'] for r in records],dtype=float)
+        if not np.all(np.isfinite(values)) or not np.all(np.isfinite(sigma)&(sigma>0)):
+            raise ValueError("Calibration values must be finite and uncertainties positive.")
+        reference=coefficients([r['input'] for r in records],friction=1.)
+        design=reference/sigma
+        information=float(design@design)
+        if information==0.:
+            raise ValueError("Calibration does not identify friction.")
+        inverse=float(design@(values/sigma))/information
+        self.friction=float(1./np.clip(inverse,1./1.6,1./.7))
+        return self
+    def predict(self,experiments):
+        if self.friction is None:
+            raise ValueError("Fit the model before predicting.")
