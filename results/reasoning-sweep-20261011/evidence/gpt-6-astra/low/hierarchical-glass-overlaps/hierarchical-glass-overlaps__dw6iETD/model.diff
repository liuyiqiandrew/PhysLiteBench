+            rows.append((beta, measured, sigma))
+        if not rows:
+            raise ValueError('Supply at least one calibration reading.')
+        # Rescale inverse variances without changing the minimizer.
+        scale = min(sigma for _, _, sigma in rows)
+        weights = [(scale/sigma)**2 for _, _, sigma in rows]
+        numerator = math.fsum(-w*beta*y for w, (beta, y, _) in zip(weights, rows))
