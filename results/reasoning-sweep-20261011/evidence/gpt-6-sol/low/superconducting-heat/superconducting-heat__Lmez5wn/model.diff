 def predict_at(experiments,conductance):
     return np.array([gate_third(e,conductance)['third'] if e.get('statistic','mean')=='gate_third'
                      else noise_predict([e],conductance)[0] for e in experiments])
+
+
+def gate_third(e, conductance, nodes=192, count=64):
+    """Extensive third cumulant from the stationary tilted jump generator."""
+    if e.get('amplitude', 0.) == 0:
+        return {'third': 0.}
+    args = oscillator_arguments(e)
+    kw = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+              quadratic_coupling=e.get('quadratic_coupling', 0.),
+              momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kw)
+    mu = state['mu']
+    tl, tr = args[:2]
+    dl, dr, ch = prepare(*args, nodes=nodes, count=count,
+                         window=state['search_bound'], **kw)
+    energy, other, measure, sl, sr, pair, work, recoil, pf, pb, injection = ch
+    ratio = QUASIPARTICLE_DENSITY / (NORMAL_POLARIZATION_TIME * RATE_CONVERSION * conductance)
+    x, weights = leggauss(160)
+    flip_grids = []
+    for temperature, delta in ((tl, dl), (tr, dr)):
+        upper = delta + max(80 * temperature, 40.)
+        flip_grids.append((delta + (x + 1) * (upper - delta) / 2,
+                           weights * (upper - delta) / 2 * ratio / 2))
+
+    jump = np.repeat(injection, energy.shape[1], axis=0)
+    spin_marks = np.concatenate((jump, -jump,
+                                 [[-2., 0.], [2., 0.], [0., -2.], [0., 2.]]))
+    gate_mark = np.concatenate((np.repeat(work, energy.shape[1]),
+                                -np.repeat(work, energy.shape[1]), np.zeros(4)))
+
+    def rates(pol):
+        f = expit((sl * pol[0] - energy) / tl)
+        g = expit((sr * pol[1] - other) / tr)
+        forward = measure * np.where(pair, pf * (1 - f) * (1 - g), pf * f * (1 - g))
+        backward = measure * np.where(pair, pb * f * g, pb * g * (1 - f))
+        flips = []
+        for j, (temperature, grid) in enumerate(zip((tl, tr), flip_grids)):
+            ee, ww = grid
+            up = expit((pol[j] - ee) / temperature)
+            down = expit((-pol[j] - ee) / temperature)
+            flips.extend((ww @ (up * (1 - down)), ww @ (down * (1 - up))))
+        return np.concatenate((forward.ravel(), backward.ravel(), flips))
+
+    r0 = rates(mu)
+    jac = state['jacobian']
+    diffusion = spin_marks.T @ (r0[:, None] * spin_marks)
+    cross = spin_marks.T @ (r0 * gate_mark)
+    hprime = np.empty(2)
+    for j in range(2):
+        step = np.zeros(2)
+        step[j] = 1e-4
+        hprime[j] = gate_mark @ (rates(mu + step) - rates(mu - step)) / (2e-4)
+    pprime = -np.linalg.solve(jac.T, hprime)
+    muprime = -np.linalg.solve(jac, cross + diffusion @ pprime)
+    mark = gate_mark + spin_marks @ pprime
+    h = 1e-4 / max(1., np.max(np.abs(muprime)))
+    plus = rates(mu + h * muprime)
+    minus = rates(mu - h * muprime)
+    first = (plus - minus) / (2 * h)
+    second = (plus - 2 * r0 + minus) / h**2
+    third = (r0 @ mark**3 + 3 * first @ mark**2 + 3 * second @ mark)
+    return {'third': float(third * RATE_CONVERSION * conductance * KB**3 * 1e36)}
