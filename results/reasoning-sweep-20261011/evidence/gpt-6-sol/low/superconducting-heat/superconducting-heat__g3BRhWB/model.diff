+def gate_third(e, conductance, nodes=192, count=64):
+    """Leading extensive third work cumulant of the spin-coupled jump process.
+
+    The tilted macroscopic generator has a stationary saddle in the two spin
+    potentials and their counting fields. Its third derivative needs only the
+    first displacement of that saddle, evaluated below along a straight line.
+    """
+    args = oscillator_arguments(e)
+    if args[3] == 0:
+        return dict(third=0.)
+    kw = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+              quadratic_coupling=e.get('quadratic_coupling', 0.),
+              momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kw)
+    mu = state['mu']
+    tl, tr = args[:2]
+    dl, dr, ch = prepare(*args, nodes=nodes, count=count,
+                         window=state['search_bound'], **kw)
+    energy, other, measure, sl, sr, pair, work, recoil, pf, pb, injection = ch
+    work = work[:, None]
+    ratio = QUASIPARTICLE_DENSITY / (NORMAL_POLARIZATION_TIME * RATE_CONVERSION * conductance)
+
+    # The density of states cancels the specified spin-flip lifetime factor.
+    x, w = leggauss(192)
+    flip_grids = []
+    for temperature, delta in ((tl, dl), (tr, dr)):
+        upper = delta + max(80 * temperature, 80.)
+        grid = delta + (x + 1) * (upper - delta) / 2
+        weight = w * (upper - delta) / 2 * ratio / 2
+        flip_grids.append((grid, weight, temperature))
+
+    def rates(polarization):
+        f = expit((sl * polarization[0] - energy) / tl)
+        g = expit((sr * polarization[1] - other) / tr)
+        plus = measure * np.where(pair, pf * (1-f) * (1-g), pf * f * (1-g))
+        minus = measure * np.where(pair, pb * f * g, pb * g * (1-f))
+        flip_plus, flip_minus = [], []
+        for j, (grid, weight, temperature) in enumerate(flip_grids):
+            up = expit((polarization[j] - grid) / temperature)
+            down = expit((-polarization[j] - grid) / temperature)
+            flip_plus.append(weight * up * (1-down))
+            flip_minus.append(weight * down * (1-up))
+        return plus, minus, flip_plus, flip_minus
+
+    rp, rm, fp, fm = rates(mu)
+    mark_work = np.broadcast_to(work, rp.shape)
+    spin_work = injection.T @ np.sum((rp + rm) * mark_work, axis=1)
+    spin_cov = injection.T @ (injection * np.sum(rp + rm, axis=1)[:, None])
+    for j in range(2):
+        spin_cov[j, j] += 4 * np.sum(fp[j] + fm[j])
+
+    f = expit((sl * mu[0] - energy) / tl)
+    g = expit((sr * mu[1] - other) / tr)
+    df = f * (1-f) / tl
+    dg = g * (1-g) / tr
+    dleft = np.where(pair, -sl * df, sl * df) * (pf * (1-g) + pb * g)
+    dright = -sr * dg * np.where(pair, pf * (1-f) + pb * f,
+                                pf * f + pb * (1-f))
+    heat_gradient = np.array([np.sum(measure * work * dleft),
+                              np.sum(measure * work * dright)])
+    jacobian = state['jacobian']
+    count_response = -np.linalg.solve(jacobian.T, heat_gradient)
+    state_response = -np.linalg.solve(jacobian,
+                                      spin_work + spin_cov @ count_response)
+    marked = mark_work + (injection @ count_response)[:, None]
+    flip_marks = np.array([-2 * count_response[0], -2 * count_response[1]])
+
+    # Differentiate conditional rates along the tilted saddle direction.
+    # The third directional derivative of the generator equals the third
+    # derivative of its optimized value because its first gradient vanishes.
+    step = 2e-3 / max(1., np.max(np.abs(state_response)))
+    ap, am, afp, afm = rates(mu + step * state_response)
+    bp, bm, bfp, bfm = rates(mu - step * state_response)
+    dsum = (ap + am - bp - bm) / (2 * step)
+    d2difference = ((ap - am) - 2 * (rp - rm) + (bp - bm)) / step**2
+    third = np.sum((rp-rm) * marked**3 + 3 * dsum * marked**2
+                   + 3 * d2difference * marked)
+    for j in range(2):
+        m = flip_marks[j]
+        dsum = (np.sum(afp[j]+afm[j])-np.sum(bfp[j]+bfm[j])) / (2*step)
+        d2difference = (np.sum(afp[j]-afm[j])
+                        -2*np.sum(fp[j]-fm[j])
+                        +np.sum(bfp[j]-bfm[j])) / step**2
+        third += (np.sum(fp[j]-fm[j])*m**3 + 3*dsum*m**2
+                  +3*d2difference*m)
+    scale = RATE_CONVERSION * conductance * KB**3 * 1e36
+    return dict(third=float(third * scale),
+                count_response=count_response.tolist(),
+                state_response=state_response.tolist())
 
 
