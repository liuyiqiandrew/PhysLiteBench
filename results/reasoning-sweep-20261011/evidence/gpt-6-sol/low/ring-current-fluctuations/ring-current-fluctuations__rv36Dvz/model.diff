-"""Current SCGF model and calibration interface."""
+"""Large-ring current SCGF for the half-filled weakly asymmetric exclusion process."""
+
+from functools import lru_cache
+
 import numpy as np
+from scipy.optimize import minimize
+
+
+@lru_cache(maxsize=1)
+def _basis():
+    """Odd cosine modes enforce half filling and one particle-rich domain."""
+    x = (np.arange(512) + 0.5) / 512
+    wave = 2 * np.pi * (2 * np.arange(32) + 1)
+    return np.cos(x[:, None] * wave), -np.sin(x[:, None] * wave) * wave
+
+
+@lru_cache(maxsize=2048)
+def _unit_scgf(field, bias):
+    field = float(field)
+    bias = float(bias)
+    k = field + bias
+    flat = (k * k - field * field) / 4
+
+    # Stability of the uniform saddle against the first Fourier mode.
+    if flat >= -np.pi**2:
+        return flat
+
+    modes, derivatives = _basis()
+
+    def objective(a):
+        theta = modes @ a
+        theta_prime = derivatives @ a
+        cosine = np.cos(theta)
+        sec2 = 1 / np.maximum(cosine * cosine, 1e-16)
+        tangent = np.tan(theta)
+        inv_mobility = 4 * np.mean(sec2)
+        mobility = np.mean(cosine * cosine) / 4
+        gradient_cost = np.mean(theta_prime * theta_prime) / 4
+        value = -(k * k / inv_mobility - field * field * mobility - gradient_cost)
+
+        da = 8 * np.mean((sec2 * tangent)[:, None] * modes, axis=0)
+        db = -np.mean(np.sin(2 * theta)[:, None] * modes, axis=0) / 4
+        dg = np.mean(theta_prime[:, None] * derivatives, axis=0) / 2
+        jac = k * k * da / inv_mobility**2 + field * field * db + dg
+        return value, jac
+
+    # The first mode becomes unstable continuously at the transition.
+    best = flat
+    for amplitude in (0.3, 1.0, 1.5):
+        start = np.zeros(modes.shape[1])
+        start[0] = amplitude
+        result = minimize(objective, start, jac=True, method="L-BFGS-B",
+                          options={"maxiter": 600, "ftol": 1e-12, "gtol": 1e-9})
+        if np.isfinite(result.fun):
+            best = max(best, -float(result.fun))
+    return best
+
 
