+def angular_hermite(e, gamma=.67, degree=24):
+    """Fourier-Hermite perturbation of the tilted joint generator.
+
+    Fourier indices count multiples of detector_harmonic.  Through third
+    order only indices -2,...,2 can contribute to the zero mode.
+    """
+    L, V, A1, A2, p, constant = hermite_operators(e, gamma, degree)
+    eps = e.get('detector_contrast', 0.)
+    harmonic = e.get('detector_harmonic', 1)
+    w = {0: 1., -1: eps / 2, 1: eps / 2}
+    w2 = {0: 1 + eps * eps / 2, -1: eps, 1: eps,
+          -2: eps * eps / 4, 2: eps * eps / 4}
+    c1 = float(p @ A1 @ constant)
+    size = len(p)
+    zero = np.zeros(size, dtype=complex)
+    centered = L.astype(complex)
+    centered[0] = p
+
+    def invert(n, rhs):
+        if n == 0:
+            rhs = rhs.copy()
+            rhs[0] = 0
+            return solve(centered, rhs, check_finite=False)
+        return solve(L + 1j * n * harmonic * V, rhs,
+                     check_finite=False)
+
+    r1 = {n: invert(n, (c1 * constant if n == 0 else zero)
+                    - w[n] * (A1 @ constant)) for n in (-1, 0, 1)}
+    c2 = float(np.real(p @ (w2[0] * (A2 @ constant)
+                    + 2 * sum(w.get(-n, 0) * (A1 @ r1[n]) for n in r1))))
+    r2 = {}
+    for n in range(-2, 3):
+        rhs = np.asarray(c2 * constant if n == 0 else zero, dtype=complex).copy()
+        rhs += 2 * c1 * r1.get(n, zero)
+        rhs -= 2 * sum(w.get(n - m, 0) * (A1 @ r1[m]) for m in r1)
+        rhs -= w2[n] * (A2 @ constant)
+        r2[n] = invert(n, rhs)
+    c3 = float(np.real(3 * p @ sum(
+        w.get(-n, 0) * (A1 @ r2[n])
+        + w2.get(-n, 0) * (A2 @ r1.get(n, zero)) for n in r2)))
+    return dict(mean=-c1, noise=c2, third_cumulant=-c3)
 
 
