+@lru_cache(maxsize=512)
+def _response_integrals(radius, width, strength):
+    """Integrals for the no-slip kernel and its slip correction.
+
+    The reciprocal translating-sphere flow has radial velocity
+    (A*radius/r + B*radius**3/r**3)*cos(theta), where
+    A = 3*(1 + 2*beta)/(2*(1 + 3*beta)) and B = -1/(2*(1 + 3*beta)).
+    The force-free response uses r**2 times one minus that velocity.
+    """
+    field = _concentration_solution(radius, width, strength)
+    outer_radius = radius + width
+
+    def integrands(r):
+        x = (r - radius) / width
+        concentration = np.exp(-strength * (1 - x)**2) * field(x)[0]
+        potential_derivative = -2 * strength * (1 - x) / width
+        no_slip = (r - radius)**2 * (2 * r + radius) / (2 * r)
+        slip_correction = radius * (r - radius) * (r + radius) / r
+        common = concentration * potential_derivative
+        return no_slip * common, slip_correction * common
+
+    no_slip = quad(lambda r: integrands(r)[0], radius, outer_radius,
+                   epsabs=2e-11, epsrel=2e-11)[0]
+    slip_correction = quad(lambda r: integrands(r)[1], radius, outer_radius,
+                           epsabs=2e-11, epsrel=2e-11)[0]
+    return no_slip, slip_correction
+
+
+@lru_cache(maxsize=1024)
+def response(radius, width, strength, slip):
+    """Velocity per gradient, multiplied by viscosity."""
+    if strength == 0:
+        return 0.0
+
+    no_slip, slip_correction = _response_integrals(radius, width, strength)
+    beta = slip / radius
+    drag_factor = (1 + 2 * beta) / (1 + 3 * beta)
+    kernel_integral = no_slip + 3 * beta / (2 * (1 + 3 * beta)) * slip_correction
+    return 2 * kernel_integral / (9 * radius * drag_factor)
 
 
