+def response(experiment):
+    """Return a readout at unit speed.
+
+    In free-volume coordinates the point density is ``c``. For a positive
+    current, the coordinate of the observation point shifts by the sum of
+    the lengths of the rods that crossed it. Averaging that sum over the
+    freshly drawn length order gives the log-cosh term in the field equation.
+    """
+    density = experiment['density']
+    length = experiment['length']
+    statistic = experiment['statistic']
+
+    if statistic == 'mean':
+        return 0.0
+    if statistic == 'variance':
+        return density * (1.0 - density * length)
+
+    field = abs(experiment['counting_field'])
+    if field == 0.0:
+        return 0.0
+
+    free_density = density / (1.0 - density * length)
+    contrast = experiment['contrast']
+
+    def field_equation(s):
+        sinh_s = np.sinh(s)
+        q = free_density * length * contrast * sinh_s
+        log_cosh_q = np.logaddexp(q, -q) - np.log(2.0)
+        return s + free_density * length * sinh_s - log_cosh_q - field
+
+    s = brentq(field_equation, 0.0, field, xtol=1e-14)
+    return free_density * 2.0 * np.sinh(s / 2.0) ** 2
 
 
 def predict_at(experiments, speed):
-    return speed*np.asarray([response(e) for e in experiments])
+    return speed * np.asarray([response(e) for e in experiments], dtype=float)
 
 
