 def response(e):
+    """Long-time readout at unit rod speed.
+
+    In the free-coordinate representation the gaps are Poisson with rate
+    c = rho / (1 - rho * mean_length). For positive current, crossing n rods
+    moves the free-coordinate cut by the sum of their lengths. Averaging the
+    random length sequence gives the field relation below. Negative fields
+    follow by left-right symmetry.
+    """
     rho, mean = e['density'], e['length']
     if e['statistic'] == 'mean':
         return 0.
     if e['statistic'] == 'variance':
         return rho*(1-rho*mean)
     field = abs(e['counting_field'])
+    if field == 0.:
+        return 0.
     c = rho/(1-rho*mean)
-    s = brentq(lambda s: s+c*mean*np.sinh(s)-field, 0., field+1, xtol=1e-14)
-    return c*2*np.sinh(s/2)**2
+    delta = mean*e['contrast']
+
+    def effective_field(s):
+        u = c*delta*np.sinh(s)
+        log_cosh = np.log1p(2.*np.sinh(u/2.)**2)
+        return s + c*mean*np.sinh(s) - log_cosh
+
+    s = brentq(lambda s: effective_field(s)-field, 0., field, xtol=1e-14)
+    return 2.*c*np.sinh(s/2.)**2
 
 
