+    """Heat rate per unit mobility for a stationary, unconditioned trap.
+
+    In time units of 1/(mobility*stiffness), the mean heat is 2*r**2.
+    The heat cumulant generating function is
+        psi(lam) = 1 - sqrt(1 - 4*r**2*lam*(1 + lam)).
+    Its endpoint integrals restrict lam to (-1, lam_upper). The lower
+    endpoint produces a linear left tail; for weak circulation, the
+    initial stationary distribution also produces a linear right tail.
+    """
+    r2 = e['drive_ratio'] ** 2
+    z = e['relative_heat']
+    q = 2.0 * r2 * z
+
+    if z < -1.0:
+        rate = -q
+    elif r2 < 1.0 / 3.0 and z > (3.0 - r2) / (1.0 - 3.0 * r2):
+        lam_upper = (1.0 - r2) / (1.0 + r2)
+        psi_upper = 4.0 * r2 / (1.0 + r2)
+        rate = lam_upper * q - psi_upper
+    else:
+        # Rationalized Legendre transform; it is exactly zero at z=1.
+        root = np.sqrt((1.0 + r2) * (1.0 + r2 * z * z))
+        rate = r2 * (z - 1.0) ** 2 / (root + 1.0 + r2 * z)
+    return e['stiffness'] * rate
 
 
