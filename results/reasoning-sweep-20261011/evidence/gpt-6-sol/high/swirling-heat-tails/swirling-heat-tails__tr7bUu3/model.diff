+"""Long-time rate function for heat in the circulating harmonic trap."""
+
 import numpy as np
 
 
 def response(e):
+    """Heat rate per unit mobility for one preparation.
+
+    The bulk scaled cumulant generating function is
+    k * (1 - sqrt(1 + 4*r**2*lambda*(1-lambda))). Its Legendre
+    transform applies while both Gaussian endpoint overlaps are finite.
+    The unconditioned endpoint energies give linear tails beyond those
+    limits: z < -1, and, for sufficiently weak circulation, z > z_max.
+    """
+    k = e['stiffness']
     r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
-    return e['stiffness']*rate
+    u = r * r
+
+    if z < -1.0:
+        return k * (-2.0 * u * z)
+
+    if u < 1.0 / 3.0:
+        z_max = (3.0 - u) / (1.0 - 3.0 * u)
+        if z > z_max:
+            return k * (2.0 * u * ((1.0 - u) * z - 2.0) / (1.0 + u))
+
+    # Rationalized form of sqrt((1+u)*(1+u*z*z)) - 1 - u*z.
+    root = np.sqrt((1.0 + u) * (1.0 + u * z * z))
+    return k * u * (z - 1.0) ** 2 / (root + 1.0 + u * z)
 
 
 def predict_at(experiments, mobility):
-    return mobility*np.asarray([response(e) for e in experiments])
+    return mobility * np.asarray([response(e) for e in experiments], dtype=float)
 
 
