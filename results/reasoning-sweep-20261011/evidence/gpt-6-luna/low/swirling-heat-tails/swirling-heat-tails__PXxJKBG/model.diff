--- starter/model.py
+++ submission/model.py
@@ -17,7 +17,28 @@
         self.mobility = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        """Fit the common mobility by weighted least squares.
+
+        The normalized heat rate has a known dependence on the preparation
+        parameters; its remaining overall rate scale is the common mobility.
+        """
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+
+        shape = np.asarray([response(record['input']) for record in records], dtype=float)
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.all(np.isfinite(shape)) or not np.all(np.isfinite(values))
+                or not np.all(np.isfinite(sigma)) or np.any(sigma <= 0)):
+            raise ValueError('Calibration values and positive uncertainties must be finite.')
+
+        weights = 1.0 / sigma**2
+        denominator = np.sum(weights * shape**2)
+        if denominator <= 0:
+            raise ValueError('Calibration records do not identify the mobility.')
+        estimate = np.sum(weights * shape * values) / denominator
+        self.mobility = float(np.clip(estimate, 0.8, 1.3))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.mobility)
