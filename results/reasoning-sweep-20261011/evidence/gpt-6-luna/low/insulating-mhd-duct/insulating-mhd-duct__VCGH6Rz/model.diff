+        """Find the viscosity that best explains the calibration readings.
+
+        The quoted calibration uncertainties are independent Gaussian standard
+        deviations, so fitting is a one dimensional weighted least squares
+        problem (equivalently, maximum likelihood).
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+        experiments = [r['input'] for r in records]
+        observed = np.asarray([r['value'] for r in records], dtype=float)
+        uncertainty = np.asarray([r['sigma'] for r in records], dtype=float)
+        if (not np.all(np.isfinite(observed)) or
+                not np.all(np.isfinite(uncertainty)) or
+                np.any(uncertainty <= 0)):
+            raise ValueError("calibration values and positive sigmas must be finite")
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = (self.predict(experiments) - observed) / uncertainty
+            return float(residual @ residual)
+
+        result = minimize_scalar(objective, bounds=(0.006, 0.018),
+                                 method='bounded',
+                                 options={'xatol': 1e-12, 'maxiter': 100})
+        # Include endpoints in case the constrained optimum lies at a bound.
+        candidates = [(float(result.x), float(result.fun)),
+                      (0.006, objective(0.006)),
+                      (0.018, objective(0.018))]
+        self.viscosity = min(candidates, key=lambda item: item[1])[0]
+        return self
 
