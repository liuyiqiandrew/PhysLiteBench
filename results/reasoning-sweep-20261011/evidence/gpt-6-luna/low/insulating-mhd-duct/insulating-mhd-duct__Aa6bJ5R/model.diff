     def fit(self, records):
-        raise NotImplementedError
+        """Estimate the common viscosity from weighted calibration residuals.
+
+        The supplied ``sigma`` values are standard deviations, so minimizing
+        the sum of squared standardized residuals is the Gaussian maximum
+        likelihood estimate.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+        values = np.asarray([r['value'] for r in records], dtype=float)
+        sigmas = np.asarray([r['sigma'] for r in records], dtype=float)
+        if np.any(~np.isfinite(values)) or np.any(~np.isfinite(sigmas)) or np.any(sigmas <= 0):
+            raise ValueError("calibration values and positive sigmas must be finite")
+        experiments = [r['input'] for r in records]
+
+        def objective(mu):
+            self.viscosity = float(mu)
+            residual = (self.predict(experiments) - values) / sigmas
+            return float(residual @ residual)
+
+        result = minimize_scalar(objective, bounds=(0.006, 0.018), method='bounded',
+                                 options={'xatol': 1e-10})
+        # Include both endpoints in case the constrained optimum lies there.
+        candidates = [0.006, float(result.x), 0.018]
+        self.viscosity = min(candidates, key=objective)
+        return self
 
