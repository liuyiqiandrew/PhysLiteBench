     def fit(self, records):
-        raise NotImplementedError
+        """Estimate the common dynamic viscosity by weighted least squares.
+
+        The calibration uncertainties are known independent Gaussian standard
+        deviations, so the likelihood objective is the sum of squared
+        residuals divided by their variances.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+        experiments = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.all(np.isfinite(values)) or not np.all(np.isfinite(sigmas))
+                or np.any(sigmas <= 0)):
+            raise ValueError("calibration values must be finite and sigma positive")
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = (self.predict(experiments) - values) / sigmas
+            return float(residual @ residual)
+
+        result = minimize_scalar(objective, bounds=(0.006, 0.018),
+                                 method='bounded',
+                                 options={'xatol': 1e-10})
+        # Check the interval endpoints too; bounded scalar minimization does
+        # not include them in its interior search.
+        candidates = [(float(result.fun), float(result.x))]
+        candidates.extend((objective(v), v) for v in (0.006, 0.018))
+        _, self.viscosity = min(candidates)
+        return self
 
