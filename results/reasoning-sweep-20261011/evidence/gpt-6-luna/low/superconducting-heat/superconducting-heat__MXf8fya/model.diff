+
+def predict_at(experiments, conductance):
+    """Evaluate all documented readouts with independent phase preparations."""
+    values = []
+    for e in experiments:
+        statistic = e.get('statistic', 'mean')
+        if statistic == 'gate_noise':
+            value = gate_statistics(e, conductance)['noise']
+        elif statistic == 'gate_third':
+            value = gate_third(e, conductance)['third']
+        elif statistic == 'mean':
+            value = mean_heat(e, conductance)
+        elif statistic == 'phase_contrast':
+            q1 = mean_heat(e, conductance)
+            opposite = dict(e, phase=float(e['phase'] + np.pi))
+            q2 = mean_heat(opposite, conductance)
+            value = (q1 - q2) / 2
+        else:
+            raise ValueError(f"Unknown statistic: {statistic}")
+        values.append(value)
+    return np.asarray(values, dtype=float)
