     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        # Conductance is the sole fitted quantity and every weak-tunnelling
+        # prediction is linear in it.  The calibrated records are therefore
+        # optimally combined by a weighted one-parameter least-squares fit.
+        inputs = [r['input'] for r in records]
+        unit = predict_at(inputs, 1.0)
+        values = np.asarray([r['value'] for r in records], dtype=float)
+        sigma = np.asarray([r['sigma'] for r in records], dtype=float)
+        weights = 1.0 / sigma**2
+        estimate = np.sum(weights * unit * values) / np.sum(weights * unit**2)
+        self.conductance = float(np.clip(estimate, 20., 80.))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.conductance)
