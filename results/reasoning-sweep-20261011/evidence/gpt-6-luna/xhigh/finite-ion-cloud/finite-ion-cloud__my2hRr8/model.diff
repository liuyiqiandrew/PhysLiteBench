+        # The measurement uncertainties are known, so fit with their inverse
+        # variances as weights.  The radius of the disk drops out of the
+        # dimensionless coefficient at fixed R/a.
+        def objective(coupling):
+            chi_squared = 0.0
+            for record in records:
+                experiment = record['input']
+                prediction = coefficient(
+                    experiment['temperature_multiplier'] * coupling,
+                    experiment['ion_count'],
+                    experiment['radius_ratio'],
+                )
+                residual = (prediction - record['value']) / record['sigma']
+                chi_squared += residual * residual
+            return chi_squared
+
+        result = minimize_scalar(
+            objective,
+            bounds=(0.7, 1.4),
+            method='bounded',
+            options={'xatol': 1e-12},
+        )
+        # Bounded minimization does not evaluate the endpoints themselves.
+        candidates = (0.7, result.x, 1.4)
+        self.coupling = min(candidates, key=objective)
+        return self
 
     def predict(self,experiments):
         return predict_at(experiments,self.coupling)
