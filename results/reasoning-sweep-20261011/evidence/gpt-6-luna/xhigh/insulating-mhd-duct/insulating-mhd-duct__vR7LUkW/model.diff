+        """Estimate the common viscosity from weighted calibration residuals.
+
+        Each calibration measurement has an independent, known Gaussian
+        standard deviation, so the maximum-likelihood estimate minimizes the
+        sum of squared residuals divided by the measurement variances.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError('at least one calibration record is required')
+
+        experiments = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.all(np.isfinite(values)) or
+                not np.all(np.isfinite(sigmas)) or np.any(sigmas <= 0.)):
+            raise ValueError('calibration values and sigmas must be finite, with positive sigmas')
+
+        bounds = (0.006, 0.018)
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = (self.predict(experiments) - values) / sigmas
+            return float(residual @ residual)
+
+        result = minimize_scalar(
+            objective, bounds=bounds, method='bounded',
+            options={'xatol': 1e-11},
+        )
+
+        # Bounded minimization searches the interior; explicitly include both
+        # allowed endpoints in case the best fit lies on a constraint.
+        candidates = [bounds[0], float(result.x), bounds[1]]
+        best = min(candidates, key=objective)
+        self.viscosity = float(best)
+        return self
 
