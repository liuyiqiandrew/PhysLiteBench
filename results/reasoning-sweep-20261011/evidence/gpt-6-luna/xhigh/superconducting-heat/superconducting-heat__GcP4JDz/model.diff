+def gate_third(e,conductance,nodes=192,count=64):
+    args=oscillator_arguments(e)
+    kw=dict(secondary_coupling=e.get('secondary_coupling',0.),
+            quadratic_coupling=e.get('quadratic_coupling',0.),
+            momentum_coupling=e.get('momentum_coupling',0.))
+    if args[3] == 0:
+        return dict(third=0.,screened_poisson=0.,count_response=[0.,0.])
+    state=stationary(*args,conductance,nodes=nodes,count=count,**kw)
+    mu0=state['mu']; left,right=args[:2]
+    dl,dr,channels=prepare(*args,nodes=nodes,count=count,
+                           window=state['search_bound'],**kw)
+    rates,rate_derivatives,jumps,marks=_gate_work_events(
+        left,right,mu0,channels,dl,dr,conductance)
+    rate_scale=RATE_CONVERSION*conductance
+    temperature_scale=max(left,right)
+
+    def hamiltonian(mu,p,q):
+        rates,derivatives,_,_=_gate_work_events(
+            left,right,mu,channels,dl,dr,conductance)
+        exponent=q*marks+jumps@p
+        tilted=np.exp(exponent)
+        delta=tilted-1
+        value=float(rates@delta)
+        spin_balance=jumps.T@(rates*tilted)
+        state_balance=derivatives.T@delta
+        return value,spin_balance,state_balance
+
+    def tilted_state(q):
+        def equations(z):
+            _,spin_balance,state_balance=hamiltonian(z[:2],z[2:],q)
+            return np.r_[spin_balance,state_balance*temperature_scale]/rate_scale
+        solution=root(equations,np.r_[mu0,np.zeros(2)],method='hybr',
+                      options={'xtol':1e-10})
+        if not solution.success and np.max(np.abs(equations(solution.x)))>1e-8:
+            raise RuntimeError('Tilted spin-state saddle did not converge')
+        return hamiltonian(solution.x[:2],solution.x[2:],q)[0]
+
+    # The stationary large-system cumulant generating function is the
+    # Hamiltonian at its zero-drift tilted saddle. A symmetric six-point
+    # derivative gives its third derivative at zero counting field.
+    step=0.004
+    tilted_values={m:tilted_state(m*step) for m in (-3,-2,-1,1,2,3)}
+    third=(tilted_values[-3]-8*tilted_values[-2]+13*tilted_values[-1]
+           -13*tilted_values[1]+8*tilted_values[2]-tilted_values[3])/(8*step**3)
+    scale=KB**3*1e36
+    return dict(third=float(third*scale),screened_poisson=float(third*scale),
+                count_response=[])
