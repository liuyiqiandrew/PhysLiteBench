+def _gate_work_events(left, right, mu, channels, dl, dr, conductance,
+                      flip_nodes=160):
+    """Rates, spin jumps, work marks, and mu-derivatives per size factor."""
+    energy,other,measure,sl,sr,pair,work,recoil,pf,pb,injection=channels
+    fl=expit((sl*mu[0]-energy)/left)
+    fr=expit((sr*mu[1]-other)/right)
+    dfl=sl*fl*(1-fl)/left
+    dfr=sr*fr*(1-fr)/right
+
+    occ_forward=np.where(pair,pf*(1-fl)*(1-fr),pf*fl*(1-fr))
+    occ_reverse=np.where(pair,pb*fl*fr,pb*fr*(1-fl))
+    rate_scale=RATE_CONVERSION*conductance
+    rates_forward=rate_scale*measure*occ_forward
+    rates_reverse=rate_scale*measure*occ_reverse
+
+    df_l=np.where(pair,-dfl*(1-fr),dfl*(1-fr))
+    df_r=np.where(pair,-(1-fl)*dfr,-fl*dfr)
+    dr_l=np.where(pair,dfl*fr,-dfl*fr)
+    dr_r=np.where(pair,fl*dfr,(1-fl)*dfr)
+    derivative_forward=rate_scale*measure[:,:,None]*np.stack((df_l,df_r),axis=-1)
+    derivative_reverse=rate_scale*measure[:,:,None]*np.stack((dr_l,dr_r),axis=-1)
+
+    tunnel_spin=np.broadcast_to(injection[:,None,:],measure.shape+(2,)).reshape(-1,2)
+    tunnel_work=np.broadcast_to(work[:,None],measure.shape).ravel()
+    rates=[rates_forward.ravel(),rates_reverse.ravel()]
+    derivatives=[derivative_forward.reshape(-1,2),derivative_reverse.reshape(-1,2)]
+    jumps=[tunnel_spin,-tunnel_spin]
+    marks=[tunnel_work,-tunnel_work]
+
+    ratio=QUASIPARTICLE_DENSITY/(NORMAL_POLARIZATION_TIME*rate_scale)
+    x,w=leggauss(flip_nodes)
+    for j,(temperature,delta,polarization) in enumerate(zip((left,right),(dl,dr),mu)):
+        upper=delta+max(80*temperature,6*abs(polarization))
+        ee=delta+(x+1)*(upper-delta)/2
+        density=w*(upper-delta)/2*ratio/2
+        up=expit((polarization-ee)/temperature)
+        down=expit((-polarization-ee)/temperature)
+        dup=up*(1-up)/temperature
+        ddown=-down*(1-down)/temperature
+        rate_up_to_down=rate_scale*density*up*(1-down)
+        rate_down_to_up=rate_scale*density*down*(1-up)
+        deriv_up=rate_scale*density*(dup*(1-down)-up*ddown)
+        deriv_down=rate_scale*density*(ddown*(1-up)-down*dup)
+        d_up=np.zeros((flip_nodes,2));d_down=np.zeros((flip_nodes,2))
+        d_up[:,j]=deriv_up;d_down[:,j]=deriv_down
+        jump_up=np.zeros((flip_nodes,2));jump_down=np.zeros((flip_nodes,2))
+        jump_up[:,j]=-2; jump_down[:,j]=2
+        rates.extend((rate_up_to_down,rate_down_to_up))
+        derivatives.extend((d_up,d_down))
+        jumps.extend((jump_up,jump_down))
+        marks.extend((np.zeros(flip_nodes),np.zeros(flip_nodes)))
+
+    return (np.concatenate(rates),np.concatenate(derivatives),
+            np.concatenate(jumps),np.concatenate(marks))
+
