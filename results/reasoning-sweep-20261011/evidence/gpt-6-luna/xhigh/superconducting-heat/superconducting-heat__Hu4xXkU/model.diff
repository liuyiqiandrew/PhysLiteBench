+        """Fit the single normal-state conductance parameter to Gaussian records."""
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+        inputs = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(values).all() or not np.isfinite(sigmas).all()
+                or np.any(sigmas <= 0)):
+            raise ValueError('Calibration values must be finite and sigmas positive.')
+
+        def objective(conductance):
+            residual = (predict_at(inputs, float(conductance))-values)/sigmas
+            return float(residual @ residual)
+
+        # With a static barrier the spin state is unpolarized and every mean
+        # readout is exactly proportional to conductance.  This covers the
+        # supplied calibration set and avoids an unnecessary nonlinear fit.
+        if all(float(e.get('amplitude', 0.)) == 0.
+               and e.get('statistic', 'mean') in ('mean', 'phase_contrast')
+               for e in inputs):
+            unit = predict_at(inputs, 1.)
+            weights = 1./sigmas**2
+            denominator = float(weights @ (unit*unit))
+            if denominator > 0. and np.isfinite(denominator):
+                estimate = float(weights @ (unit*values))/denominator
+                self.conductance = float(np.clip(estimate, 20., 80.))
+                return self
+
+        result = minimize_scalar(objective, bounds=(20., 80.), method='bounded',
+                                 options={'xatol': 1.e-8, 'maxiter': 200})
+        candidates = (20., float(result.x), 80.)
+        self.conductance = min(candidates, key=objective)
+        return self
 
