+def _binary_relative_entropy(p):
+    """Relative entropy of a Bernoulli(p) mark fraction from one half."""
+    if p <= 0.0 or p >= 1.0:
+        return np.log(2.0)
+    return np.log(2.0) + p*np.log(p) + (1.0-p)*np.log1p(-p)
 
 
