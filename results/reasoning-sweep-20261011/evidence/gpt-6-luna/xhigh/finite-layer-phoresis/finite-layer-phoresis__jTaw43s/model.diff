@@ -40,7 +40,39 @@
         self.viscosity = None
 
     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Infer the solvent viscosity from independent calibration records.
+
+        The hydrodynamic response is linear in inverse viscosity, so the
+        weighted least-squares fit has a closed-form solution.  The specified
+        physical range for viscosity is enforced by clipping that solution to
+        the corresponding range for inverse viscosity.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+
+        base_response = np.asarray(
+            [response(**record['input']) for record in records], dtype=float)
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+
+        if (not np.all(np.isfinite(base_response))
+                or not np.all(np.isfinite(values))
+                or not np.all(np.isfinite(sigma))
+                or np.any(sigma <= 0)):
+            raise ValueError('Calibration values and positive uncertainties must be finite.')
+
+        weights = 1.0 / sigma**2
+        denominator = np.sum(weights * base_response**2)
+        if denominator == 0:
+            raise ValueError('Calibration records do not identify the viscosity.')
+
+        inverse_viscosity = np.sum(weights * base_response * values) / denominator
+        inverse_viscosity = np.clip(inverse_viscosity, 1.0 / 1.6, 1.0 / 0.8)
+        self.viscosity = float(1.0 / inverse_viscosity)
+        return self
 
     def predict(self, experiments):
+        if self.viscosity is None:
+            raise ValueError('Call fit(records) before predict(experiments).')
         return predict_at(experiments, self.viscosity)
