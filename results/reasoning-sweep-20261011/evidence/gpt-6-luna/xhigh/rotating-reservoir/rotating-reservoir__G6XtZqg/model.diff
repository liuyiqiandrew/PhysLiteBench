+    """Fit the common rotor drag from the zero-flow, constant-clock data.
+
+    For these calibration settings, the exact stationary heat current is
+    ``conductance * (temperature_a - temperature_b)``.  Estimate that
+    conductance by weighted least squares, then invert its analytic relation
+    to drag.  The final clamp enforces the documented physical parameter
+    range.
+    """
+    if not records:
+        raise ValueError('at least one calibration record is required')
+
+    temperatures=[]
+    values=[]
+    sigmas=[]
+    rates=[]
+    for record in records:
+        experiment=record['input']
+        omega=float(experiment['angular_speed'])
+        eta=float(experiment['flux_fraction'])
+        lam=float(experiment['relaxation_rate'])
+        sigma=float(record['sigma'])
+        value=float(record['value'])
+        if omega != 0. or eta != 0.:
+            raise ValueError('calibration records must have zero flow and zero flux fraction')
+        if not np.isfinite(sigma) or sigma <= 0.:
+            raise ValueError('calibration uncertainties must be finite and positive')
+        if not np.isfinite(value) or not np.isfinite(lam) or lam <= 0.:
+            raise ValueError('calibration values and relaxation rates must be finite')
+        temperatures.append(float(experiment['temperature_a']) - float(experiment['temperature_b']))
+        values.append(value)
+        sigmas.append(sigma)
+        rates.append(lam)
+
+    rates=np.asarray(rates)
+    if not np.allclose(rates, rates[0], rtol=0., atol=1e-12):
+        raise ValueError('calibration records must share one relaxation rate')
+    x=np.asarray(temperatures)
+    y=np.asarray(values)
+    sigma=np.asarray(sigmas)
+    denominator=float(np.sum((x/sigma)**2))
+    if denominator <= 0. or not np.isfinite(denominator):
+        raise ValueError('calibration temperatures do not identify the drag')
+    conductance=float(np.sum((x/sigma)*(y/sigma))/denominator)
+
+    lam=float(rates[0])
+    def conductance_at(drag):
+        return drag*lam*RATE/(2.*drag*lam+RATE*(drag+lam))
+
+    # Clip in conductance space first so the inverse remains well-defined even
+    # when noisy calibration data put the unconstrained estimate out of range.
+    conductance=np.clip(conductance,conductance_at(.4),conductance_at(1.1))
+    drag=conductance*lam*RATE/(lam*RATE-conductance*(2.*lam+RATE))
+    return float(np.clip(drag,.4,1.1))
 
 
