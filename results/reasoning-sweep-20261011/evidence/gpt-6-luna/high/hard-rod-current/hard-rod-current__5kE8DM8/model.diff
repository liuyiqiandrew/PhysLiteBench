--- starter/model.py
+++ submission/model.py
@@ -23,7 +23,30 @@
         self.speed = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the common speed from calibration records.')
+        """Fit the common speed by weighted least squares.
+
+        The response is linear in speed, so the Gaussian maximum-likelihood
+        estimate has a closed form.  Keeping the fit in the apparatus range
+        also makes it well-defined for arbitrary calibration inputs.
+        """
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+
+        basis = np.asarray([response(record['input']) for record in records],
+                           dtype=float)
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(basis).all() or not np.isfinite(values).all()
+                or not np.isfinite(sigma).all() or np.any(sigma <= 0)):
+            raise ValueError('Calibration values and uncertainties must be finite, with positive sigma.')
+
+        weights = 1.0 / sigma**2
+        denominator = np.sum(weights * basis**2)
+        if denominator <= 0:
+            raise ValueError('Calibration records do not identify the speed.')
+        estimate = np.sum(weights * basis * values) / denominator
+        self.speed = float(np.clip(estimate, 0.8, 1.3))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.speed)
