+    The supplied uncertainties are independent Gaussian standard deviations,
+    so a bounded weighted least-squares fit is the likelihood optimum.  This
+    also avoids turning noisy individual records into conductance estimates.
+    """
+    if not records:
+        raise ValueError('at least one calibration record is required')
+    inputs=[r['input'] for r in records]
+    values=np.asarray([float(r['value']) for r in records])
+    sigma=np.asarray([float(r['sigma']) for r in records])
+    if np.any(~np.isfinite(sigma)) or np.any(sigma<=0):
+        raise ValueError('calibration uncertainties must be positive and finite')
+    def objective(drag):
+        predicted=np.asarray([calibration_mean(e,drag) for e in inputs])
+        residual=(predicted-values)/sigma
+        return float(residual@residual)
+    return float(minimize_scalar(objective, bounds=(.4,1.1), method='bounded',
+                                 options={'xatol': 1e-13}).x)
 
 
