+                    or sigma <= 0.0):
+                raise ValueError('Calibration records are outside the stated domain.')
+            weight = 1.0 / (sigma * sigma)
+            numerator += -weight * beta * measured
+            denominator += weight * beta * beta
+            count += 1
+        if count == 0:
+            raise ValueError('At least one calibration record is required to fit width.')
+
+        theta = numerator / denominator
+        theta = min(WIDTH_INTERVAL[1] ** 2, max(WIDTH_INTERVAL[0] ** 2, theta))
+        self.width = math.sqrt(theta)
