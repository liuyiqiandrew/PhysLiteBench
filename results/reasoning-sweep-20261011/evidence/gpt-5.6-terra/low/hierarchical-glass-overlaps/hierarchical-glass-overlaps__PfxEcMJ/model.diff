+                    or sigma <= 0.0):
+                raise ValueError('Invalid calibration record.')
+            weight = 1.0 / (sigma * sigma)
+            numerator -= weight * beta * observed
+            denominator += weight * beta * beta
+            count += 1
+        if not count:
+            raise ValueError('At least one calibration record is required.')
+
+        # The fit is constrained to the stated material interval.  Fitting
+        # width squared first also makes the likelihood quadratic.
+        squared = min(WIDTH_INTERVAL[1] ** 2,
+                      max(WIDTH_INTERVAL[0] ** 2, numerator / denominator))
