+        """Fit the common ordinary-fluid drag from independent measurements.
+
+        The calibration protocol has zero magnetic field and no retained
+        contact, for which the analytic prediction in ``zero_field_calibration``
+        is both more accurate and considerably cheaper than solving the full
+        covariance dynamics.  ``sigma`` values are independent Gaussian
+        standard uncertainties, so the appropriate one-parameter estimate is
+        weighted least squares.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+        try:
+            values = np.asarray([record['value'] for record in records], dtype=float)
+            sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+            inputs = [record['input'] for record in records]
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError("invalid calibration records") from exc
+        if (not np.isfinite(values).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values and sigmas must be finite, with positive sigmas")
+
+        # Calibration files for this apparatus are specifically the simple
+        # zero-field/contact-free preparation.  Fail explicitly rather than
+        # silently fitting the wrong physical model if a different data set is
+        # supplied.
+        if any(float(e.get('field', 0.0)) != 0.0 or float(e.get('memory_drag', 0.0)) != 0.0
+               for e in inputs):
+            raise ValueError("calibration requires field=0 and memory_drag=0")
+
+        def objective(gamma):
+            residual = (zero_field_calibration(inputs, gamma) - values) / sigma
+            return float(residual @ residual)
+
+        result = minimize_scalar(
+            objective, bounds=(0.5, 1.5), method='bounded',
+            options={'xatol': 1e-12},
+        )
+        if not result.success or not np.isfinite(result.x):
+            raise RuntimeError("friction calibration did not converge")
+        self.friction = float(result.x)
+        return self
+
+    def predict(self,experiments):
+        experiments = list(experiments)
+        if not experiments:
+            return np.empty(0, dtype=float)
+        if self.friction is None:
+            raise RuntimeError("call fit(records) before predict(experiments)")
+        prediction = np.asarray(predict_at(experiments, self.friction), dtype=float)
+        if prediction.ndim != 1 or prediction.shape[0] != len(experiments) or not np.isfinite(prediction).all():
+            raise RuntimeError("prediction failed to produce finite scalar outputs")
+        return prediction
