         self.mobility = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        """Fit the shared mobility under the stated independent Gaussian noise."""
+        if not records:
+            raise ValueError('at least one calibration record is required')
+
+        unit_rates = np.asarray([response(record['input']) for record in records])
+        observations = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(unit_rates).all() or not np.isfinite(observations).all()
+                or not np.isfinite(sigmas).all() or np.any(sigmas <= 0)):
+            raise ValueError('calibration records must contain finite values and positive sigma')
+
+        weights = 1.0 / (sigmas * sigmas)
+        information = np.sum(weights * unit_rates * unit_rates)
+        if information <= 0:
+            raise ValueError('calibration data do not identify mobility')
+
+        # The apparatus gives a physical, known parameter range; retaining it
+        # prevents a noise-only calibration from producing an invalid model.
+        estimate = np.sum(weights * unit_rates * observations) / information
+        self.mobility = float(np.clip(estimate, 0.8, 1.3))
+        return self
 
     def predict(self, experiments):
+        if self.mobility is None:
+            raise RuntimeError('call fit before predict')
         return predict_at(experiments, self.mobility)
