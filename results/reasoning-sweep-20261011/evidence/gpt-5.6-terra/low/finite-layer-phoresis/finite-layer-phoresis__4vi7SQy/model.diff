 @lru_cache(256)
 def response(radius, width, strength, slip):
+    """Response multiplied by the viscosity.
+
+    The concentration problem is independent of viscosity and slip.  The
+    latter enters through the auxiliary translating-sphere flow used in the
+    reciprocal theorem.
+    """
     if strength == 0:
         return 0.
     end = radius+width
@@ -20,12 +26,17 @@
     if not solution.success:
         raise RuntimeError(solution.message)
     beta = slip/radius
+    # F_hat/(6 pi eta radius).  The radial component of the unit auxiliary
+    # flow is 1 - 3*drag*radius/(2*r) +
+    # radius**3/(2*(1+3*beta)*r**3).  Keeping this factor in the integrand is
+    # important: slip changes more than just the particle drag.
     drag = (1+2*beta)/(1+3*beta)
     def integrand(r):
         x = (r-radius)/width
         concentration = np.exp(-strength*(1-x)**2)*solution.sol(x)[0]
         derivative = -2*strength*(1-x)/width
-        weight = (r-radius)**2*(2*r+radius)/(2*r)
+        weight = (r*r - 1.5*radius*drag*r
+                  + radius**3/(2*(1+3*beta)*r))
         return weight*concentration*derivative
     return 2/(9*radius*drag)*quad(integrand, radius, end, epsabs=2e-11, epsrel=2e-11)[0]
 
@@ -40,7 +51,41 @@
         self.viscosity = None
 
     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Fit the single unknown viscosity by weighted least squares.
+
+        If ``q`` is the response returned by :func:`response`, every
+        measurement obeys ``value = q / viscosity + noise``.  Fitting the
+        reciprocal viscosity makes this a one-parameter linear regression
+        through the origin and naturally accommodates the supplied Gaussian
+        uncertainties.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        inputs = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        coefficients = np.asarray(
+            [response(item['radius'], item['width'], item['strength'], item['slip'])
+             for item in inputs], dtype=float)
+
+        if (not np.isfinite(values).all() or not np.isfinite(sigmas).all()
+                or np.any(sigmas <= 0) or not np.isfinite(coefficients).all()):
+            raise ValueError("calibration records must contain finite values and positive sigmas")
+
+        weights = 1.0 / sigmas**2
+        denominator = np.sum(weights * coefficients**2)
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError("calibration data do not identify viscosity")
+        inverse_viscosity = np.sum(weights * coefficients * values) / denominator
+        if not np.isfinite(inverse_viscosity) or inverse_viscosity <= 0:
+            raise ValueError("calibration data imply a non-positive viscosity")
+
+        self.viscosity = float(1.0 / inverse_viscosity)
+        return self
 
     def predict(self, experiments):
+        if self.viscosity is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.viscosity)
