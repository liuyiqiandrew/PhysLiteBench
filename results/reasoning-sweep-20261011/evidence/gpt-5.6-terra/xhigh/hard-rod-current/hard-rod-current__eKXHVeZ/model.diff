     def fit(self, records):
-        raise NotImplementedError('Fit the common speed from calibration records.')
+        """Fit the shared speed by Gaussian weighted least squares.
+
+        Every reported rate is linear in the common speed, so the maximum
+        likelihood estimate has a closed form.  Zero-response observations
+        (the mean current) correctly contain no information about speed.
+        """
+        records = list(records)
+        unit_rates = np.asarray([response(record['input']) for record in records], dtype=float)
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+
+        if (unit_rates.shape != values.shape or values.shape != sigmas.shape or
+                not np.isfinite(unit_rates).all() or not np.isfinite(values).all() or
+                not np.isfinite(sigmas).all() or np.any(sigmas <= 0.0)):
+            raise ValueError('records must contain finite values and positive standard deviations')
+
+        weights = 1.0 / sigmas ** 2
+        denominator = np.dot(weights, unit_rates ** 2)
+        if denominator <= 0.0:
+            raise ValueError('records contain no speed-sensitive observations')
+
+        self.speed = float(np.dot(weights * unit_rates, values) / denominator)
+        return self
 
     def predict(self, experiments):
