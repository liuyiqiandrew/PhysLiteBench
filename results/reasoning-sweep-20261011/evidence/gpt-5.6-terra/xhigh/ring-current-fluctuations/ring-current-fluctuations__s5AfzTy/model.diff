+current SCGF is
+
+    psi(E, lambda; D) = D * lambda * (lambda + 2 E) / 4.
+
+The calibration problem is therefore a one-parameter, weighted linear fit.
+"""
+
 import numpy as np
 
+
+_D_MIN = 0.8
+_D_MAX = 1.2
+
