 def response(radius, width, strength, slip):
+    """Return the viscosity-independent mobility for one experiment.
+
+    The concentration dipole is obtained from the steady Smoluchowski
+    equation.  The remaining one-dimensional integral is the reciprocal
+    theorem result for a force-free sphere.  It is deliberately kept
+    separate from viscosity: all of the concentration physics is independent
+    of viscosity in the rapid-diffusion limit described in the problem.
+    """
+    radius, width, strength, slip = map(float, (radius, width, strength, slip))
+    if radius <= 0 or width <= 0 or slip < 0:
+        raise ValueError("radius and width must be positive and slip non-negative")
