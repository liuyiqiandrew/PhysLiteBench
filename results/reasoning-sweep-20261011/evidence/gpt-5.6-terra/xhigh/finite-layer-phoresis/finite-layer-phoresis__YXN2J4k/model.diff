     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Fit the sole unknown, uniform dynamic viscosity.
+
+        With ``m_i`` the viscosity-independent response calculated above,
+        the observations obey ``value_i = m_i / viscosity + noise``.  Thus
+        fitting inverse viscosity is a weighted linear least-squares problem;
+        the supplied Gaussian standard deviations give the weights.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        try:
+            experiments = [record['input'] for record in records]
+            values = np.asarray([record['value'] for record in records], dtype=float)
+            sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError("each calibration record needs input, value, and sigma") from exc
+
+        if (not np.isfinite(values).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values must be finite and sigma must be positive")
+
+        mobility = predict_at(experiments, viscosity=1.0)
+        weights = 1.0 / sigma**2
+        denominator = np.dot(weights, mobility**2)
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError("calibration data do not identify viscosity")
+
+        inverse_viscosity = np.dot(weights, mobility*values) / denominator
+        if not np.isfinite(inverse_viscosity) or inverse_viscosity <= 0:
+            raise ValueError("calibration data imply a non-positive viscosity")
+
+        # Viscosity is specified to lie in [0.8, 1.6].  Constraining the
+        # maximum-likelihood estimate to that physical interval is only
+        # consequential for pathological/noisy calibration inputs.
+        inverse_viscosity = np.clip(inverse_viscosity, 1/1.6, 1/0.8)
+        self.viscosity = float(1.0/inverse_viscosity)
+        return self
 
     def predict(self, experiments):
+        if self.viscosity is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.viscosity)
