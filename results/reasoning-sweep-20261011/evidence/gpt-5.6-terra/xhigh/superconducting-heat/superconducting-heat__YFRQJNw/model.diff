     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the one extensive apparatus parameter.
+
+        Conductance is quoted in micro-siemens throughout this module.  It is
+        linear for the supplied, unmodulated calibration set, but need not be
+        linear once the driven contact creates a stationary spin imbalance.
+        A bounded one-dimensional likelihood fit consequently also does the
+        right thing for a valid extended calibration set.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        experiments = [record['input'] for record in records]
+        observed = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values and sigmas must be finite, with sigma > 0")
+
+        def chi_squared(conductance):
+            predicted = predict_at(experiments, float(conductance))
+            residual = (predicted - observed) / sigma
+            return float(residual @ residual)
+
+        solution = minimize_scalar(
+            chi_squared, bounds=(20., 80.), method='bounded',
+            options={'xatol': 1.e-9},
+        )
+        if not solution.success or not np.isfinite(solution.fun):
+            raise RuntimeError("conductance fit did not converge")
+        self.conductance = float(solution.x)
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("call fit(records) before predict(experiments)")
         return predict_at(experiments, self.conductance)
 
 
