     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the sole apparatus parameter by weighted least squares.
+
+        Conductance is expressed in microSiemens everywhere in this module.
+        Although the original calibration is linear in conductance, driven
+        records need not be: their stationary spin potentials also depend on
+        it.  Fitting through the public predictor keeps both cases consistent.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        try:
+            experiments = [record["input"] for record in records]
+            observed = np.asarray([record["value"] for record in records], dtype=float)
+            sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+        except (KeyError, TypeError) as error:
+            raise ValueError("each calibration record needs input, value, and sigma") from error
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values must be finite and sigmas must be positive")
+
+        def residual(parameter):
+            calculated = predict_at(experiments, float(parameter[0]))
+            if not np.isfinite(calculated).all():
+                # A finite residual lets the bounded optimizer move away from
+                # a numerically unsuitable trial point.
+                return np.full_like(observed, 1.e100)
+            return (calculated - observed) / sigma
+
+        result = least_squares(
+            residual, x0=np.array([50.0]), bounds=(np.array([20.0]), np.array([80.0])),
+            xtol=1.e-12, ftol=1.e-12, gtol=1.e-12, max_nfev=100,
+        )
+        if not result.success or not np.isfinite(result.x[0]):
+            raise RuntimeError("conductance fit did not converge")
+        self.conductance = float(result.x[0])
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.conductance)
 
 
