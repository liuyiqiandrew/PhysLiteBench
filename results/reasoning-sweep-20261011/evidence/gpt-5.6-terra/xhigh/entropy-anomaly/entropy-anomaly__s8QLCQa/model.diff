-        raise NotImplementedError("Fit the common friction coefficient from the calibration records.")
-    def predict(self,experiments):return coefficients(experiments,self.friction)
+        """Fit the common drag coefficient by weighted least squares.
+
+        Calibration uses the original two-contact, zero-field preparation.
+        In that preparation the limiting excess rate is exactly inversely
+        proportional to the common friction.  Writing the prediction as
+        ``a * rate_at_unit_friction`` leaves a one-parameter weighted linear
+        least-squares fit, with ``friction = 1/a``.  This both uses the stated
+        independent Gaussian uncertainties and avoids an unnecessarily noisy
+        numerical search.
+        """
+        records=list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        experiments=[]
+        values=[]
+        sigmas=[]
+        for record in records:
+            try:
+                experiment=record['input']
+                value=float(record['value'])
+                sigma=float(record['sigma'])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError("each record must contain input, value, and sigma") from exc
+            if not np.isfinite(value) or not np.isfinite(sigma) or sigma <= 0.:
+                raise ValueError("calibration values must be finite and sigma must be positive")
+            if any(field not in experiment for field in INPUT_FIELDS):
+                raise ValueError("calibration input is missing a required field")
+            experiments.append(experiment)
+            values.append(value)
+            sigmas.append(sigma)
+
+        unit_rate=coefficients(experiments,1.)
+        values=np.asarray(values)
+        inv_variance=1./np.square(sigmas)
+        denominator=float(np.sum(inv_variance*np.square(unit_rate)))
+        if not np.isfinite(denominator) or denominator <= 0.:
+            raise ValueError("calibration data do not identify friction")
+        scale=float(np.sum(inv_variance*unit_rate*values)/denominator)
+        if not np.isfinite(scale) or scale <= 0.:
+            raise ValueError("calibration data imply a non-positive friction")
+
+        # The documented parameter domain is part of the experimental model.
+        self.friction=float(np.clip(1./scale,.7,1.6))
+        return self
+
+    def predict(self,experiments):
+        if self.friction is None:
+            raise RuntimeError("call fit(records) before predict(experiments)")
+        return coefficients(experiments,self.friction)
