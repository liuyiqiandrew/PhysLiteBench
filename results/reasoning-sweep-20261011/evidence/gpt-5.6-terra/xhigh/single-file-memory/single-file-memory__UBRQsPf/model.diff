+"""Asymptotic tagged-particle covariance for the single-file apparatus."""
+
 import numpy as np
 
 
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the quenched long-time covariance coefficient.
+
+    The initial locations in the experiment are fixed rather than sampled from
+    an equilibrium point process.  Consequently the appropriate (quenched)
+    two-time result is
+
+        sqrt(D) / (rho * sqrt(pi))
+        * (sqrt(t_a + t_b) - sqrt(|t_a - t_b|)).
+
+    In particular, this is ``sqrt(2 * D * t / pi) / rho`` on the diagonal.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+    return (
+        np.sqrt(diffusivity)
+        / (density * np.sqrt(np.pi))
+        * (np.sqrt(time_a + time_b) - np.sqrt(abs(time_a - time_b)))
+    )
 
 
 def predict_at(experiments, diffusivity):
-    return np.asarray([
-        covariance(float(diffusivity), float(e["density"]),
-                   float(e["time_a"]), float(e["time_b"]))
-        for e in experiments
-    ], dtype=float)
+    """Evaluate the apparatus response in the supplied experiment order."""
+    return np.asarray(
+        [
+            covariance(
+                diffusivity,
+                experiment["density"],
+                experiment["time_a"],
+                experiment["time_b"],
+            )
+            for experiment in experiments
+        ],
+        dtype=float,
+    )
 
 
