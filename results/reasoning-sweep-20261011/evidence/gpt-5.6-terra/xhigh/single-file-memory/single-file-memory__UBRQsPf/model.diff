@@ -18,7 +47,50 @@
         self.diffusivity = None
 
     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Infer the common diffusivity by inverse-variance weighted fitting.
+
+        The response is linear in ``sqrt(D)``.  Fitting that amplitude directly
+        gives the Gaussian maximum-likelihood estimate while retaining the
+        individual reported instrument uncertainties.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        controls = [record["input"] for record in records]
+        density = np.asarray([control["density"] for control in controls], dtype=float)
+        time_a = np.asarray([control["time_a"] for control in controls], dtype=float)
+        time_b = np.asarray([control["time_b"] for control in controls], dtype=float)
+        values = np.asarray([record["value"] for record in records], dtype=float)
+        sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+
+        if (
+            not np.isfinite(density).all()
+            or not np.isfinite(time_a).all()
+            or not np.isfinite(time_b).all()
+            or not np.isfinite(values).all()
+            or not np.isfinite(sigma).all()
+            or np.any(density <= 0)
+            or np.any(time_a <= 0)
+            or np.any(time_b <= 0)
+            or np.any(sigma <= 0)
+        ):
+            raise ValueError("calibration records must contain finite positive controls and sigma")
+
+        # covariance(D, ...) = sqrt(D) * design
+        design = (
+            (np.sqrt(time_a + time_b) - np.sqrt(np.abs(time_a - time_b)))
+            / (density * np.sqrt(np.pi))
+        )
+        weights = 1.0 / np.square(sigma)
+        amplitude = np.sum(weights * design * values) / np.sum(weights * np.square(design))
+
+        # The apparatus specification supplies the physically allowed interval.
+        amplitude = np.clip(amplitude, np.sqrt(0.8), np.sqrt(1.2))
+        self.diffusivity = float(amplitude * amplitude)
+        return self
 
     def predict(self, experiments):
+        if self.diffusivity is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.diffusivity)
