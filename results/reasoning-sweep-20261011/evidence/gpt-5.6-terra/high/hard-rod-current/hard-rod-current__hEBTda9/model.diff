 def response(e):
-    rho, mean = e['density'], e['length']
+    """Current SCGF per unit speed for the hard-rod gas.
+
+    In free-length coordinates the rods form a gas of density
+    ``rho / (1 - rho * mean)``.  The random ordering of the two rod sizes
+    does not change the extensive current statistics: a crossing only sees
+    the mean excluded length.  (It can change finite-time corrections.)
+    """
+    rho, mean = float(e['density']), float(e['length'])
     if e['statistic'] == 'mean':
         return 0.
     if e['statistic'] == 'variance':
         return rho*(1-rho*mean)
-    field = abs(e['counting_field'])
+    # Left/right symmetry makes the SCGF an even function of its field.
+    field = abs(float(e['counting_field']))
     c = rho/(1-rho*mean)
+    if field == 0.:
+        return 0.
     s = brentq(lambda s: s+c*mean*np.sinh(s)-field, 0., field+1, xtol=1e-14)
     return c*2*np.sinh(s/2)**2
 
@@ -23,7 +33,24 @@
         self.speed = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the common speed from calibration records.')
+        """Fit the shared speed by Gaussian weighted least squares.
+
+        Each observation is linear in speed, so this is also the maximum
+        likelihood estimate for the independent Gaussian calibration data.
+        """
+        base = np.asarray([response(record['input']) for record in records],
+                          dtype=float)
+        values = np.asarray([record['value'] for record in records],
+                            dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records],
+                           dtype=float)
+
+        weights = 1.0 / np.square(sigma)
+        denominator = np.sum(weights * np.square(base))
+        if not np.isfinite(denominator) or denominator <= 0.:
+            raise ValueError('Calibration records contain no speed-sensitive observations.')
+        self.speed = float(np.sum(weights * base * values) / denominator)
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.speed)
