 def coefficients(experiments,friction=1.):
     return np.array([entropy_rate(*(e[f] for f in INPUT_FIELDS),float(friction),e.get('detector_phase'),e.get('valve_cycle'),e.get('contact_drag_contrast',0.)) for e in experiments])
 
+def _minimize_scalar(objective,lower,upper):
+    """Robust bounded minimisation of a smooth unimodal scalar objective."""
+    try:
+        from scipy.optimize import minimize_scalar
+        result=minimize_scalar(objective,bounds=(lower,upper),method='bounded',
+                               options={'xatol':1e-7,'maxiter':200})
+        return float(result.x)
+    except Exception:
+        pass
+    # Fallback: golden-section search over a coarse-to-fine grid refinement.
+    grid=np.linspace(lower,upper,41)
+    scores=[objective(x) for x in grid]
+    best=int(np.argmin(scores))
+    lo=grid[max(best-1,0)];hi=grid[min(best+1,len(grid)-1)]
+    ratio=(np.sqrt(5)-1)/2
+    a,b=lo,hi
+    c=b-ratio*(b-a);d=a+ratio*(b-a)
+    fc,fd=objective(c),objective(d)
+    for _ in range(100):
+        if fc<fd:
+            b,d,fd=d,c,fc
+            c=b-ratio*(b-a);fc=objective(c)
+        else:
+            a,c,fc=c,d,fd
+            d=a+ratio*(b-a);fd=objective(d)
+        if b-a<1e-8:break
+    return float(0.5*(a+b))
+
