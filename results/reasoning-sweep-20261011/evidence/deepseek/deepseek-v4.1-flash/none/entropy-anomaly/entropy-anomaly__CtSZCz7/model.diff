+        """Fit the common friction from calibration records via weighted least squares.
+
+        Each record is ``{'input': {...}, 'value': float, 'sigma': float}``.
+        ``sigma`` are independent Gaussian standard uncertainties, so the
+        negative log-likelihood is chi-squared of ``predict`` against ``value``.
+        The prediction is smooth and unimodal in friction over the physical
+        range ``[0.7, 1.6]``, so a bounded scalar minimisation is sufficient.
+        """
+        records=list(records)
+        inputs=[r['input'] for r in records]
+        values=np.asarray([float(r['value']) for r in records],dtype=float)
+        sigmas=np.asarray([float(r['sigma']) for r in records],dtype=float)
+
+        def objective(friction):
+            y=coefficients(inputs,float(friction))
+            residual=(y-values)/sigmas
+            return float(residual@residual)
+
+        friction=_minimize_scalar(objective,0.7,1.6)
+        self.friction=friction
+        return self
+
+    def predict(self,experiments):
+        if self.friction is None:
+            raise ValueError("Model must be fit before prediction.")
+        return coefficients(experiments,self.friction)
