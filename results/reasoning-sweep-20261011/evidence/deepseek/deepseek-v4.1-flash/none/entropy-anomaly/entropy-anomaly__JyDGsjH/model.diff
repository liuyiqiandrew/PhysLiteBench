+        """Fit the common friction coefficient from Gaussian calibration records.
+
+        The calibration readout (unweighted, bath_contrast=0, magnetic=0) is a
+        smooth, unimodal function of the single unknown friction, so the weighted
+        residual sum of squares is minimised on the documented [.7,1.6] interval.
+        """
+        inputs=[r['input'] for r in records]
+        values=np.array([r['value'] for r in records],dtype=float)
+        sigmas=np.array([r.get('sigma',1.) for r in records],dtype=float)
+        sigmas=np.where(sigmas>0,sigmas,1.)
+        def cost(friction):
+            residual=(coefficients(inputs,friction)-values)/sigmas
+            return float(residual@residual)
+        lo,hi=0.7,1.6
+        # A coarse scan fixes the basin (the cost is unimodal in friction), then a
+        # golden-section search refines the minimiser without any scipy dependency.
+        grid=np.linspace(lo,hi,37)
+        best=int(np.argmin([cost(f) for f in grid]))
+        a,b=grid[max(best-1,0)],grid[min(best+1,len(grid)-1)]
+        invphi=(np.sqrt(5.)-1.)/2.
+        c=b-invphi*(b-a); d=a+invphi*(b-a)
+        fc,fd=cost(c),cost(d)
+        for _ in range(100):
+            if b-a<1e-12:
+                break
+            if fc<fd:
+                b,d,fd=d,c,fc
+                c=b-invphi*(b-a)
+                fc=cost(c)
+            else:
+                a,c,fc=c,d,fd
+                d=a+invphi*(b-a)
+                fd=cost(d)
+        self.friction=float(min(max(0.5*(a+b),lo),hi))
+        return self
+    def predict(self,experiments):
+        return coefficients(experiments,self.friction)
