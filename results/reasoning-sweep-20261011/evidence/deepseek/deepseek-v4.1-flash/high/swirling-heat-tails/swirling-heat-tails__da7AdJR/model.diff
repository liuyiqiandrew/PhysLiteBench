 def response(e):
+    """Reported rate per unit mobility, i.e. I(z; preparation) / mobility.
+
+    The scaled cumulant generating function of the heat in the overdamped
+    two-dimensional trap is, with r = drive_ratio and k = stiffness,
+
+        phi(lam) = mobility*k*(1 - sqrt(1 - 4*r^2*lam*(1+lam))).
+
+    Its Legendre transform is the reported inverse-time rate, which depends
+    on the preparation only through k, r and the relative heat z:
+
+        I(z) = mobility * [ sqrt((1+r^2)(1+r^2 z^2)) - r^2 z - 1 ] * k.
+    """
     r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
-    return e['stiffness']*rate
+    rate = np.sqrt((1.0 + r * r) * (1.0 + r * r * z * z)) - r * r * z - 1.0
+    return e['stiffness'] * rate
 
 
 def predict_at(experiments, mobility):
-    return mobility*np.asarray([response(e) for e in experiments])
+    return mobility * np.asarray([response(e) for e in experiments])
 
 
