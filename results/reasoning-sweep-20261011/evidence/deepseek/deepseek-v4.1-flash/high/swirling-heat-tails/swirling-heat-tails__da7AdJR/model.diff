     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        # value = mobility * response(preparation) + N(0, sigma^2) with known
+        # sigma, so the common mobility is a weighted least-squares solution.
+        xs = np.asarray([response(r['input']) for r in records], dtype=float)
+        ys = np.asarray([r['value'] for r in records], dtype=float)
+        sigmas = np.asarray([r['sigma'] for r in records], dtype=float)
+        w = 1.0 / sigmas ** 2
+        self.mobility = float(np.sum(w * xs * ys) / np.sum(w * xs * xs))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.mobility)
