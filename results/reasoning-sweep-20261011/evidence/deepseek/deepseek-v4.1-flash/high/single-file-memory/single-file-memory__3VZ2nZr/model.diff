+_SQRT_2PI = np.sqrt(2.0 * np.pi)
 
 
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Limiting tagged-particle covariance coefficient.
+
+    Cov[X(lambda*time_a), X(lambda*time_b)] / sqrt(lambda) as lambda -> infinity
+    for a tagged particle in a single-file system of density ``density`` and
+    diffusivity ``diffusivity``.  The limiting process is fractional Brownian
+    motion with Hurst index 1/4, so the covariance is
+
+        (sqrt(D/(2*pi)) / density) * (sqrt(a) + sqrt(b) - sqrt(|a-b|)).
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+    amplitude = np.sqrt(max(diffusivity, 0.0) / (2.0 * np.pi)) / density
+    return amplitude * (
+        np.sqrt(time_a) + np.sqrt(time_b) - np.sqrt(abs(time_a - time_b))
+    )
 
 
 def predict_at(experiments, diffusivity):
-    return np.asarray([
-        covariance(float(diffusivity), float(e["density"]),
-                   float(e["time_a"]), float(e["time_b"]))
-        for e in experiments
-    ], dtype=float)
+    return np.asarray(
+        [
+            covariance(
+                diffusivity,
+                float(e["density"]),
+                float(e["time_a"]),
+                float(e["time_b"]),
+            )
+            for e in experiments
+        ],
+        dtype=float,
+    )
+
+
+def _design(records):
+    """Return per-record amplitude regressor, value and noise weights."""
+    amplitudes = []
+    values = []
+    weights = []
+    for record in records:
+        inp = record["input"]
+        density = float(inp["density"])
+        time_a = float(inp["time_a"])
+        time_b = float(inp["time_b"])
+        shape = np.sqrt(time_a) + np.sqrt(time_b) - np.sqrt(abs(time_a - time_b))
+        amplitudes.append(shape / density)
+        values.append(float(record["value"]))
+        sigma = float(record.get("sigma", 1.0))
+        weights.append(1.0 / sigma ** 2 if sigma > 0 else 1.0)
+    return (
+        np.asarray(amplitudes, dtype=float),
+        np.asarray(values, dtype=float),
+        np.asarray(weights, dtype=float),
+    )
 
 
