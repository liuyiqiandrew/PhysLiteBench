+    def fit(self, records):
+        inputs = [r['input'] for r in records]
+        values = np.asarray([r['value'] for r in records], float)
+        sigma = np.asarray([r['sigma'] for r in records], float)
+
+        def cost(viscosity):
+            self.viscosity = viscosity
+            residual = (self.predict(inputs)-values)/sigma
+            return residual@residual
+
+        result = minimize_scalar(cost, bounds=(VISCOSITY_MIN, VISCOSITY_MAX),
+                                 method='bounded',
+                                 options={'xatol': 1e-12})
+        self.viscosity = float(result.x)
+        return self
