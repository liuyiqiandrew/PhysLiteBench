+        inputs=[_record_input(r) for r in records]
+        values=np.array([_record_value(r) for r in records],dtype=float)
+        sigmas=np.array([_record_sigma(r) for r in records],dtype=float)
+        weights=np.where(sigmas>0.,1./np.maximum(sigmas,1e-300),1.)
+
+        def rates(f):
+            fr=float(f)
+            return np.array([entropy_rate(*(e[f] for f in INPUT_FIELDS),fr,
+                                          e.get('detector_phase'),e.get('valve_cycle'),
+                                          e.get('contact_drag_contrast',0.))
+                             for e in inputs])
+
+        def chi2(f):
+            r=(rates(f)-values)*weights
+            return float(r@r)
+
+        lo,hi=0.7,1.6
+        # Coarse scan to avoid picking a local minimum, then golden-section
+        # refinement on the best bracketing interval.
+        grid=np.linspace(lo,hi,91)
+        scores=[chi2(f) for f in grid]
+        best=int(np.argmin(scores))
+        a=grid[max(best-1,0)]
+        b=grid[min(best+1,len(grid)-1)]
+        invphi=(np.sqrt(5.)-1.)/2.
+        c=b-invphi*(b-a); d=a+invphi*(b-a)
+        fc,fd=chi2(c),chi2(d)
+        for _ in range(60):
+            if fc<fd:
+                b,d,fd=d,c,fc
+                c=b-invphi*(b-a); fc=chi2(c)
+            else:
+                a,c,fc=c,d,fd
+                d=a+invphi*(b-a); fd=chi2(d)
+            if b-a<1e-10:
