     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Fit the common diffusivity from calibration observations.
+
+        The model is linear in ``sqrt(diffusivity)``.  Estimating that
+        parameter directly avoids an unnecessary nonlinear optimization and
+        uses the supplied instrument uncertainties as inverse-variance
+        weights.
+        """
+        features = []
+        values = []
+        weights = []
+
+        for record in records:
+            experiment = record["input"]
+            feature = covariance(
+                1.0,
+                experiment["density"],
+                experiment["time_a"],
+                experiment["time_b"],
+            )
+            value = float(record["value"])
+            sigma = float(record.get("sigma", 1.0))
+
+            if not np.isfinite(feature) or not np.isfinite(value):
+                raise ValueError("Calibration records must contain finite values.")
+            if not np.isfinite(sigma) or sigma <= 0.0:
+                raise ValueError("Calibration uncertainties must be positive and finite.")
+
+            features.append(feature)
+            values.append(value)
+            weights.append(1.0 / sigma**2)
+
+        if not features:
+            raise ValueError("At least one calibration record is required.")
+
+        features = np.asarray(features, dtype=float)
+        values = np.asarray(values, dtype=float)
+        weights = np.asarray(weights, dtype=float)
+        denominator = np.sum(weights * features**2)
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError("Calibration records do not identify a diffusivity.")
+
+        sqrt_diffusivity = np.sum(weights * features * values) / denominator
+        if not np.isfinite(sqrt_diffusivity) or sqrt_diffusivity <= 0.0:
+            raise ValueError("Calibration records imply a non-positive diffusivity.")
+
+        self.diffusivity = float(sqrt_diffusivity**2)
+        return self
 
     def predict(self, experiments):
+        if self.diffusivity is None:
+            raise ValueError("Model must be fitted before prediction.")
         return predict_at(experiments, self.diffusivity)
