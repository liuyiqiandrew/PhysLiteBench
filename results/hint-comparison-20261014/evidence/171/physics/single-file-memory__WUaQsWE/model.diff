 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the long-time covariance coefficient for one experiment.
+
+    In the single-file long-time limit the tagged displacement is obtained
+    from the fluctuation in the number of independent free Brownian paths
+    which have crossed the tagged particle's initial position.  For one path,
+    the crossing indicators at the two observation times are correlated.  If
+    ``time_a <= time_b``, integrating that two-time indicator covariance over
+    the paths initially on one side gives a term proportional to
+    ``sqrt(time_a + time_b) - sqrt(time_b - time_a)``.  Including both sides
+    gives the symmetric expression below.
+
+    The equal-time specialization is
+
+        sqrt(2 * diffusivity / pi) * sqrt(time_a) / density,
+
+    which is also the scale used by the calibration records.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+
+    return (np.sqrt(diffusivity / np.pi) / density
+            * (np.sqrt(time_a + time_b)
+               - np.sqrt(abs(time_a - time_b))))
 
 
