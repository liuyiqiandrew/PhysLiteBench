     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the one extensive contact parameter.
+
+        ``conductance`` is expressed in micro-siemens throughout this module.
+        It is tempting to fit the zero-drive records with a simple linear
+        regression, but using the public predictor here is important: driven
+        records acquire a (small but real) conductance dependence through the
+        stationary spin accumulation.
+        """
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        inputs = []
+        values = []
+        sigmas = []
+        for record in records:
+            try:
+                experiment = record['input']
+                value = float(record['value'])
+                sigma = float(record['sigma'])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError("each record needs input, value, and positive sigma") from exc
+            if not isinstance(experiment, dict) or not np.isfinite(value) or not np.isfinite(sigma) or sigma <= 0:
+                raise ValueError("each record needs a finite value and positive sigma")
+            inputs.append(experiment)
+            values.append(value)
+            sigmas.append(sigma)
+
+        values = np.asarray(values)
+        sigmas = np.asarray(sigmas)
+
+        # A bounded scalar minimization is robust for both the original
+        # linear calibration set and optional driven calibration records.
+        from scipy.optimize import minimize_scalar
+
+        def objective(conductance):
+            try:
+                prediction = predict_at(inputs, float(conductance))
+            except (ArithmeticError, FloatingPointError, RuntimeError, ValueError):
+                return np.inf
+            residual = (prediction - values) / sigmas
+            score = float(residual @ residual)
+            return score if np.isfinite(score) else np.inf
+
+        solution = minimize_scalar(objective, bounds=(20., 80.), method='bounded',
+                                   options={'xatol': 1e-10, 'maxiter': 200})
+        if not solution.success or not np.isfinite(solution.fun):
+            raise RuntimeError("conductance calibration did not converge")
+        self.conductance = float(solution.x)
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("call fit(records) before predict(experiments)")
         return predict_at(experiments, self.conductance)
 
 
