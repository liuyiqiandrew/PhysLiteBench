+
+
+# ---- Full counting statistics of the driven contact ----------------------
+#
+# `gate_third` above was the original, useful quick approximation: it changes
+# a Poisson mark by the *linear* spin response.  That is sufficient for the
+# noise, but not for the third cumulant.  In particular it drops the change in
+# conditional event intensities while the (macroscopic) spin state fluctuates.
+# The routines below use the zero-energy Hamiltonian of the density-dependent
+# jump process.  Its stationary tilted solution gives the extensive long-time
+# cumulant generating function and retains those intensity changes.
+
+def _gate_events(e, conductance, nodes=192, count=64):
+    """Return a callable giving all base-size jump rates and state jumps.
+
+    The state coordinates are the two spin imbalances divided by nu.  We use
+    Spin potentials are only a convenient parametrisation of the normalized
+    imbalance.  The counting-field jump is the actual spin increment; the
+    potential dependence of all rates is retained when differentiating the
+    Hamiltonian.
+    """
+    args = oscillator_arguments(e)
+    kw = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+              quadratic_coupling=e.get('quadratic_coupling', 0.),
+              momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kw)
+    tl, tr = args[:2]
+    dl, dr, channels = prepare(*args, nodes=nodes, count=count,
+                                window=state['search_bound'], **kw)
+    energy, other, measure, sl, sr, pair, work, recoil, pf, pb, injection = channels
+    nenergy = energy.shape[1]
+    # Each quadrature point is an independent infinitesimal collection of
+    # elementary tunnel events.  The factor below turns its golden-rule
+    # integral into a rate for the unscaled (Lambda=1) apparatus.
+    prefactor = RATE_CONVERSION * conductance
+    inj = np.repeat(injection, nenergy, axis=0)
+    marks = np.repeat(work, nenergy)
+    pair_flat = np.repeat(pair[:, 0], nenergy)
+    measure_flat = measure.ravel() * prefactor
+    sl_flat, sr_flat = sl.repeat(nenergy, axis=0)[:, 0], sr.repeat(nenergy, axis=0)[:, 0]
+    energy_flat, other_flat = energy.ravel(), other.ravel()
+    pf_flat = np.repeat(pf[:, 0], nenergy)
+    pb_flat = np.repeat(pb[:, 0], nenergy)
+
+    # Equal-energy spin flips have N(E)/tau(E)=1/tau_n.  Keep the individual
+    # up/down processes rather than replacing them by a deterministic loss;
+    # they contribute to state fluctuations even though their work is zero.
+    gx, gw = leggauss(160)
+    flip_energy = []
+    flip_weight = []
+    for temp, delta in ((tl, dl), (tr, dr)):
+        top = delta + max(70. * temp, 8. * abs(state['mu'][len(flip_energy)]) + 20. * temp)
+        flip_energy.append(delta + (gx + 1.) * (top - delta) / 2.)
+        flip_weight.append(gw * (top - delta) / 2. * QUASIPARTICLE_DENSITY /
+                           (2. * NORMAL_POLARIZATION_TIME))
+
+    def rates_and_jumps(mu):
+        f = expit((sl_flat * mu[0] - energy_flat) / tl)
+        g = expit((sr_flat * mu[1] - other_flat) / tr)
+        forward = np.where(pair_flat,
+                           pf_flat * (1. - f) * (1. - g),
+                           pf_flat * f * (1. - g))
+        backward = np.where(pair_flat,
+                            pb_flat * f * g,
+                            pb_flat * g * (1. - f))
+        # The reverse elementary event reverses both the physical spin jump
+        # and the gate-work mark.
+        rates = [measure_flat * forward, measure_flat * backward]
+        jumps = [inj, -inj]
+        works = [marks, -marks]
+        for j, (temp, ee, ww) in enumerate(zip((tl, tr), flip_energy, flip_weight)):
+            up = expit((mu[j] - ee) / temp)
+            down = expit((-mu[j] - ee) / temp)
+            vdown = np.zeros((len(ee), 2)); vdown[:, j] = -2.
+            vup = -vdown
+            rates.extend((ww * up * (1. - down), ww * down * (1. - up)))
+            jumps.extend((vdown, vup))
+            works.extend((np.zeros_like(ee), np.zeros_like(ee)))
+        return (np.concatenate(rates), np.concatenate(jumps), np.concatenate(works))
+
+    return state, (tl, tr), (dl, dr), rates_and_jumps
+
+
+def _tilted_gate_cumulants(e, conductance, nodes=192, count=64):
+    """Second and third work cumulants in kelvin powers per second.
+
+    For a density-dependent Markov jump process the leading scaled CGF is
+    H(mu, p, q), evaluated at H_p=H_mu=0.  q counts gate work in kelvin and p
+    is its spin-state conjugate.  We evaluate this small four-variable saddle
+    at symmetric counting fields and remove the q and q^2 terms explicitly;
+    this is appreciably more stable than differencing a raw third derivative.
+    """
+    if e.get('amplitude', 0.) == 0.:
+        return 0., 0.
+    state, temperatures, deltas, event_rates = _gate_events(e, conductance, nodes, count)
+    mu0 = np.asarray(state['mu'], float)
+
+    def hamiltonian(mu, p, q):
+        rate, jump, work = event_rates(mu)
+        z = jump @ p + q * work
+        return float(np.sum(rate * np.expm1(z)))
+
+    # H_p is analytic.  H_mu is evaluated symmetrically, including both the
+    # rate and coordinate-jump dependence on mu.
+    def equations(y, q):
+        mu, p = y[:2], y[2:]
+        rate, jump, work = event_rates(mu)
+        z = jump @ p + q * work
+        ez = np.exp(np.clip(z, -700., 700.))
+        hp = (rate * ez) @ jump
+        hm = np.empty(2)
+        for j in range(2):
+            step = 2.e-5 * max(1., temperatures[j])
+            plus, minus = mu.copy(), mu.copy()
+            plus[j] += step; minus[j] -= step
+            hm[j] = (hamiltonian(plus, p, q) - hamiltonian(minus, p, q)) / (2. * step)
+        # Dimensionless residuals prevent the large physical rate scale from
+        # making the nonlinear solve appear converged too early.
+        scale = max(1., float(np.sum(rate)))
+        return np.r_[hp / scale, hm / scale]
+
+    base_rate, _, base_work = event_rates(mu0)
+    mean = float(base_rate @ base_work)
+    maximum_mark = max(1., float(np.max(np.abs(base_work))))
+    h = .005 / maximum_mark
+    cache = {}
+
+    def tilted_value(q, initial):
+        answer = least_squares(lambda y: equations(y, q), initial,
+                               x_scale=np.array([1., 1., .1, .1]),
+                               ftol=3e-12, xtol=3e-12, gtol=3e-12,
+                               max_nfev=100)
+        if not answer.success or np.max(np.abs(equations(answer.x, q))) > 2e-7:
+            raise RuntimeError('tilted spin counting-field saddle did not converge')
+        cache[q] = answer.x
+        return hamiltonian(answer.x[:2], answer.x[2:], q), answer.x
+
+    # Continuation from q=0 makes the selected root the one connected to the
+    # stationary physical state, even in strongly spin-polarised cases.
+    values = {}
+    for multiplier in (1., -1., 2., -2.):
+        q = multiplier * h
+        initial = cache.get(np.sign(q) * h, np.r_[mu0, np.zeros(2)])
+        values[q], _ = tilted_value(q, initial)
+
+    def even(q):
+        return (values[q] + values[-q]) / 2.
+    def odd_remainder(q):
+        return ((values[q] - values[-q]) / 2. - mean * q)
+
+    # A(q)=a0+a1*q^2+... evaluated at h and 2h.  The intercepts remove the
+    # leading fourth/fifth order finite-counting-field contamination.
+    n1, n2 = even(h) / h**2, even(2*h) / (2*h)**2
+    t1, t2 = odd_remainder(h) / h**3, odd_remainder(2*h) / (2*h)**3
+    second = 2. * (4. * n1 - n2) / 3.
+    third = 6. * (4. * t1 - t2) / 3.
+    return second, third
+
+
+def gate_third(e, conductance, nodes=192, count=64):
+    """Full stationary third gate-work cumulant, in pW^3 s^2."""
+    _, third = _tilted_gate_cumulants(e, conductance, nodes, count)
+    return dict(third=third * KB**3 * 1e36)
+
+
+def predict_at(experiments, conductance):
+    if conductance is None:
+        raise ValueError('call fit before predict')
+    out = []
+    for e in experiments:
+        statistic = e.get('statistic', 'mean')
+        if statistic == 'gate_noise':
+            # The linearised saddle is exact for the leading macroscopic
+            # second cumulant and is faster than a separate tilted solve.
+            out.append(gate_statistics(e, conductance)['noise'] if e.get('amplitude', 0.) else 0.)
+        elif statistic == 'gate_third':
+            out.append(gate_third(e, conductance)['third'])
+        elif statistic in ('mean', 'phase_contrast'):
+            out.append(mean_predict([e], conductance)[0])
+        else:
+            raise ValueError('unknown statistic: %s' % statistic)
+    return np.asarray(out, dtype=float)
