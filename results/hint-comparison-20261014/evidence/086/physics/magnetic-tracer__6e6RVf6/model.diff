+def _periodic_derivatives(n):
+    """Fourier collocation derivatives on one 2*pi period."""
+    wave = np.fft.fftfreq(n, 1/n)
+    identity = np.eye(n)
+    dx = np.fft.ifft(1j*wave[:, None]*np.fft.fft(identity, axis=0), axis=0).real
+    dxx = np.fft.ifft(-wave[:, None]**2*np.fft.fft(identity, axis=0), axis=0).real
+    return dx, dxx
+
+
+@lru_cache(512)
+def _channel_coefficients(gamma,zeta,kappa,T,Tb,B0,B1,phase,V,rate,
+                          drag_contrast,temperature_contrast,n,
+                          transverse_drive,drive_phase,fluid_anisotropy,
+                          fluid_axis):
+    """Small-mass coefficients, including the corrector-induced drift.
+
+    ``K`` is deliberately retained rather than replaced by its symmetric
+    part: its antisymmetric part is the finite-mass (rough-path) correction
+    needed by the spatially weighted circulation detector.
+    """
+    x = np.arange(n)*2*np.pi/n
+    field = B0+B1*np.cos(x+phase)
+    field_prime = -B1*np.sin(x+phase)
+    drift = np.empty((n, 2)); diffusion = np.empty((n, 2, 2)); correction = np.empty((n, 2, 2))
+    for j, (b, bp, angle) in enumerate(zip(field, field_prime, x)):
+        mobility, D, induced, _, K = valve_cell(
+            gamma, zeta, kappa, T, Tb, b, rate, drag_contrast,
+            temperature_contrast, fluid_anisotropy, fluid_axis)
+        force = np.array([V*np.sin(angle),
+                          transverse_drive*np.cos(angle+drive_phase)])
+        drift[j] = mobility@force + bp*induced
+        diffusion[j] = D
+        correction[j] = K
+    return x, drift, diffusion, correction
+
+
+def _stationary_density(drift, diffusion, dx, dxx):
+    """Stationary density normalized so that its grid mean is one."""
+    n = len(drift)
+    generator = -dx@np.diag(drift[:, 0]) + dxx@np.diag(diffusion[:, 0, 0])
+    system = generator.copy()
+    rhs = np.zeros(n)
+    # The left null vector of this conservative collocation discretisation is
+    # constant.  Replacing one equation imposes sum(p)/n = 1.
+    system[0] = 1/n
+    rhs[0] = 1
+    p = np.linalg.solve(system, rhs)
+    return generator, system, p
+
+
