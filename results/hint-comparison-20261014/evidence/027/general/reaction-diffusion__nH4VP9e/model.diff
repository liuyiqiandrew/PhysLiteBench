+    def fit(self, data):
+        """Fit the one common diffusion scale by weighted least squares."""
+        required = ("x", "t", "initial", "concentration", "sigma")
+        missing = [name for name in required if name not in data]
+        if missing:
+            raise ValueError("calibration data missing " + ", ".join(missing))
+        x, _ = self._check_grid(data["x"])
+        t = self._check_times(data["t"])
+        initial = np.asarray(data["initial"], dtype=float)
+        observed = np.asarray(data["concentration"], dtype=float)
+        sigma = np.asarray(data["sigma"], dtype=float)
+        expected = (len(initial), len(t), len(x), 2)
+        if initial.ndim != 3 or initial.shape[1:] != (len(x), 2) or observed.shape != expected or sigma.shape != expected:
