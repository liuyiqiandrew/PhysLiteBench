+"""Large-deviation model for heat in the circulating harmonic trap."""
+
 import numpy as np
 
 
 def response(e):
-    r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
