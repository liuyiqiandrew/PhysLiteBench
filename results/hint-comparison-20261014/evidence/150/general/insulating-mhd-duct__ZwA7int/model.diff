+@lru_cache(maxsize=1)
+def operators():
+    """Build the velocity modes and insulating-wall magnetic operator pieces.
+
+    Charge conservation gives ``(-laplacian) phi = By*u_x - Bx*u_y``.
+    Hence the Lorentz force is ``-sigma*K*u``, with
+    ``K = |B|^2 I - D.T*(-laplacian)^-1*D`` and ``D = By*C_x - Bx*C_y``.
+    """
+    grid_m, grid_n = np.meshgrid(
+        np.arange(1, X_MODES + 1), np.arange(1, Y_MODES + 1), indexing="ij"
+    )
+    keep = (grid_m + grid_n) % 2 == 0
+    m, n = grid_m[keep], grid_n[keep]
+    wave2 = (m * np.pi / WIDTH) ** 2 + (n * np.pi / HEIGHT) ** 2
+    forcing = np.where(
+        (m % 2 == 1) & (n % 2 == 1), 8.0 / (np.pi**2 * m * n), 0.0
+    )
+
+    overlap_x = _sine_cosine_overlap(ELECTRIC_MODES, X_MODES)
+    overlap_y = _sine_cosine_overlap(ELECTRIC_MODES, Y_MODES)
+    size = len(m)
+    qx = np.zeros((size, size), dtype=float)
+    qy = np.zeros((size, size), dtype=float)
+
+    electric_y = np.arange(ELECTRIC_MODES + 1, dtype=float)
+    for fixed_m in np.unique(m):
+        ids = np.flatnonzero(m == fixed_m)
+        coupling = overlap_y[:, n[ids]]
+        denominator = (fixed_m * np.pi / WIDTH) ** 2 + (electric_y * np.pi / HEIGHT) ** 2
+        qx[np.ix_(ids, ids)] = (fixed_m * np.pi / WIDTH) ** 2 * (
+            coupling.T @ (coupling / denominator[:, None])
+        )
+
+    electric_x = np.arange(ELECTRIC_MODES + 1, dtype=float)
+    for fixed_n in np.unique(n):
+        ids = np.flatnonzero(n == fixed_n)
+        coupling = overlap_x[:, m[ids]]
+        denominator = (electric_x * np.pi / WIDTH) ** 2 + (fixed_n * np.pi / HEIGHT) ** 2
+        qy[np.ix_(ids, ids)] = (fixed_n * np.pi / HEIGHT) ** 2 * (
+            coupling.T @ (coupling / denominator[:, None])
+        )
+
+    # C_x.T L^-1 C_y: its potential mode is exactly (p, q) = (m_i, n_j).
+    mi, mj = m[:, None], m[None, :]
+    ni, nj = n[:, None], n[None, :]
+    cross = (
+        (mi * np.pi / WIDTH) * (nj * np.pi / HEIGHT)
+        / ((mi * np.pi / WIDTH) ** 2 + (nj * np.pi / HEIGHT) ** 2)
+        * overlap_y[nj, ni]
+        * overlap_x[mi, mj]
+    )
+    return m, n, wave2, forcing, qx, qy, cross + cross.T
+
