+def _sine_cosine_overlap(limit, modes):
+    """Return <normalised cosine_p, normalised sine_m> on a unit interval."""
+    p = np.arange(limit + 1, dtype=float)[:, None]
+    m = np.arange(modes + 1, dtype=float)[None, :]
+    answer = np.zeros((limit + 1, modes + 1), dtype=float)
+    p_full = np.broadcast_to(p, answer.shape)
+    m_full = np.broadcast_to(m, answer.shape)
+    zero_mode = (p == 0) & (m > 0) & ((m.astype(int) & 1) == 1)
+    answer[zero_mode] = 2.0 * np.sqrt(2.0) / (np.pi * m_full[zero_mode])
+    valid = (p > 0) & (m > 0) & (((p.astype(int) + m.astype(int)) & 1) == 1)
+    answer[valid] = 4.0 * m_full[valid] / (
+        np.pi * (m_full[valid] ** 2 - p_full[valid] ** 2)
+    )
+    return answer
 
 
