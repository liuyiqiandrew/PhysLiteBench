         self.diffusivity = None
 
     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Fit the common diffusivity by Gaussian weighted least squares."""
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        # The prediction is a_i * sqrt(D), so this is a one-parameter
+        # weighted linear fit in sqrt(D).  It is also the Gaussian MLE.
+        factors = np.asarray(
+            [
+                covariance(
+                    1.0,
+                    record["input"]["density"],
+                    record["input"]["time_a"],
+                    record["input"]["time_b"],
+                )
+                for record in records
+            ],
+            dtype=float,
+        )
+        values = np.asarray([record["value"] for record in records], dtype=float)
+        sigmas = np.asarray([record["sigma"] for record in records], dtype=float)
+        if not (np.isfinite(values).all() and np.isfinite(sigmas).all() and (sigmas > 0).all()):
+            raise ValueError("calibration values must be finite and sigmas positive")
+
+        weights = 1.0 / np.square(sigmas)
+        denominator = np.sum(weights * np.square(factors))
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError("calibration records do not identify diffusivity")
+        root_diffusivity = np.sum(weights * factors * values) / denominator
+
+        # D is known to lie in this interval; imposing it makes this the
+        # constrained Gaussian MLE as well.
+        root_diffusivity = np.clip(root_diffusivity, np.sqrt(0.8), np.sqrt(1.2))
+        self.diffusivity = float(root_diffusivity * root_diffusivity)
+        return self
 
     def predict(self, experiments):
+        if self.diffusivity is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.diffusivity)
