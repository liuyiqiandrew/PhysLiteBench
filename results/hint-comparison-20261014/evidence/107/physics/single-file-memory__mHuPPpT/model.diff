+"""Asymptotic covariance model for a tagged particle in a single file."""
+
 import numpy as np
 
 
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the joint long-time covariance coefficient.
+
+    The initially fixed lattice is a *quenched* preparation.  On the
+    diffusive scale the tagged displacement is the integrated current across
+    its initial position divided by ``density``.  Integrating the correlated
+    two-time crossing events of each independent Brownian path gives the
+    expression below.  In particular, it is not obtained by assuming
+    stationary increments of the tagged particle.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+
+    if not (np.isfinite(diffusivity) and diffusivity >= 0):
+        raise ValueError("diffusivity must be finite and non-negative")
+    if not (np.isfinite(density) and density > 0):
+        raise ValueError("density must be finite and positive")
+    if not (np.isfinite(time_a) and np.isfinite(time_b) and time_a >= 0 and time_b >= 0):
+        raise ValueError("times must be finite and non-negative")
+
+    return (
+        np.sqrt(diffusivity) / (density * np.sqrt(np.pi))
+        * (np.sqrt(time_a + time_b) - np.sqrt(abs(time_a - time_b)))
+    )
 
 
 def predict_at(experiments, diffusivity):
-    return np.asarray([
-        covariance(float(diffusivity), float(e["density"]),
-                   float(e["time_a"]), float(e["time_b"]))
-        for e in experiments
-    ], dtype=float)
+    """Evaluate the model in input order as a one-dimensional float array."""
+    return np.asarray(
+        [
+            covariance(
+                diffusivity,
+                experiment["density"],
+                experiment["time_a"],
+                experiment["time_b"],
+            )
+            for experiment in experiments
+        ],
+        dtype=float,
+    )
 
 
