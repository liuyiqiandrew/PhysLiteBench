+        y1=objective(x1);y2=objective(x2)
+        for _ in range(36):
+            if y1>y2:
+                lo=x1;x1=x2;y1=y2;x2=lo+(hi-lo)/phi;y2=objective(x2)
+            else:
+                hi=x2;x2=x1;y2=y1;x1=hi-(hi-lo)/phi;y1=objective(x1)
