-"""Current SCGF model and calibration interface."""
+"""Large-ring current SCGF for the half-filled weakly asymmetric SEP.
+
+The hydrodynamic SCGF only depends on ``c = bias * (bias + 2 * field)``.
+For ``c >= -4*pi**2`` its optimal density is uniform.  Below that value the
+optimal history is a single travelling wave.  At half filling its value is
+given by the standard elliptic-integral parametrisation used below.
+"""
+
+from __future__ import annotations
+
 import numpy as np
+from scipy.optimize import brentq
+from scipy.special import ellipk, ellipe
+
+
+_CRITICAL_C = -4.0 * np.pi**2
+
+
+def _wave_scgf(c: np.ndarray) -> np.ndarray:
+    """Return the SCGF with diffusivity one for the broken-symmetry branch.
+
+    Write ``g=sqrt(-c)`` and choose the elliptic parameter ``m`` from
+    ``4 K(m)=g``.  The average over the corresponding ``sn`` density wave is
+    elementary in terms of K and E.
+    """
+    result = np.empty_like(c, dtype=float)
+    for index, value in np.ndenumerate(c):
+        g = float(np.sqrt(-value))
+        # The branch is only called for g > 2*pi.  Leaving a little room from
+        # one keeps the elliptic functions well conditioned.
+        target = g / 4.0
+        m = brentq(lambda x: ellipk(x) - target, 0.0, 1.0 - 1.0e-14)
+        k_complete = ellipk(m)
+        e_complete = ellipe(m)
+
+        # <1 - m_amp^2 sn^2> over one period.  (Here m is the elliptic
+        # parameter, rather than the modulus.)
+        density_factor = (e_complete / k_complete + m - 1.0) / m
+        result[index] = (
+            -0.5 * g * g * density_factor
+            + 0.25 * g * g * (1.0 - m)
+        )
+    return result
+
+
+def _unit_diffusivity_prediction(field: np.ndarray, bias: np.ndarray) -> np.ndarray:
+    """SCGF in inverse time units when the microscopic diffusivity is one."""
+    c = bias * (bias + 2.0 * field)
+    values = c / 4.0
+    wave = c < _CRITICAL_C
+    if np.any(wave):
+        values = np.asarray(values, dtype=float).copy()
+        values[wave] = _wave_scgf(c[wave])
+    return np.asarray(values, dtype=float)
+
 
 def predict_at(experiments, diffusivity):
