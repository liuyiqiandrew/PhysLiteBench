     def fit(self, records):
-        raise NotImplementedError("Fit diffusivity from the calibration records.")
+        """Fit D by inverse-variance weighted least squares.
+
+        The SCGF is linear in D, so this is also the Gaussian maximum-
+        likelihood estimate for the independent measurements.  Restricting
+        it to the known physical interval prevents an ill-conditioned input
+        set from producing an invalid public parameter.
+        """
+        if not records:
+            # There is no information to update the documented default.
+            self.diffusivity = 1.0
+            return self
+
+        inputs = [record["input"] for record in records]
+        response = np.asarray([record["value"] for record in records], dtype=float)
+        sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+        design = predict_at(inputs, 1.0)
+
+        valid = (
+            np.isfinite(design)
+            & np.isfinite(response)
+            & np.isfinite(sigma)
+            & (sigma > 0.0)
+        )
+        if np.any(valid):
+            weights = 1.0 / np.square(sigma[valid])
+            denominator = float(np.dot(weights, np.square(design[valid])))
+            if denominator > 0.0 and np.isfinite(denominator):
+                estimate = float(np.dot(weights * design[valid], response[valid]) / denominator)
+                if np.isfinite(estimate):
+                    self.diffusivity = float(np.clip(estimate, 0.8, 1.2))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
