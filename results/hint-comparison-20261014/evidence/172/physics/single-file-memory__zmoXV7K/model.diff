+"""Long-time covariance model for the tagged particle.
+
+The initial configuration is a fixed lattice (rather than an equilibrium
+Poisson configuration).  In the long-time scaling limit the tagged-particle
+displacement is the integrated current through its initial position, divided
+by the density.  The current is a sum of independent Brownian crossing
+indicators.  Keeping the two indicators from the *same* Brownian path gives
+the kernel implemented below.
+"""
+
 import numpy as np
 
 
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the limiting tagged-particle covariance coefficient.
+
+    For a fixed initial lattice, the crossing-current covariance is
+
+        sqrt(D / pi) [sqrt(t_a + t_b) - sqrt(|t_a - t_b|)].
+
+    Dividing the current by ``density`` converts it to tagged displacement.
+    In particular, this is not the stationary-increment expression that
+    would contain ``sqrt(t_a) + sqrt(t_b)`` instead.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+    return (
+        np.sqrt(diffusivity / np.pi)
+        * (np.sqrt(time_a + time_b) - np.sqrt(abs(time_a - time_b)))
+        / density
+    )
 
 
 def predict_at(experiments, diffusivity):
-    return np.asarray([
-        covariance(float(diffusivity), float(e["density"]),
-                   float(e["time_a"]), float(e["time_b"]))
-        for e in experiments
-    ], dtype=float)
+    """Evaluate the documented prediction interface in input order."""
+    return np.asarray(
+        [
+            covariance(
+                diffusivity,
+                experiment["density"],
+                experiment["time_a"],
+                experiment["time_b"],
+            )
+            for experiment in experiments
+        ],
+        dtype=float,
+    )
 
 
