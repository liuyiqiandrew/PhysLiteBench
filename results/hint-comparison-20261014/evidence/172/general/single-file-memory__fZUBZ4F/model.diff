+"""Asymptotic covariance model for a tagged single-file Brownian particle."""
+
+import math
+
 import numpy as np
 
 
+_MIN_DIFFUSIVITY = 0.8
+_MAX_DIFFUSIVITY = 1.2
+
+
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the long-time covariance coefficient for one experiment.
+
+    The initially deterministic, equally spaced configuration is important here:
+    it gives the quenched kernel ``sqrt(t_a + t_b) - sqrt(|t_a-t_b|)``.
+    A randomly populated equilibrium initial state has a different
+    off-diagonal covariance.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+    if not (math.isfinite(diffusivity) and diffusivity >= 0.0):
+        raise ValueError("diffusivity must be finite and non-negative")
+    if not (math.isfinite(density) and density > 0.0):
+        raise ValueError("density must be finite and positive")
+    if not (math.isfinite(time_a) and time_a >= 0.0 and
+            math.isfinite(time_b) and time_b >= 0.0):
+        raise ValueError("times must be finite and non-negative")
+
+    kernel = math.sqrt(time_a + time_b) - math.sqrt(abs(time_a - time_b))
+    return math.sqrt(diffusivity / math.pi) * kernel / density
+
+
+def _coefficient(experiment):
+    """Coefficient multiplying sqrt(diffusivity) for an experiment."""
+    return covariance(1.0, experiment["density"], experiment["time_a"], experiment["time_b"])
 
 
