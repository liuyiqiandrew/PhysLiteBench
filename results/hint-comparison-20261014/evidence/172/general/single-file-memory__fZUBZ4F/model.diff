     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Fit the common diffusivity by weighted Gaussian least squares.
+
+        Since each prediction is ``c_i * sqrt(D)``, the maximum-likelihood
+        estimate of ``sqrt(D)`` has a closed form.  The known physical bounds
+        are then imposed on that one-dimensional estimate.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        coefficients = []
+        values = []
+        sigmas = []
+        for record in records:
+            try:
+                coefficient = _coefficient(record["input"])
+                value = float(record["value"])
+                sigma = float(record["sigma"])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError("each record needs valid input, value, and sigma fields") from exc
+            if not (math.isfinite(value) and math.isfinite(sigma) and sigma > 0.0):
+                raise ValueError("record values must be finite and sigmas must be positive")
+            coefficients.append(coefficient)
+            values.append(value)
+            sigmas.append(sigma)
+
+        coefficients = np.asarray(coefficients, dtype=float)
+        values = np.asarray(values, dtype=float)
+        weights = 1.0 / np.square(np.asarray(sigmas, dtype=float))
+        denominator = float(np.dot(weights, np.square(coefficients)))
+        if not (math.isfinite(denominator) and denominator > 0.0):
+            raise ValueError("calibration records contain no information about diffusivity")
+
+        sqrt_diffusivity = float(np.dot(weights * coefficients, values) / denominator)
+        sqrt_diffusivity = float(np.clip(
+            sqrt_diffusivity,
+            math.sqrt(_MIN_DIFFUSIVITY),
+            math.sqrt(_MAX_DIFFUSIVITY),
+        ))
+        self.diffusivity = sqrt_diffusivity * sqrt_diffusivity
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
