+                raise ValueError('Invalid calibration record.') from exc
+            if (not math.isfinite(beta) or not 0.2 <= beta <= 0.6
+                    or not math.isfinite(measured)
+                    or not math.isfinite(sigma) or sigma <= 0.0):
+                raise ValueError('Invalid calibration record.')
+            weight = 1.0 / (sigma * sigma)
+            numerator += weight * (-beta) * measured
+            denominator += weight * beta * beta
+            count += 1
+
+        if count == 0 or denominator == 0.0:
+            raise ValueError('At least one calibration record is required.')
+
+        squared_width = numerator / denominator
+        squared_width = min(WIDTH_INTERVAL[1] ** 2,
+                            max(WIDTH_INTERVAL[0] ** 2, squared_width))
+        self.width = math.sqrt(squared_width)
