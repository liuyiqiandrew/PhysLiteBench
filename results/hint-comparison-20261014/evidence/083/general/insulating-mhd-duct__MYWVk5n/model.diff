     def fit(self, records):
-        raise NotImplementedError
+        """Estimate the viscosity from independent calibration records.
+
+        The forward model is linear in the applied pressure gradient, but
+        nonlinear in viscosity through the decay rates.  Consequently this
+        is a one-dimensional weighted least-squares problem.  The supplied
+        ``sigma`` values are measurement standard deviations, so the
+        objective is the usual Gaussian chi-square.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        experiments = [record['input'] for record in records]
+        measured = np.asarray([record['value'] for record in records], dtype=float)
+        uncertainty = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(measured).all() or
+                not np.isfinite(uncertainty).all() or
+                np.any(uncertainty <= 0.0)):
+            raise ValueError("calibration values and sigma must be finite, with sigma > 0")
+
+        def objective(viscosity):
+            prediction = self._predict(experiments, viscosity)
+            residual = (prediction - measured) / uncertainty
+            return float(residual @ residual)
+
+        result = minimize_scalar(
+            objective,
+            bounds=(0.006, 0.018),
+            method='bounded',
+            options={'xatol': 1e-12},
+        )
+        # Include the endpoints explicitly.  This also makes the behavior
+        # robust if a future calibration set prefers a boundary value.
+        candidates = [(result.fun, result.x)]
+        for viscosity in (0.006, 0.018):
+            candidates.append((objective(viscosity), viscosity))
+        _, self.viscosity = min(candidates, key=lambda item: item[0])
+        return self
 
     def predict(self, experiments):
+        if self.viscosity is None:
+            raise RuntimeError("fit must be called before predict")
+        return self._predict(experiments, self.viscosity)
