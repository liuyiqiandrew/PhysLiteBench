+    pair=np.asarray(pair[:,0], dtype=bool).repeat(nquad)
+    q=np.repeat(np.asarray(injection, dtype=float), nquad, axis=0)
+    work=np.asarray(work, dtype=float).repeat(nquad)
+    measure=np.asarray(measure, dtype=float).ravel()
+    pf=np.asarray(pf, dtype=float).repeat(nquad)
+    pb=np.asarray(pb, dtype=float).repeat(nquad)
+    energy=np.asarray(energy, dtype=float).ravel()
