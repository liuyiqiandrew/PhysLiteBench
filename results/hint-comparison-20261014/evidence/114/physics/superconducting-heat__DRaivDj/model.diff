+        """Fit the single normal-state conductance from the calibration set.
+
+        The supplied calibration set contains the original, unmodulated
+        mean readout.  In that limit the stationary spin potentials are zero
+        by spin symmetry, so the prediction is linear in the conductance.
+        Keeping the weighted least-squares fit here also makes ``fit`` work
+        for a subset of calibration records without introducing another
+        fitted state variable.
+        """
+        if not records:
+            raise ValueError('At least one calibration record is required')
+        design = []
+        values = []
+        weights = []
+        for record in records:
+            experiment = record['input']
+            statistic = experiment.get('statistic', 'mean')
+            # Calibration is documented as a mean calibration.  If callers
+            # provide a phase-contrast calibration record, evaluate its unit-
+            # conductance response just as predict() does.
+            if statistic == 'phase_contrast':
+                phase = experiment['phase']
+                first = dict(experiment, phase=phase)
+                second = dict(experiment, phase=phase + np.pi)
+                unit = (mean_heat(first, 1.) - mean_heat(second, 1.)) / 2.
+            elif statistic == 'mean':
+                unit = mean_heat(experiment, 1.)
+            else:
+                raise ValueError(f'Unsupported calibration statistic: {statistic}')
+            sigma = float(record.get('sigma', 1.))
+            if not np.isfinite(unit) or not np.isfinite(record['value']) or sigma <= 0:
+                raise ValueError('Calibration records must contain finite values and positive sigma')
+            design.append(unit)
+            values.append(float(record['value']))
+            weights.append(1. / sigma**2)
+        design = np.asarray(design)
+        values = np.asarray(values)
+        weights = np.asarray(weights)
+        denominator = np.sum(weights * design * design)
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError('Calibration records do not constrain conductance')
+        fitted = np.sum(weights * design * values) / denominator
+        self.conductance = float(np.clip(fitted, 20., 80.))
+        return self
 
     def predict(self, experiments):
