+    ratio=QUASIPARTICLE_DENSITY/(NORMAL_POLARIZATION_TIME*RATE_CONVERSION*conductance)
+    flips=[]
+    for temp,delta in zip((tl,tr),(dl,dr)):
+        x,w=leggauss(192)
+        upper=delta+max(80*temp, 6*state['search_bound'])
+        ee=delta+(x+1)*(upper-delta)/2
+        mm=w*(upper-delta)/2*ratio/2
+        flips.append((temp,ee,mm))
+    return dict(state=state,args=args,
+                channels=(energy,other,measure,sl,sr,pair,work,pf,pb,q),
+                flips=flips)
+
+
+def _counting_rates(data, mu):
+    """Conditional tunnelling and spin-flip rates and their mu gradients."""
+    energy,other,measure,sl,sr,pair,work,pf,pb,q=data['channels']
+    tl,tr=data['args'][:2]
+    f=expit((sl*mu[0]-energy)/tl)
+    g=expit((sr*mu[1]-other)/tr)
+    df=f*(1-f)/tl; dg=g*(1-g)/tr
+    rp=np.where(pair,measure*pf*(1-f)*(1-g),measure*pf*f*(1-g))
+    rm=np.where(pair,measure*pb*f*g,measure*pb*g*(1-f))
+    drp=np.empty((len(rp),2)); drm=np.empty((len(rm),2))
+    drp[:,0]=np.where(pair,measure*pf*(-sl*df)*(1-g),measure*pf*(sl*df)*(1-g))
+    drp[:,1]=np.where(pair,measure*pf*(1-f)*(-sr*dg),measure*pf*f*(-sr*dg))
+    drm[:,0]=np.where(pair,measure*pb*(sl*df)*g,measure*pb*g*(-sl*df))
+    drm[:,1]=np.where(pair,measure*pb*f*(sr*dg),measure*pb*(sr*dg)*(1-f))
+    flip_rates=[]; flip_grads=[]
+    for j,(temp,ee,mm) in enumerate(data['flips']):
+        u=expit((mu[j]-ee)/temp); d=expit((-mu[j]-ee)/temp)
+        du=u*(1-u)/temp; dd=d*(1-d)/temp
+        up=mm*u*(1-d); down=mm*d*(1-u)
+        dup=mm*(du*(1-d)+u*dd)
+        ddown=mm*(-dd*(1-u)-d*du)
+        flip_rates.append((float(np.sum(up)),float(np.sum(down))))
+        flip_grads.append((float(np.sum(dup)),float(np.sum(ddown))))
+    return rp,rm,drp,drm,flip_rates,flip_grads
+
+
+def _tilted_equations(z, data, k):
+    """Hamilton equations of the leading extensive tilted generator."""
+    mu=np.asarray(z[:2]); p=np.asarray(z[2:])
+    rp,rm,drp,drm,flip_rates,flip_grads=_counting_rates(data,mu)
+    _,_,_,_,_,_,work,_,_,q=data['channels']
+    exponent=k*work+q@p
+    plus=np.exp(exponent); minus=np.exp(-exponent)
+    h=float(np.sum(rp*np.expm1(exponent)+rm*np.expm1(-exponent)))
+    hp=np.sum(q*(rp*plus-rm*minus)[:,None],axis=0)
+    hm=np.sum(drp*np.expm1(exponent)[:,None]+drm*np.expm1(-exponent)[:,None],axis=0)
+    for j,((up,down),(dup,ddown)) in enumerate(zip(flip_rates,flip_grads)):
+        ep=np.exp(2*p[j]); em=np.exp(-2*p[j])
+        h += up*np.expm1(-2*p[j])+down*np.expm1(2*p[j])
+        hp[j] += -2*up*em+2*down*ep
+        hm[j] += dup*np.expm1(-2*p[j])+ddown*np.expm1(2*p[j])
+    return h,np.r_[hp,hm]
+
+
+def _exact_third_rate(data):
+    """Third cumulant retaining conditional-rate response to spin noise."""
+    mu0=np.asarray(data['state']['mu'], dtype=float)
+    state_jac=np.asarray(data['state']['jacobian'], dtype=float)
+    _,_,_,_,_,_,work,_,_,q=data['channels']
+    _,_,drp,drm,_,_= _counting_rates(data,mu0)
+    hp_mu=np.sum((drp-drm)*work[:,None],axis=0)
+    p1=-np.linalg.solve(state_jac.T,hp_mu)
+
+    def value(k):
+        if k == 0:
+            return 0.
+        guess=np.r_[mu0,k*p1]
+        scale=abs(k)
+        def equations(z):
+            return _tilted_equations(z,data,k)[1]/scale
+        solved=root(equations,guess,method='hybr',options={'xtol':1e-10})
+        if (not solved.success) or np.max(abs(equations(solved.x)))>2e-7:
+            solved=root(equations,guess,method='lm',options={'ftol':1e-13,'xtol':1e-13,'gtol':1e-13,'maxiter':1000})
+        if np.max(abs(equations(solved.x)))>2e-6:
+            raise RuntimeError('Tilted stationary spin balance did not converge')
+        return _tilted_equations(solved.x,data,k)[0]
+
+    step=1.e-3; previous=None
+    for _ in range(4):
+        grid=np.arange(-4,5,dtype=float)
+        vals=np.array([value(step*u) for u in grid])
+        coeff=np.polynomial.polynomial.polyfit(grid,vals,6)
+        third=6*coeff[3]/step**3
+        if previous is not None and abs(third-previous)<=3.e-5*max(1.,abs(third)):
+            break
+        previous=third; step*=.5
+    return float(third),p1
+
+
+def gate_third(e,conductance,nodes=192,count=64):
+    if not e.get('amplitude',0.):
+        return dict(third=0.,screened_poisson=0.,count_response=[0.,0.])
+    data=_counting_data(e,conductance,nodes,count)
+    third,p1=_exact_third_rate(data)
+    scale=RATE_CONVERSION*conductance*KB**3*1e36
+    screened=_screened_gate_third(e,conductance,nodes,count)['third']
+    return dict(third=third*scale,screened_poisson=screened,
+                count_response=p1.tolist())
