     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Fit the uniform viscosity by Gaussian weighted least squares.
+
+        If ``a_i`` is the value returned by :func:`response`, each measured
+        response is ``a_i / viscosity``.  Thus the inverse viscosity is a
+        one-parameter *linear* weighted regression with no intercept.  This
+        is both the maximum-likelihood estimate for the supplied independent
+        Gaussian errors and avoids an unnecessary nonlinear optimizer.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        try:
+            experiments = [record["input"] for record in records]
+            measured = np.asarray([record["value"] for record in records], dtype=float)
+            sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError("records must contain input, value, and sigma") from exc
+
+        if (not np.isfinite(measured).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values must be finite and sigma positive")
+
+        mobility = predict_at(experiments, 1.0)
+        weights = 1.0 / np.square(sigma)
+        denominator = float(np.dot(weights, np.square(mobility)))
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError("calibration data contain no viscosity information")
+
+        inverse_viscosity = float(np.dot(weights * mobility, measured) / denominator)
+        if not np.isfinite(inverse_viscosity) or inverse_viscosity <= 0:
+            raise ValueError("calibration data imply a non-positive viscosity")
+
+        # The stated apparatus restricts the sole unknown to this interval.
+        self.viscosity = float(np.clip(1.0 / inverse_viscosity, 0.8, 1.6))
+        return self
 
