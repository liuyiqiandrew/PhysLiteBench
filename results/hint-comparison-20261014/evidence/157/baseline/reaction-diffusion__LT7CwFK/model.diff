+    def _binary(self, t, x, initial, diffusivity=None):
+        """Exact semi-discrete Neumann solution for a single cation salt."""
+        d = self.diffusivity if diffusivity is None else float(diffusivity)
+        intervals = len(x) - 1
+        laplace_eigenvalues = (
+            4.0 / (x[1] - x[0]) ** 2
+            * np.sin(np.arange(intervals + 1) * np.pi / (2.0 * intervals)) ** 2
+        )
+        coefficients = dct(initial, type=1, axis=0)
+        # Zero-current A/C and B/C salts have ambipolar diffusivities 4D/3
+        # and 8D/3 respectively.
+        rates = laplace_eigenvalues[:, None] * d * np.array([4.0 / 3.0, 8.0 / 3.0])
+        return idct(
+            np.exp(-t[:, None, None] * rates[None, :, :]) * coefficients[None, :, :],
+            type=1,
+            axis=1,
+        )
+
+    def fit(self, data):
+        """Fit D by weighted Gaussian least squares over calibration records."""
+        try:
+            t = np.asarray(data["t"], dtype=float)
+            x = np.asarray(data["x"], dtype=float)
+            initial = np.asarray(data["initial"], dtype=float)
+            observed = np.asarray(data["concentration"], dtype=float)
+            sigma = np.asarray(data["sigma"], dtype=float)
+        except (KeyError, TypeError) as exc:
+            raise ValueError("data must contain x, t, initial, concentration, and sigma") from exc
+
+        if initial.ndim != 3 or initial.shape[1:] != (len(x), 2):
+            raise ValueError("initial must have shape (records, len(x), 2)")
+        expected = (len(initial), len(t), len(x), 2)
+        if observed.shape != expected or sigma.shape != expected:
+            raise ValueError("concentration and sigma have incompatible shapes")
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("observations must be finite and sigma must be positive")
+        for profile in initial:
+            self._validate_predict_inputs(t, x, profile)
+
+        def objective(log_d):
+            d = float(np.exp(log_d))
+            prediction = []
+            for profile in initial:
+                if np.all(profile[:, 0] == 0.0) or np.all(profile[:, 1] == 0.0):
+                    prediction.append(self._binary(t, x, profile, d))
+                else:
+                    old_d = self.diffusivity
+                    self.diffusivity = d
+                    try:
+                        prediction.append(self.predict(t, x, profile))
+                    finally:
+                        self.diffusivity = old_d
+            residual = (np.asarray(prediction) - observed) / sigma
+            return float(np.sum(residual * residual))
+
+        result = minimize_scalar(
+            objective,
+            bounds=(np.log(1e-14), np.log(1e-5)),
+            method="bounded",
+            options={"xatol": 1e-11},
