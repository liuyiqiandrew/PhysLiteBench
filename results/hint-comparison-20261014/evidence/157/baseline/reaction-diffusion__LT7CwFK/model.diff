+        if np.all(initial[:, 0] == 0.0) or np.all(initial[:, 1] == 0.0):
+            return self._binary(t, x, initial)
+        if t[-1] == 0.0:
+            return np.broadcast_to(initial, (len(t),) + initial.shape).copy()
