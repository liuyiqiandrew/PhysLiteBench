+    @staticmethod
+    def _validate_predict_inputs(t, x, initial):
+        t = np.asarray(t, dtype=float)
+        x = np.asarray(x, dtype=float)
+        initial = np.asarray(initial, dtype=float)
+        if t.ndim != 1 or x.ndim != 1:
+            raise ValueError("t and x must be one-dimensional")
+        if initial.shape != (len(x), 2):
+            raise ValueError("initial must have shape (len(x), 2)")
+        if len(x) < 2 or np.any(~np.isfinite(x)) or np.any(~np.isfinite(t)):
+            raise ValueError("x and t must be finite, with at least two x points")
+        if np.any(np.diff(x) <= 0) or np.any(np.diff(t) < 0):
+            raise ValueError("x must increase and t must be nondecreasing")
+        dx = np.diff(x)
+        if not np.allclose(dx, dx[0], rtol=1e-10, atol=1e-15):
+            raise ValueError("x must be equally spaced")
+        if np.any(t < 0) or np.any(~np.isfinite(initial)) or np.any(initial < 0):
+            raise ValueError("times and initial concentrations must be non-negative")
+        return t, x, initial
