         self.coupling = None
 
     def fit(self,records):
-        raise NotImplementedError('Fit the reference electrostatic coupling.')
+        """Estimate the common reference coupling by weighted least squares.
+
+        The observations have independent, known Gaussian errors, so this is
+        also the maximum-likelihood estimate.  ``disk_radius`` deliberately
+        does not occur in the response: after scaling all coordinates by the
+        disk radius both the partition function and the area derivative only
+        depend on R/a.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        experiments = [record["input"] for record in records]
+        values = np.asarray([record["value"] for record in records], dtype=float)
+        sigmas = np.asarray([record["sigma"] for record in records], dtype=float)
+        if (not np.isfinite(values).all() or not np.isfinite(sigmas).all()
+                or np.any(sigmas <= 0)):
+            raise ValueError("calibration values must be finite and sigma must be positive")
+
+        def objective(g):
+            residual = (predict_at(experiments, g) - values) / sigmas
+            return float(np.dot(residual, residual))
+
+        result = minimize_scalar(
+            objective, bounds=(0.7, 1.4), method="bounded",
+            options={"xatol": 1e-10},
+        )
+        if not result.success or not np.isfinite(result.fun):
+            raise RuntimeError("unable to fit electrostatic coupling")
+        self.coupling = float(result.x)
+        return self
 
     def predict(self,experiments):
+        if self.coupling is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments,self.coupling)
 
 
