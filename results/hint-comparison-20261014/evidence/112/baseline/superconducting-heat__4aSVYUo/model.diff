     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the one apparatus parameter using the stated Gaussian errors.
+
+        The zero-drive calibration supplied with the apparatus happens to be
+        linear in conductance.  It is nevertheless useful to do the bounded
+        one-dimensional likelihood minimisation here: it keeps ``fit``
+        correct for valid calibration records that contain a driven contact,
+        for which the stationary spin accumulation makes the response mildly
+        nonlinear.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("fit requires at least one calibration record")
+
+        try:
+            experiments = [record["input"] for record in records]
+            observed = np.asarray([record["value"] for record in records], dtype=float)
+            sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+        except (KeyError, TypeError, ValueError) as exc:
+            raise ValueError("each calibration record needs input, value, and sigma") from exc
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values must be finite and sigma must be positive")
+
+        def chi_squared(conductance):
+            try:
+                calculated = predict_at(experiments, float(conductance))
+            except (ArithmeticError, FloatingPointError, RuntimeError, ValueError):
+                return np.inf
+            if not np.isfinite(calculated).all():
+                return np.inf
+            residual = (calculated - observed) / sigma
+            return float(residual @ residual)
+
+        result = minimize_scalar(chi_squared, bounds=(20.0, 80.0), method="bounded",
+                                 options={"xatol": 1e-10, "maxiter": 200})
+        if not result.success or not np.isfinite(result.fun):
+            raise RuntimeError("could not fit the contact conductance")
+        self.conductance = float(np.clip(result.x, 20.0, 80.0))
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("call fit before predict")
         return predict_at(experiments, self.conductance)
 
 
