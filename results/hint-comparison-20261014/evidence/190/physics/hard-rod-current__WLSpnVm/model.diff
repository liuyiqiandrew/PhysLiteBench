 import numpy as np
 from scipy.optimize import brentq
 
 
+def _log_cosh(x):
+    """A log(cosh(x)) which remains well behaved for large ``x``."""
+    x = abs(x)
+    return x + math.log1p(math.exp(-2.0 * x)) - math.log(2.0)
+
