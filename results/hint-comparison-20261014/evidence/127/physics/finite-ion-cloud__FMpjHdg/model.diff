+def nodes(order):
+    """Gauss--Legendre nodes and weights on [0, 1]."""
+    x, w = roots_legendre(order)
+    return (x + 1.0) / 2.0, w / 2.0
+
+
+def _pair_angular_factor(gamma, gap):
+    """Angular average of |1-exp(-gap+i theta)|**gamma."""
+    return hyp2f1(-gamma / 2.0, -gamma / 2.0, 1.0, np.exp(-2.0 * gap))
+
+
+def _three_angular_factor(gamma, inner_gap, outer_gap, modes=256):
+    """Coupled three-pair angular average on arrays of radial gaps.
+
+    There are only two independent relative polar angles for three ions. If
+    f_d(theta)=|1-exp(-d+i theta)|**gamma and c_d are its Fourier
+    coefficients, their constrained average is
+
+        sum_n c_inner[n] c_outer[n] c_(inner+outer)[n].
+
+    Thus this retains the triangle constraint instead of multiplying three
+    independent pair averages.
+    """
+    theta = 2.0 * np.pi * np.arange(modes) / modes
+
+    def coefficients(gap):
+        t = np.exp(-np.asarray(gap, dtype=float))[:, None]
+        values = (1.0 - 2.0 * t * np.cos(theta) + t * t) ** (gamma / 2.0)
+        return np.fft.fft(values, axis=1) / modes
+
+    c_inner = coefficients(inner_gap)
+    c_outer = coefficients(outer_gap)
+    c_total = coefficients(np.asarray(inner_gap) + np.asarray(outer_gap))
+    return np.real(np.sum(c_inner * c_outer * c_total, axis=1))
+
+
+@lru_cache(maxsize=None)
+def three_ion_coefficient(gamma, ratio, order=48):
+    """Finite-N integral for three ions with the coupled angular average."""
+    length = np.log(ratio)
+    x, w = nodes(order)
+
+    # Ordered coordinates: inner gap d1, outer gap d2, and innermost x.
+    # Permutations and the common polar angle cancel from d(log Z)/dL.
+    d1 = np.broadcast_to((length * x)[:, None], (order, order)).ravel()
+    d2 = ((length - length * x)[:, None] * x[None, :]).ravel()
+    weights = (length * (length - length * x)[:, None] * w[:, None] * w[None, :]).ravel()
+    angular = _three_angular_factor(gamma, d1, d2)
+
+    span = length - d1 - d2
+    t_slope = 6.0 - 6.0 * gamma
+    radial_weight = weights * angular * np.exp(
+        (4.0 - 3.0 * gamma) * d1 + (2.0 - gamma) * d2
+    )
+    partition = np.dot(radial_weight, span * exprel(t_slope * span))
+    boundary = np.dot(radial_weight, np.exp(t_slope * span))
+    return (1.0 - np.exp(-2.0 * length)) * boundary / (6.0 * partition)
+
