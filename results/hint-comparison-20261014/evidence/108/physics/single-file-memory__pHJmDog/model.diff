 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the long-time covariance coefficient for one experiment.
+
+    In the long-time limit the tagged displacement is determined by the net
+    number of independent Brownian paths which have crossed the tagged
+    particle's initial position.  The crossings made by one path at the two
+    observation times are correlated.  Integrating those same-path and
+    independent-path contributions gives
+
+        sqrt(D / pi) / density *
+            (sqrt(time_a + time_b) - sqrt(abs(time_a - time_b))).
+
+    The expression is symmetric in the two times and agrees with the usual
+    equal-time single-file variance, while it does not impose stationary
+    increments on the tagged trajectory.
+    """
+    d = float(diffusivity)
+    rho = float(density)
+    ta = float(time_a)
+    tb = float(time_b)
+    return np.sqrt(d/np.pi) / rho * (
+        np.sqrt(ta + tb) - np.sqrt(abs(ta - tb))
+    )
 
 
