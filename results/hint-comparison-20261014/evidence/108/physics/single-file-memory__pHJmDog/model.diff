     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Fit the common diffusivity by weighted least squares.
+
+        The covariance is linear in ``sqrt(diffusivity)``, so the one
+        parameter fit can be done directly and without a numerical optimizer.
+        The stated physical range is used as a bound on the fitted value.
+        """
+        design = []
+        values = []
+        weights = []
+
+        for record in records:
+            controls = record["input"]
+            density = float(controls["density"])
+            time_a = float(controls["time_a"])
+            time_b = float(controls["time_b"])
+            design.append(
+                (np.sqrt(time_a + time_b) - np.sqrt(abs(time_a - time_b)))
+                / (density * np.sqrt(np.pi))
+            )
+            values.append(float(record["value"]))
+            sigma = float(record.get("sigma", 0.002))
+            weights.append(1.0 / (sigma * sigma))
+
+        if not design:
+            raise ValueError("At least one calibration record is required.")
+
+        design = np.asarray(design, dtype=float)
+        values = np.asarray(values, dtype=float)
+        weights = np.asarray(weights, dtype=float)
+        if not (np.isfinite(design).all() and np.isfinite(values).all()
+                and np.isfinite(weights).all() and (weights > 0).all()):
+            raise ValueError("Calibration records must contain finite values.")
+
+        sqrt_diffusivity = np.sum(weights * design * values) / np.sum(
+            weights * design * design
+        )
+        sqrt_diffusivity = np.clip(
+            sqrt_diffusivity, np.sqrt(0.8), np.sqrt(1.2)
+        )
+        self.diffusivity = float(sqrt_diffusivity * sqrt_diffusivity)
+        return self
 
     def predict(self, experiments):
+        if self.diffusivity is None:
+            raise RuntimeError("Model must be fitted before prediction.")
         return predict_at(experiments, self.diffusivity)
