 class Model:
     def __init__(self):self.friction=None
     def fit(self,records):
-        raise NotImplementedError("Fit the common friction coefficient from the calibration records.")
+        """Estimate the common friction from the independent calibration data.
+
+        The calibration records are noisy observations of the same prediction
+        function, so use their quoted standard uncertainties as weights.  The
+        parameter is one-dimensional and bounded by the range specified in
+        the problem statement; a small deterministic grid followed by a
+        bracket refinement is sufficient and avoids adding an optimizer
+        dependency to this module.
+        """
+        if not records:
+            raise ValueError("records must contain at least one calibration record")
+
+        experiments=[record['input'] for record in records]
+        observed=np.asarray([record['value'] for record in records],dtype=float)
+        sigma=np.asarray([record['sigma'] for record in records],dtype=float)
+        if (observed.ndim != 1 or sigma.shape != observed.shape or
+                not np.isfinite(observed).all() or
+                not np.isfinite(sigma).all() or np.any(sigma <= 0)):
+            raise ValueError("calibration values and uncertainties must be finite, positive arrays")
+
+        def objective(friction):
+            residual=(coefficients(experiments,float(friction))-observed)/sigma
+            return float(residual@residual)
+
+        # The allowed interval is narrow.  This also makes the fit robust to
+        # a flat/noisy objective without relying on scipy being installed.
+        grid=np.linspace(.7,1.6,91)
+        costs=np.asarray([objective(value) for value in grid])
+        best=int(np.argmin(costs))
+        left=grid[max(0,best-1)]
+        right=grid[min(len(grid)-1,best+1)]
+        if right > left:
+            # Golden-section minimization on the bracket around the best grid
+            # point.  The objective is smooth for all admissible settings.
+            golden=(np.sqrt(5.)-1.)/2.
+            x1=right-golden*(right-left)
+            x2=left+golden*(right-left)
+            f1=objective(x1)
+            f2=objective(x2)
+            for _ in range(60):
+                if f1 > f2:
+                    left=x1
+                    x1=x2
+                    f1=f2
+                    x2=left+golden*(right-left)
+                    f2=objective(x2)
+                else:
+                    right=x2
+                    x2=x1
+                    f2=f1
+                    x1=right-golden*(right-left)
+                    f1=objective(x1)
+            fitted=.5*(left+right)
+        else:
+            fitted=grid[best]
+
+        self.friction=float(np.clip(fitted,.7,1.6))
+        return self
     def predict(self,experiments):return coefficients(experiments,self.friction)
