+def contact_population_correction(first,derivative,q):
+    """Return the order-m correction to the contact populations.
+
+    With u=sqrt(m) v, the order-sqrt(m) x-moment is ``first``.  The
+    order-m zeroth moment therefore obeys q p2 = d_x(first_x).  Its component
+    in the stationary nullspace is an ordinary normalization correction and
+    cancels against the matched background residence; fixing its sum to zero
+    leaves the uniquely relevant, state-dependent part.
+    """
+    count= q.shape[0]
+    matrix=q.copy()
+    matrix[-1]=1.
+    rhs=np.vstack([derivative@first[1,0][s] for s in range(count)])
+    rhs[-1]=0.
+    return np.linalg.solve(matrix,rhs)
+
