+    omega, lam = float(e["angular_speed"]), float(e["relaxation_rate"])
+    eta, flip = float(e["flux_fraction"]), float(e["flip_rate"])
+    variance = max(ta, tb, 0.35)
+    pairs = _indices(degree); local = {pair: i for i, pair in enumerate(pairs)}
