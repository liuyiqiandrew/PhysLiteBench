+    matrix = np.zeros((size, size)); multiply_g = np.zeros_like(matrix)
+    derivative_g = np.zeros_like(matrix); square_g = np.zeros_like(matrix)
+
+    def put(array, row, col, value):
+        array[row, col] += value
+
+    for state, sign in enumerate((-1.0, 1.0)):
