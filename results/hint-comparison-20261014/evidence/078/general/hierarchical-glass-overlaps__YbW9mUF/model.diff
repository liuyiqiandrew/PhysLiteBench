     def fit(self, records):
-        raise NotImplementedError('Fit width from the calibration records.')
+        """Fit ``width`` by the Gaussian-error maximum likelihood estimate.
+
+        In the whole calibration temperature range both levels are in their
+        high-temperature phase, so the limiting energy density is
+        ``-beta * width**2``.  The errors have the supplied, potentially
+        different, standard deviations; consequently this is a weighted
+        least-squares fit of ``width**2``.
+        """
+        numerator = 0.0
+        denominator = 0.0
+        count = 0
+        for row in records:
+            try:
+                beta = float(row['input']['beta'])
+                observed = float(row['value'])
+                sigma = float(row['sigma'])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError('Calibration records need finite beta, value, and sigma fields.') from exc
+            if (not math.isfinite(beta) or not .2 <= beta <= .6
+                    or not math.isfinite(observed) or not math.isfinite(sigma)
+                    or sigma <= 0.0):
+                raise ValueError('Invalid calibration record.')
+            weight = 1.0 / (sigma * sigma)
+            numerator -= weight * beta * observed
+            denominator += weight * beta * beta
+            count += 1
+        if not count:
+            raise ValueError('At least one calibration record is required.')
+
+        # The likelihood is quadratic in theta = width**2.  Projecting the
+        # unconstrained optimum onto its allowed interval gives its constrained
+        # optimum without introducing a numerical optimizer or rounding noise.
+        theta = numerator / denominator
+        theta = min(WIDTH_INTERVAL[1] ** 2, max(WIDTH_INTERVAL[0] ** 2, theta))
+        self.width = math.sqrt(theta)
+        return self
 
