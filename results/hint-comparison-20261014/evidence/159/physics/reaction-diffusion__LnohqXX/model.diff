+    """Return (free A, free B, free C, bound P) at local equilibrium.
+
+    The two entries in ``total`` are the conserved A and B constituent
+    concentrations.  Solving for P is preferable to integrating a reaction
+    rate here: the transport model is the infinite reaction-rate limit.
+    """
+    values = np.asarray(total, dtype=float)
+    if values.shape == (2,):
+        values = values[None, :]
+        scalar = True
+    else:
+        if values.ndim < 1 or values.shape[-1] != 2:
+            raise ValueError("total must have a final dimension of length 2")
+        scalar = False
+
+    a = values[..., 0]
+    b = values[..., 1]
+    bound = np.zeros_like(a)
+    upper = np.minimum(a, b)
+    for _ in range(48):
+        free_a = a - bound
+        free_b = b - bound
+        free_c = free_a + free_b
+        residual = bound - ASSOCIATION * free_a * free_b * free_c**2
+        derivative = 1.0 + ASSOCIATION * (
+            free_c**3 + 4.0 * free_a * free_b * free_c
+        )
+        change = residual / derivative
+        bound = np.clip(bound - change, 0.0, upper)
+        if np.max(np.abs(change), initial=0.0) < 1e-13:
