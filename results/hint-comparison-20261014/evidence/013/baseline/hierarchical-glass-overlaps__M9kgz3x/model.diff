     def fit(self, records):
-        raise NotImplementedError('Fit width from the calibration records.')
+        """Fit the material scale by the calibration likelihood.
+
+        Every allowed calibration temperature is below the first freezing
+        temperature, even at the largest allowed width.  In that regime the
+        two Gaussian increments simply add, and the limiting energy density
+        is ``-beta * width**2``.  Thus this is a one-parameter weighted linear
+        regression in ``width**2``.
+        """
+        numerator = 0.0
+        denominator = 0.0
+        count = 0
+        for row in records:
+            try:
+                beta = float(row['input']['beta'])
+                measured = float(row['value'])
+                sigma = float(row['sigma'])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError('Calibration records need beta, value, and sigma.') from exc
+            if (not math.isfinite(beta) or not .2 <= beta <= .6
+                    or not math.isfinite(measured)
+                    or not math.isfinite(sigma) or sigma <= 0.0):
+                raise ValueError('Invalid calibration record.')
+            weight = 1.0 / (sigma * sigma)
+            numerator -= weight * beta * measured
+            denominator += weight * beta * beta
+            count += 1
+
+        if count == 0 or not math.isfinite(numerator) or not math.isfinite(denominator):
+            raise ValueError('At least one finite calibration record is required.')
+
+        # The parameter is constrained by the material specification.  The
+        # constrained quadratic optimum is the clipped unconstrained optimum.
+        squared_width = min(WIDTH_INTERVAL[1] ** 2,
+                            max(WIDTH_INTERVAL[0] ** 2, numerator / denominator))
+        self.width = math.sqrt(squared_width)
+        return self
 
