         self.conductance = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the (normal-state) contact conductance in microSiemens.
+
+        The calibration errors are independent Gaussian errors in pW, so the
+        natural objective is the weighted least-squares residual.  The
+        conductance is the only fitted parameter; all spin and oscillator
+        variables are internal states calculated by :func:`predict_at`.
+        """
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+
+        inputs = [record['input'] for record in records]
+        observations = np.asarray([record['value'] for record in records], dtype=float)
+        uncertainties = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.all(np.isfinite(observations)) or
+                not np.all(np.isfinite(uncertainties)) or np.any(uncertainties <= 0)):
+            raise ValueError('Calibration values and uncertainties must be finite; sigma must be positive.')
+
+        def residual(value):
+            prediction = predict_at(inputs, float(value[0]))
+            return (prediction - observations) / uncertainties
+
+        # Keep the fit inside the apparatus range.  In the unmodulated case
+        # (the supplied calibration) the model is linear in conductance; using
+        # the closed form first gives an excellent starting point and avoids
+        # unnecessary repeated quadrature.
+        trial = predict_at(inputs, 1.0)
+        weighted_denominator = np.sum((trial / uncertainties) ** 2)
+        if weighted_denominator > 0:
+            start = np.sum(trial * observations / uncertainties**2) / weighted_denominator
+        else:
+            start = 45.0
+        start = float(np.clip(start, 20.0, 80.0))
+        result = least_squares(residual, [start], bounds=([20.0], [80.0]),
+                               xtol=1e-12, ftol=1e-12, gtol=1e-12,
+                               max_nfev=80)
+        self.conductance = float(result.x[0])
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.conductance)
