     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Infer the common viscosity using the stated Gaussian uncertainties.
+
+        With ``q_i`` denoting the response from :func:`response`, the model
+        is ``value_i = q_i / viscosity + noise``. It is linear in inverse
+        viscosity, so its weighted least-squares maximum-likelihood estimate
+        has a closed form. The known viscosity interval is imposed as a bound
+        on that estimate.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        amplitudes = np.empty(len(records), dtype=float)
+        values = np.empty(len(records), dtype=float)
+        sigmas = np.empty(len(records), dtype=float)
+        for index, record in enumerate(records):
+            try:
+                amplitudes[index] = response(*_parameters(record["input"]))
+                values[index] = float(record["value"])
+                sigmas[index] = float(record["sigma"])
+            except (KeyError, TypeError, ValueError) as exc:
+                raise ValueError(
+                    "each calibration record needs input, value, and sigma"
+                ) from exc
+
+        if (not np.isfinite(amplitudes).all() or not np.isfinite(values).all()
+                or not np.isfinite(sigmas).all() or np.any(sigmas <= 0.0)):
+            raise ValueError("calibration values must be finite and sigma must be positive")
+
+        weights = 1.0 / sigmas**2
+        denominator = np.dot(weights, amplitudes**2)
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError("calibration records contain no viscosity information")
+
+        inverse_viscosity = np.dot(weights * amplitudes, values) / denominator
+        # viscosity in [0.8, 1.6] means inverse viscosity in [1/1.6, 1/0.8].
+        inverse_viscosity = np.clip(inverse_viscosity, 1.0 / 1.6, 1.0 / 0.8)
+        self.viscosity = float(1.0 / inverse_viscosity)
+        return self
 
