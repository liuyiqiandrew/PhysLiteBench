+@lru_cache(maxsize=None)
+def pair_fourier_coefficients(gamma, gap, modes=128):
+    """Fourier coefficients of one normalized pair-distance factor.
+
+    The direct hypergeometric expression is well behaved except very close to
+    a zero radial gap, where the three-term recurrence is more stable.  Only
+    the first 128 modes are needed: the angular result contains a product of
+    three coefficients, so its omitted tail is rapidly convergent even at
+    the smallest allowed coupling.
+    """
+    p = gamma/2
+    q = np.exp(-gap)
+    k = np.arange(modes + 1)
+
+    # For integral p the pair factor is a finite Laurent polynomial.  This
+    # also avoids 0*inf in the hypergeometric representation.
+    if p.is_integer():
+        degree = int(p)
+        coefficients = np.zeros(modes + 1)
+        expansion = np.asarray([comb(degree, j)*(-q)**j
+                                for j in range(degree + 1)])
+        for n in range(min(degree, modes) + 1):
+            coefficients[n] = np.dot(expansion[n:], expansion[:degree + 1 - n])
+        return coefficients
+
+    if gap < 0.02:
+        coefficients = np.empty(modes + 1)
+        coefficients[0] = hyp2f1(-p, -p, 1, q*q)
+        coefficients[1] = -p*q*hyp2f1(1-p, -p, 2, q*q)
+        for n in range(2, modes + 1):
+            coefficients[n] = ((1 + q*q)*(n-1)*coefficients[n-1]
+                               + q*(p-n+2)*coefficients[n-2]) / (q*(n+p))
+        return coefficients
+
+    # c_n = q^n (-p)_n/n! * 2F1(n-p,-p;n+1;q^2).
+    coefficients = (q**k * poch(-p, k) * np.exp(-gammaln(k + 1))
+                    * hyp2f1(k-p, -p, k+1, q*q))
+    coefficients[~np.isfinite(coefficients)] = 0.0
+    return coefficients
