+    @staticmethod
+    def _binary_with_diffusivity(t, x, initial, diffusivity):
+        """Exact point-grid Neumann solution for a one-cation preparation."""
+        count = len(x) - 1
+        if count < 1:
+            raise ValueError("x must contain at least two mesh points")
+        dx = x[1] - x[0]
+        modes = np.arange(count + 1)
+        eigenvalues = 4.0 / dx**2 * np.sin(modes * np.pi / (2.0 * count)) ** 2
+        coefficients = dct(initial, type=1, axis=0)
+        effective = diffusivity * np.array([4.0 / 3.0, 8.0 / 3.0])
+        decay = np.exp(
+            -t[:, None, None] * eigenvalues[:, None] * effective[None, :]
+        )
+        return idct(decay * coefficients[None, :, :], type=1, axis=1)
+
