     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the one (linear) normal-state conductance parameter.
+
+        A record is deliberately fitted through the public prediction path:
+        although the supplied calibration data are the simple, static setup,
+        this also makes ``fit`` do the right thing for a valid custom
+        calibration set containing any of the documented readouts.
+        """
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        # The static calibration response is exactly linear in conductance.
+        # Use a bounded scalar weighted least-squares solve in general, since
+        # driven spin accumulation makes the response mildly nonlinear.
+        from scipy.optimize import minimize_scalar
+
+        inputs = [r['input'] for r in records]
+        values = np.asarray([r['value'] for r in records], dtype=float)
+        sigma = np.asarray([r['sigma'] for r in records], dtype=float)
+        if (not np.isfinite(values).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values and sigmas must be finite; sigma must be positive")
+
+        # Avoid hundreds of expensive stationary solves for the overwhelmingly
+        # common unmodulated calibration data.
+        simple = all((r.get('statistic', 'mean') == 'mean'
+                      and r.get('amplitude', 0.) == 0.
+                      and r.get('oscillator_coupling', 0.) == 0.
+                      and r.get('secondary_coupling', 0.) == 0.
+                      and r.get('quadratic_coupling', 0.) == 0.
+                      and r.get('momentum_coupling', 0.) == 0.) for r in inputs)
+        if simple:
+            unit = r4_predict_at(inputs, 1.)
+            estimate = float(np.sum(unit * values / sigma**2) /
+                             np.sum(unit**2 / sigma**2))
+            self.conductance = float(np.clip(estimate, 20., 80.))
+        else:
+            def objective(conductance):
+                residual = (predict_at(inputs, conductance) - values) / sigma
+                return float(residual @ residual)
+            self.conductance = float(minimize_scalar(
+                objective, bounds=(20., 80.), method='bounded',
+                options={'xatol': 1e-8}).x)
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError("fit must be called before predict")
         return predict_at(experiments, self.conductance)
 
 
