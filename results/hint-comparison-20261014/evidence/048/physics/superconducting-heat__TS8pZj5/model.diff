+def gate_third(e, conductance, nodes=192, count=64):
+    """Third stationary gate-work cumulant including spin-rate feedback.
+
+    The leading large-island SCGF is the fixed point of the tilted jump
+    generator.  Differentiating its envelope once gives h'(k); a symmetric,
+    Richardson-refined derivative of that quantity gives h'''(0).  Unlike
+    screened marks, the saddle retains the first and second changes of every
+    conditional tunnel and flip intensity with spin state.
+    """
+    if e.get('amplitude', 0.) == 0.:
+        return dict(third=0., screened_poisson=0., count_response=[0., 0.])
+    origin, _, g0 = _gate_counting_saddle(e, conductance, 0., nodes=nodes, count=count)
+
+    def curvature(step):
+        # Continuation from the unbiased saddle picks the physical branch.
+        zp, _, gp = _gate_counting_saddle(e, conductance, step, origin, nodes, count)
+        zm, _, gm = _gate_counting_saddle(e, conductance, -step, origin, nodes, count)
+        _, _, gp2 = _gate_counting_saddle(e, conductance, 2*step, zp, nodes, count)
+        _, _, gm2 = _gate_counting_saddle(e, conductance, -2*step, zm, nodes, count)
+        value = (-gp2 + 16*gp - 30*g0 + 16*gm - gm2)/(12*step**2)
+        return value, (zp[2:]-zm[2:])/(2*step)
+
+    coarse, _ = curvature(1.e-2)
+    fine, response = curvature(5.e-3)
+    raw = (16*fine-coarse)/15.
+    scale = RATE_CONVERSION*conductance*KB**3*1e36
+    return dict(third=float(raw*scale), screened_poisson=float(raw*scale),
+                count_response=response.tolist())
+
+
