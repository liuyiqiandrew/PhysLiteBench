+def _gate_counting_saddle(e, conductance, k, initial=None, nodes=192, count=64):
+    """Return the macroscopic tilted-generator saddle for gate work.
+
+    ``k`` counts work in kelvin.  The two canonical momenta count the actual
+    integer spin changes.  This is important: spin flips and tunnel events
+    are separate jump processes, rather than a Gaussian spin-noise surrogate.
+    """
+    args = oscillator_arguments(e)
+    kw = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+              quadratic_coupling=e.get('quadratic_coupling', 0.),
+              momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kw)
+    left, right = args[:2]
+    dl, dr, ch = prepare(*args, nodes=nodes, count=count,
+                         window=state['search_bound'], **kw)
+    energy, other, measure, sl, sr, pair, work, recoil, pf, pb, injection = ch
+    ratio = QUASIPARTICLE_DENSITY/(NORMAL_POLARIZATION_TIME*RATE_CONVERSION*conductance)
+
+    # The numerical flip quadrature is used only for the symmetric rate.  Its
+    # antisymmetric part is set by spin_loss exactly, so q=0 has precisely the
+    # same stationary balance as the mean calculation.
+    x, qw = leggauss(192)
+    flip_grids = []
+    for temp, delta in zip((left, right), (dl, dr)):
+        upper = delta + 80.*temp + 8.*state['search_bound']
+        ee = delta + (x+1.)*(upper-delta)/2.
+        ww = qw*(upper-delta)/2.
+        flip_grids.append((ee, ww, temp, delta))
+
+    def rates(mu, derivatives=False):
+        f = expit((sl*mu[0]-energy)/left)
+        g = expit((sr*mu[1]-other)/right)
+        df, dg = f*(1-f)/left, g*(1-g)/right
+        rp = measure*np.where(pair, pf*(1-f)*(1-g), pf*f*(1-g))
+        rm = measure*np.where(pair, pb*f*g, pb*g*(1-f))
+        rr = np.concatenate((rp.ravel(), rm.ravel()))
+        # Repeat a channel's spin change and mark for every energy quadrature
+        # node.  ravel() is C ordered, hence repeat rather than tile here.
+        nodes_per_channel = energy.shape[1]
+        inc = np.concatenate((np.repeat(injection, nodes_per_channel, axis=0),
+                              -np.repeat(injection, nodes_per_channel, axis=0)), axis=0)
+        mark = np.concatenate((np.repeat(work, nodes_per_channel),
+                               -np.repeat(work, nodes_per_channel)))
+        if derivatives:
+            drp_l = measure*np.where(pair, -pf*sl*df*(1-g), pf*sl*df*(1-g))
+            drp_r = -measure*pf*sr*dg*np.where(pair, 1-f, f)
+            drm_l = measure*np.where(pair, pb*sl*df*g, -pb*sl*df*g)
+            drm_r = measure*pb*sr*dg*np.where(pair, f, 1-f)
+            derivative = np.vstack((np.column_stack((drp_l.ravel(), drp_r.ravel())),
+                                    np.column_stack((drm_l.ravel(), drm_r.ravel()))))
+        else:
+            derivative = None
+
+        # Add individual up->down and down->up lattice jumps.  The DOS and
+        # coherence-factor cancellation makes their energy measure dE.
+        for j, (ee, ww, temp, delta) in enumerate(flip_grids):
+            u = expit((mu[j]-ee)/temp)
+            d = expit((-mu[j]-ee)/temp)
+            du, ddmag = u*(1-u)/temp, d*(1-d)/temp
+            total = float(ww @ (u*(1-d) + d*(1-u)))
+            dtotal = float(ww @ (du*(1-2*d) + ddmag*(2*u-1)))
+            loss, dloss = spin_loss(temp, delta, mu[j])
+            # A is the up->down integral and B the reverse integral.
+            a, b = (total+loss)/2., (total-loss)/2.
+            da, db = (dtotal+dloss)/2., (dtotal-dloss)/2.
+            unit = np.zeros(2); unit[j] = 2.
+            inc = np.vstack((inc, -unit, unit))
+            mark = np.concatenate((mark, (0., 0.)))
+            rr = np.concatenate((rr, (ratio*a/2., ratio*b/2.)))
+            if derivatives:
+                extra = np.zeros((2,2)); extra[:,j] = (ratio*da/2., ratio*db/2.)
+                derivative = np.vstack((derivative, extra))
+        return rr, inc, mark, derivative
+
+    def equations(z):
+        mu, q = z[:2], z[2:]
+        rr, inc, mark, derivative = rates(mu, derivatives=True)
+        exponent = inc @ q + k*mark
+        # The domains in the README make these exponents small around zero;
+        # clipping is solely a guard for unsuccessful trial steps in the
+        # nonlinear solver.
+        ek = np.exp(np.clip(exponent, -600., 600.))
+        fq = (rr*ek) @ inc
+        fmu = derivative.T @ (ek-1.)
+        return np.concatenate((fq, fmu))
+
+    start = np.r_[state['mu'], np.zeros(2)] if initial is None else np.asarray(initial, float)
+    # Scale residuals by their natural event rate.  This lets the same tight
+    # termination criteria work in both drive bands.
+    base_rates = rates(start[:2])[0]
+    scale = max(1., float(np.sum(abs(base_rates))))
+    answer = least_squares(lambda z: equations(z)/scale, start,
+                           xtol=3e-13, ftol=3e-13, gtol=3e-13,
+                           max_nfev=250, x_scale='jac')
+    if not answer.success or np.max(abs(equations(answer.x)/scale)) > 2e-8:
+        raise RuntimeError('tilted spin-counting saddle did not converge')
+    rr, inc, mark, _ = rates(answer.x[:2])
+    exponent = inc @ answer.x[2:] + k*mark
+    ek = np.exp(np.clip(exponent, -600., 600.))
+    # h is the SCGF in the unscaled, dimensionless rate convention used by
+    # transition().  hprime is supplied by the envelope theorem.
+    return answer.x, float(np.sum(rr*(ek-1.))), float(np.sum(rr*mark*ek))
+
