+@lru_cache(4)
+def mixed_operator(nx=X_MODES, ny=Y_MODES):
+    """The Bx*By part of the magnetic damping operator.
+
+    A convenient way of obtaining the induced current is to introduce its
+    stream function.  If ``u`` is expanded in the sine basis, the source for
+    that stream function is ``Bx*u_x + By*u_y``.  The two diagonal pieces of
+    the resulting quadratic form are assembled in :func:`operators`; this
+    routine assembles its symmetric mixed piece.
+
+    Only stream-function modes that can couple two retained velocity modes
+    are needed here.  The diagonal pieces intentionally retain the original
+    (larger) electric-mode truncation used by ``operators``.
+    """
+    m, n, *_ = operators(nx, ny)
+    dm = derivative_overlap(m, m) / WIDTH
+    dn = derivative_overlap(n, n) / HEIGHT
+
+    # Lx.T K^-1 Ly.  For velocity modes i=(m_i,n_i) and
+    # j=(m_j,n_j), the common stream mode is (m_j,n_i).
+    k2 = (m[None, :] * np.pi / WIDTH) ** 2 + (n[:, None] * np.pi / HEIGHT) ** 2
+    one_cross = dm.T * dn / k2
+    return one_cross + one_cross.T
+
