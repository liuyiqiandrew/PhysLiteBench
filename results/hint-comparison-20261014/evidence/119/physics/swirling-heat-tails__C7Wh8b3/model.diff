     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        # I_i = mobility * response(input_i), with independently reported
+        # Gaussian standard deviations.  The weighted least-squares estimate
+        # is the maximum-likelihood estimate for the common mobility.
+        design = np.asarray([response(record['input']) for record in records],
+                            dtype=float)
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        weights = 1.0 / np.square(sigma)
+        estimate = np.sum(weights * design * values) / np.sum(weights * design * design)
+
+        # The apparatus specification supplies a physical admissible range.
+        self.mobility = float(np.clip(estimate, 0.8, 1.3))
+        return self
 
     def predict(self, experiments):
