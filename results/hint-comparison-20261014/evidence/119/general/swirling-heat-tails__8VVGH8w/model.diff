 def response(e):
-    r, z = e['drive_ratio'], e['relative_heat']
-    q = 2*r*r*z
-    rate = np.sqrt((1+r*r)*(q*q+4*r*r)/(4*r*r))-q/2-1
-    return e['stiffness']*rate
+    """Rate function per unit mobility for one preparation.
+
+    With time measured in units of ``mobility * stiffness``, the heat
+    SCGF is ``1 - sqrt(1 + 4*r**2*s*(1-s))``.  The unconditioned endpoint
+    energies restrict its domain.  Consequently its Legendre transform has
+    linear tails; these would be missed by treating heat as circulation work
+    alone.  The central branch is rationalized to avoid subtracting nearly
+    equal numbers at z=1, where the rate must be exactly zero.
+    """
+    r = float(e['drive_ratio'])
+    z = float(e['relative_heat'])
+    r2 = r * r
+
+    left = np.sqrt((1.0 + r2) * (1.0 + r2 * z * z))
+    right = 1.0 + r2 * z
+    # (left - right) = r^2 (z - 1)^2 / (left + right).
+    rate = r2 * (z - 1.0) ** 2 / (left + right)
+
+    # The final-position integral limits the SCGF to lambda < 1.
+    if z < -1.0:
+        rate = -2.0 * r2 * z
+    # At weak drive the initial-position integral gives a second finite
+    # boundary, lambda=(r^2-1)/(r^2+1), and hence a positive linear tail.
+    if r2 < 1.0 / 3.0:
+        positive_tail_start = (3.0 - r2) / (1.0 - 3.0 * r2)
+        if z > positive_tail_start:
+            rate = 2.0 * r2 * ((1.0 - r2) * z - 2.0) / (1.0 + r2)
+    return float(e['stiffness']) * rate
 
 
