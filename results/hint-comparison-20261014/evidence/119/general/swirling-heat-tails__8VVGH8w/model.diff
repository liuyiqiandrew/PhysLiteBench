     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        """Fit the common mobility by the Gaussian maximum likelihood fit."""
+        basis = np.asarray([response(record['input']) for record in records],
+                           dtype=float)
+        values = np.asarray([record['value'] for record in records],
+                            dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records],
+                           dtype=float)
+
+        # I_i = mobility * basis_i, with independently known uncertainties.
+        weights = 1.0 / np.square(sigma)
+        denominator = np.dot(weights * basis, basis)
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError('Calibration data contain no finite mobility information.')
+        estimate = np.dot(weights * basis, values) / denominator
+
+        # The apparatus specifies this physical range for the shared mobility.
+        self.mobility = float(np.clip(estimate, 0.8, 1.3))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.mobility)
