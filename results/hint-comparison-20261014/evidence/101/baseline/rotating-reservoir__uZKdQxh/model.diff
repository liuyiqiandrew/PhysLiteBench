+    """Maximum-likelihood estimate of the common laboratory drag.
+
+    The calibration preparation has a constant collision clock and no flow,
+    for which the stationary heat current has the closed form in
+    :func:`calibration_mean`.  Fitting that expression directly also keeps
+    this routine well defined should a future calibration use several
+    relaxation rates.
+    """
+    if not records:
+        raise ValueError('at least one calibration record is required')
+
+    def objective(drag):
+        return sum(((calibration_mean(r['input'], drag)-float(r['value'])) /
+                    float(r['sigma']))**2 for r in records)
+
+    estimate=minimize_scalar(objective, bounds=(.4,1.1), method='bounded',
+                              options={'xatol':1.e-13})
+    if not estimate.success or not np.isfinite(estimate.fun):
+        raise ValueError('could not fit the laboratory drag')
+    return float(estimate.x)
 
 
