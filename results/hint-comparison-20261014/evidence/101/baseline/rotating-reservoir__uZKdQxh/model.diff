+def gated_readout(angular_speed, flip_rate, temperature_a, temperature_b,
+                 flux_fraction, relaxation_rate, statistic, contrast,
+                 harmonic, drag):
+    """Readout in the stipulated rapidly mixed detector-phase limit.
+
+    The phase average leaves the first tilted-generator derivative unchanged
+    (E[w]=1).  It only changes the instantaneous Brownian quadratic
+    variation, by E[w**2] = 1 + contrast**2/2.  The rotor/contact generator
+    itself is exactly the same one used for an ungated experiment, including
+    both motor states and their switching rate.
+    """
+    if statistic not in ('mean', 'noise', 'third_cumulant'):
+        raise ValueError('unknown calorimeter statistic')
+    if angular_speed != 0.:
+        raise ValueError('Angularly gated preparations require zero flow target.')
+    if harmonic not in (1, 2, 3):
+        raise ValueError('detector_harmonic must be 1, 2, or 3')
+    e=dict(zip(FIELDS, (angular_speed, flip_rate, temperature_a,
+                        temperature_b, flux_fraction, relaxation_rate)))
+    return float(kinetic_statistics(
+        e, drag, bath_noise_factor=1. + contrast*contrast/2.)[statistic])
