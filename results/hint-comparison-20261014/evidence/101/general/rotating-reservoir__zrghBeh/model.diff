+def angular_hermite(e,gamma=.67,degree=34):
+    """Cumulants for the supplied rapidly-mixed detector-phase limit.
+
+    In that limit the detector phase is independent on the time scale on
+    which the velocity state evolves.  Thus ``w`` averages to one in the
+    drift/correlation operator and ``w**2`` averages to
+    ``1 + contrast**2 / 2`` in the quadratic (shared-Wiener) operator.  The
+    calculation below is the usual tilted-generator calculation with those
+    two averaged operators.  Keeping it in this form also makes the
+    contrast=0 result exactly the ungated calculation (up to truncation).
+    """
+    L,_,A1,A2,p,constant=hermite_operators(e,gamma,degree)
+    # Tilted-generator derivatives for exp(-k Y).  Only its second
+    # derivative changes under rapid phase mixing.
+    A2=(1.0 + e.get('detector_contrast',0.)**2/2.0)*A2
+    lam1=float(p@A1@constant)
+    system=L.copy()
+    system[0]=p
+
+    rhs=lam1*constant-A1@constant
+    rhs[0]=0.
+    r1=solve(system,rhs,check_finite=False)
+    lam2=float(p@(A2@constant+2*A1@r1))
+
+    rhs=lam2*constant+2*lam1*r1-2*A1@r1-A2@constant
+    rhs[0]=0.
+    r2=solve(system,rhs,check_finite=False)
+    lam3=float(3*p@(A1@r2+A2@r1))
+    return dict(mean=-lam1,noise=lam2,third_cumulant=-lam3)
 
 
