+        """Fit the common drag by the Gaussian weighted calibration MLE."""
+        if not records:
+            raise ValueError('at least one calibration record is required')
+        # For the calibration preparation the exact stationary heat current
+        # is C(Ta-Tb); estimating C is consequently a one-parameter weighted
+        # linear regression.  Inverting its analytic relation to drag is
+        # both more accurate and much faster than fitting a truncated basis.
+        lam=float(records[0]['input']['relaxation_rate'])
+        if lam <= 0 or any(float(r['input']['relaxation_rate']) != lam for r in records):
+            raise ValueError('calibration records must share a positive relaxation_rate')
+        x=np.asarray([(float(r['input']['temperature_a'])-float(r['input']['temperature_b'])) / float(r['sigma'])
+                      for r in records])
+        y=np.asarray([float(r['value']) / float(r['sigma']) for r in records])
+        denom=float(x@x)
+        if denom == 0:
+            raise ValueError('calibration temperatures do not identify drag')
+        conductance=float(x@y/denom)
+        inverse_denom=lam*RATE-conductance*(2*lam+RATE)
+        if inverse_denom <= 0:
+            # The specified experiment range cannot produce this for a
+            # physical calibration.  Clipping remains preferable to exposing
+            # an unusable model when records have been rounded aggressively.
+            self.drag=1.1
+        else:
+            self.drag=float(np.clip(conductance*lam*RATE/inverse_denom,.4,1.1))
+        return self
+
+    def predict(self,experiments):
+        if self.drag is None:
+            raise RuntimeError('fit must be called before predict')
+        return predict_at(experiments,self.drag)
