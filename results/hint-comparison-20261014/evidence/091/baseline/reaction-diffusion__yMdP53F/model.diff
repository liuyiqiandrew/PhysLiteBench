+    def correlate(self, t, totals, harmonic=1):
+        """Normalized two-time A/B covariance for one cosine mode."""
+        if self.diffusivity is None or not np.isfinite(self.diffusivity) or self.diffusivity <= 0:
+            raise RuntimeError("fit must be called before correlate")
+        times, totals = np.asarray(t, dtype=float), np.asarray(totals, dtype=float)
+        if times.ndim != 1 or len(times) == 0 or not np.all(np.isfinite(times)):
+            raise ValueError("t must be a nonempty finite one-dimensional array")
+        if np.any(times < 0) or np.any(np.diff(times) < 0) or times[-1] > 600:
+            raise ValueError("t must be increasing, nonnegative, and no greater than 600 s")
+        if totals.shape != (2,) or not np.all(np.isfinite(totals)) or np.any(totals <= 0):
+            raise ValueError("totals must contain two positive finite concentrations")
+        if int(harmonic) != harmonic or not 1 <= int(harmonic) <= 8:
+            raise ValueError("harmonic must be an integer from 1 through 8")
+
+        susceptibility, mobility = fluctuation_matrices(totals, self.diffusivity)
+        rate = (int(harmonic) * np.pi / CELL_LENGTH) ** 2
+        relaxation = rate * np.linalg.solve(susceptibility.T, mobility.T).T
+        # The required detector convention specifies independent ideal total
+        # constituent fluctuations at equal time.
+        equal_time = np.diag(totals)
+        return np.array([expm(-lag * relaxation) @ equal_time for lag in times])
