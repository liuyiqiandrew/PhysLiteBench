+    @staticmethod
+    def _validate_grid(t, x, initial):
+        t = np.asarray(t, dtype=float)
+        x = np.asarray(x, dtype=float)
+        initial = np.asarray(initial, dtype=float)
+        if t.ndim != 1 or len(t) == 0 or not np.all(np.isfinite(t)):
+            raise ValueError("t must be a nonempty finite one-dimensional array")
+        if np.any(t < 0.0) or np.any(np.diff(t) < 0.0):
+            raise ValueError("t must be increasing and nonnegative")
+        if x.ndim != 1 or len(x) < 2 or np.any(np.diff(x) <= 0.0):
+            raise ValueError("x must be an increasing mesh with at least two points")
+        if not np.allclose(np.diff(x), x[1] - x[0], rtol=1e-10, atol=1e-14):
+            raise ValueError("x must be equally spaced")
+        if initial.shape != (len(x), 2) or not np.all(np.isfinite(initial)):
+            raise ValueError("initial must have shape (len(x), 2) and be finite")
+        return t, x, initial
+
+    @staticmethod
+    def _binary_with_diffusivity(t, x, initial, diffusivity):
+        """Finite-volume Neumann solution for a cluster-free binary salt."""
+        segments = len(x) - 1
+        dx = x[1] - x[0]
+        eig = 4.0 / dx**2 * np.sin(np.arange(segments + 1) * np.pi / (2.0 * segments)) ** 2
+        modes = dct(initial, type=1, axis=0)
+        ambipolar = diffusivity * np.array((4.0 / 3.0, 8.0 / 3.0))
+        decay = np.exp(-t[:, None, None] * eig[None, :, None] * ambipolar[None, None, :])
+        return idct(decay * modes[None, :, :], type=1, axis=1)
+
+    def _binary(self, t, x, initial):
+        return self._binary_with_diffusivity(t, x, initial, self.diffusivity)
+
+    def fit(self, data):
+        """Fit positive D by Gaussian weighted least squares."""
+        try:
+            t = np.asarray(data["t"], dtype=float)
+            x = np.asarray(data["x"], dtype=float)
+            initials = np.asarray(data["initial"], dtype=float)
+            observed = np.asarray(data["concentration"], dtype=float)
+            sigma = np.asarray(data["sigma"], dtype=float)
+        except (KeyError, TypeError) as exc:
+            raise ValueError("data needs x, t, initial, concentration, and sigma") from exc
+        if initials.ndim != 3 or initials.shape[1:] != (len(x), 2):
+            raise ValueError("initial must have shape (runs, len(x), 2)")
+        wanted = (len(initials), len(t), len(x), 2)
+        if observed.shape != wanted or sigma.shape != wanted or not np.all(np.isfinite(sigma)) or np.any(sigma <= 0):
+            raise ValueError("concentration and positive sigma must match the calibration shape")
+        self._validate_grid(t, x, initials[0])
+
+        def loss(log_d):
+            d = float(np.exp(log_d))
+            predicted = np.array([self._binary_with_diffusivity(t, x, start, d) for start in initials])
+            residual = (predicted - observed) / sigma
+            return float(np.sum(residual * residual))
+
+        result = minimize_scalar(
+            loss,
+            bounds=(np.log(1e-15), np.log(1e-5)),
+            method="bounded",
+            options={"xatol": 1e-12},
+        )
+        if not result.success or not np.isfinite(result.fun):
+            raise RuntimeError("unable to fit the diffusion coefficient")
+        self.diffusivity = float(np.exp(result.x))
+        return self
+
+    def predict(self, t, x, initial):
+        """Return total A/B profiles with shape ``(len(t), len(x), 2)``."""
+        if self.diffusivity is None or not np.isfinite(self.diffusivity) or self.diffusivity <= 0:
+            raise RuntimeError("fit must be called before predict")
+        t, x, initial = self._validate_grid(t, x, initial)
+        # No B (or A) means no P, so the ambipolar solution is exact.
+        if np.all(initial[:, 0] == 0.0) or np.all(initial[:, 1] == 0.0):
+            return self._binary(t, x, initial)
+        if t[-1] == 0.0:
+            return np.broadcast_to(initial, (len(t),) + initial.shape).copy()
+
+        points, dx = len(x), x[1] - x[0]
+        volume = np.full(points, dx)
+        volume[[0, -1]] *= 0.5
+        da, db, dc = self.diffusivity * np.array((1.0, 4.0, 2.0))
+
+        def rhs(_time, flat):
+            species = equilibrium(flat.reshape(points, 2))
+            face = 0.5 * (species[:-1] + species[1:])
+            gradient = np.diff(species, axis=0) / dx
+            numerator = da * gradient[:, 0] + db * gradient[:, 1] - dc * gradient[:, 2]
+            denominator = da * face[:, 0] + db * face[:, 1] + dc * face[:, 2]
+            electric = np.divide(-numerator, denominator, out=np.zeros_like(numerator), where=denominator > 0.0)
+            free = -np.column_stack((
+                da * (gradient[:, 0] + face[:, 0] * electric),
+                db * (gradient[:, 1] + face[:, 1] * electric),
+            ))
+            cluster = -self.diffusivity * NEUTRAL_MOBILITY * gradient[:, 3]
+            flux = np.zeros((points + 1, 2))  # blocking boundaries
+            flux[1:-1] = free + cluster[:, None]
+            return (-np.diff(flux, axis=0) / volume[:, None]).ravel()
+
+        # The two conserved variables only couple to their neighbouring nodes.
+        size = 2 * points
+        sparsity = diags(
+            [np.ones(size - abs(offset)) for offset in range(-3, 4)],
+            range(-3, 4), shape=(size, size), format="csr",
+        )
+        answer = solve_ivp(
+            rhs, (0.0, float(t[-1])), initial.ravel(), method="BDF", t_eval=t,
+            rtol=2e-8, atol=2e-10, jac_sparsity=sparsity,
+        )
+        if not answer.success:
+            raise RuntimeError(answer.message)
+        output = answer.y.T.reshape(len(t), points, 2)
+        if not np.all(np.isfinite(output)):
+            raise RuntimeError("non-finite concentration generated by transport solver")
+        return output
