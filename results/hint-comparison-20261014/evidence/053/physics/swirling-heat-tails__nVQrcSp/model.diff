     def fit(self, records):
-        raise NotImplementedError('Fit the common mobility from calibration records.')
+        # Every preparation has the same multiplicative mobility.  The
+        # calibration errors are independent Gaussians, so weighted least
+        # squares is the maximum-likelihood estimate.
+        records = list(records)
+        if not records:
+            raise ValueError('records must contain at least one calibration reading')
+
+        design = np.asarray([response(record['input']) for record in records],
+                            dtype=float)
+        values = np.asarray([record['value'] for record in records],
+                            dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records],
+                           dtype=float)
+        if (not np.all(np.isfinite(design)) or not np.all(np.isfinite(values))
+                or not np.all(np.isfinite(sigma)) or np.any(sigma <= 0.0)):
+            raise ValueError('calibration records must contain finite values and positive sigma')
+
+        weights = 1.0 / (sigma * sigma)
+        denominator = np.sum(weights * design * design)
+        if denominator <= 0.0 or not np.isfinite(denominator):
+            raise ValueError('calibration records do not identify mobility')
+        estimate = np.sum(weights * design * values) / denominator
+        self.mobility = float(np.clip(estimate, *_MOBILITY_RANGE))
+        return self
 
     def predict(self, experiments):
+        if self.mobility is None:
+            raise RuntimeError('fit must be called before predict')
         return predict_at(experiments, self.mobility)
