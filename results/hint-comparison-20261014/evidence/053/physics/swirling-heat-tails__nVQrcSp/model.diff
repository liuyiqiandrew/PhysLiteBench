 import numpy as np
 
 
+_MOBILITY_RANGE = (0.8, 1.3)
+_SQRT_ONE_THIRD = 1.0 / np.sqrt(3.0)
+
+
+def _dimensionless_heat_rate(r, z):
+    """Rate function for Q/(mobility * stiffness * t).
+
+    In the time variable tau=mobility*stiffness*t, the stationary mean heat
+    rate is 2*r**2.  The interior branch is also the rate function for the
+    circulating-force work.  Heat differs in the tails because
+
+        Q = W_circ - (U(t) - U(0)).
+
+    The initial and final stationary Gaussian energies must both be retained
+    when determining the domain of the exponential moment.  If lambda is
+    the counting field for exp(-lambda*Q), that domain is
+
+        lambda in (lambda_left, 1),
+
+    where lambda_left is the branch point of the usual quadratic SCGF,
+    except for r < 1/sqrt(3), where the initial-energy factor moves it to
+    (r**2 - 1)/(r**2 + 1).  Legendre transforming this non-steep SCGF gives
+    the two linear heat tails below.
+    """
+    r = np.asarray(r, dtype=float)
+    z = np.asarray(z, dtype=float)
+
+    # q is the heat rate in the rescaled time tau.
+    q = 2.0 * r * r * z
+    interior = np.sqrt((1.0 + r * r) * (q * q + 4.0 * r * r)
+                       / (4.0 * r * r)) - 0.5 * q - 1.0
+
+    # The final-energy endpoint factor sets lambda=1, hence the negative
+    # heat tail has slope one in q.  This is exact at z=-1 and below.
+    rate = np.where(z <= -1.0, -q, interior)
+
+    # For weak circulation the initial-energy factor is the active left
+    # boundary.  Its finite-slope branch is only relevant when it falls in
+    # the requested z range; applying it generally is simpler and keeps the
+    # formula valid beyond that range as well.
+    weak = r < _SQRT_ONE_THIRD
+    z_left = (3.0 - r * r) / (1.0 - 3.0 * r * r)
+    initial_energy_tail = (2.0 * r * r
+                           * ((1.0 - r * r) * z - 2.0)
+                           / (1.0 + r * r))
+    rate = np.where(weak & (z >= z_left), initial_energy_tail, rate)
+    return rate
+
+
