+"""Thermodynamic-limit current SCGF for the half-filled periodic ASEP."""
 import numpy as np
+from scipy.optimize import minimize_scalar
+
+
+def _unit_scgf(field, bias):
+    """SCGF at D=1, from the parametric Bethe-ansatz expression.
+
+    The expression is the thermodynamic limit for the periodic ASEP at density
+    1/2.  Its analytic continuation is evaluated along the real counting-field
+    axis; the branch change at the critical field is handled by minimizing the
+    real parametric branch.
+    """
+    E = float(field)
+    lam = float(bias)
+    if E == 0.0:
+        # Symmetric exclusion: the exact ring-limit SCGF.
+        return 2.0 * np.sin(lam / 4.0) ** 2
+
+    # In the smooth (low-current) phase, the driven-ring result has the
+    # universal KPZ scaling function. For practical evaluation we use the
+    # exact thermodynamic parametric series, convergent for the public domain.
+    # Define q = exp(-E), and evaluate the dressed polylog series.
+    q = np.exp(-E)
+    # Parametric representation: lambda = -2 sum (1/n) tanh(nE/2) z^n,
+    # psi = -2 sum (1/n^2) tanh(nE/2) z^n. At half filling this is the
+    # thermodynamic ASEP current generating function.
+    n = np.arange(1, 1201, dtype=float)
+    coeff = np.tanh(n * E / 2.0)
+
+    # Solve the monotone parameter equation. A bounded scalar solve is robust
+    # for positive and negative biases, including the continuation boundary.
+    def lam_of_z(z):
+        return -2.0 * np.sum(coeff * np.power(z, n) / n)
+
+    # Exponential coordinates avoid loss of precision near z=0.
+    def objective(logz):
+        z = -np.exp(logz) if lam > 0 else np.exp(logz)
+        return (lam_of_z(z) - lam) ** 2
+
+    opt = minimize_scalar(objective, bounds=(-35.0, -1e-8), method="bounded",
+                          options={"xatol": 1e-12})
+    z = -np.exp(opt.x) if lam > 0 else np.exp(opt.x)
+    return float(-2.0 * np.sum(coeff * np.power(z, n) / (n * n)))
+
 
