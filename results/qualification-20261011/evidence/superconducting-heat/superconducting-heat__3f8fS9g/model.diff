     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the (microsiemens) normal-state contact conductance.
+
+        The supplied calibration set is deliberately taken with the default,
+        unmodulated contact.  In that limit every transition rate, and hence
+        the measured heat current, is proportional to the total normal-state
+        conductance.  Doing the weighted one-parameter least-squares fit
+        directly is both more accurate and considerably cheaper than invoking
+        the nonlinear spin solver for each trial conductance.
+        """
+        records = list(records)
+        coefficients = []
+        values = []
+        weights = []
+        simple = True
+        for record in records:
+            experiment = record['input']
+            is_simple = not any(key in experiment for key in (
+                'amplitude', 'drive_energy', 'oscillator_coupling',
+                'oscillator_temperature', 'secondary_coupling',
+                'quadratic_coupling', 'momentum_coupling', 'statistic'))
+            simple &= is_simple
+            coefficient = power_per_conductance(
+                experiment['left_temperature'], experiment['right_temperature'],
+                experiment['phase'], 0., .3)
+            sigma = float(record['sigma'])
+            coefficients.append(float(coefficient))
+            values.append(float(record['value']))
+            weights.append(1. / (sigma * sigma))
+        if not records:
+            raise ValueError('At least one calibration record is required')
+        coefficients = np.asarray(coefficients)
+        values = np.asarray(values)
+        weights = np.asarray(weights)
+        if not simple:
+            def objective(conductance):
+                prediction = predict_at(
+                    [record['input'] for record in records], conductance)
+                residual = (prediction - values) * np.sqrt(weights)
+                return float(residual @ residual)
+            result = minimize_scalar(objective, bounds=(20., 80.), method='bounded')
+            if not result.success or not np.isfinite(result.fun):
+                raise ValueError('Conductance fit failed')
+            self.conductance = float(result.x)
+            return self
+        denominator = float(np.sum(weights * coefficients * coefficients))
+        if not np.isfinite(denominator) or denominator <= 0.:
+            raise ValueError('Calibration records do not identify conductance')
+        estimate = float(np.sum(weights * coefficients * values) / denominator)
+        self.conductance = float(np.clip(estimate, 20., 80.))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.conductance)
