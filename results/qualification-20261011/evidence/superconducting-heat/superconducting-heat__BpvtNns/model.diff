         self.conductance = None
 
     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the (normal-state) conductance from the calibration records.
+
+        The supplied calibration set is deliberately restricted to the
+        unmodulated, oscillator-decoupled contact.  In that limit the heat
+        current is proportional to the conductance, so the weighted
+        one-parameter least-squares solution is both exact for the model and
+        considerably more stable than a generic nonlinear fit.
+        """
+        coefficients = []
+        values = []
+        weights = []
+        for record in records:
+            inp = record['input']
+            coefficients.append(power_per_conductance(
+                inp['left_temperature'], inp['right_temperature'],
+                inp['phase'], inp.get('amplitude', 0.),
+                inp.get('drive_energy', .3)))
+            values.append(record['value'])
+            sigma = float(record['sigma'])
+            if not np.isfinite(sigma) or sigma <= 0:
+                raise ValueError('Calibration uncertainties must be positive')
+            weights.append(1. / sigma**2)
+        coefficients = np.asarray(coefficients, dtype=float)
+        values = np.asarray(values, dtype=float)
+        weights = np.asarray(weights, dtype=float)
+        denominator = np.sum(weights * coefficients**2)
+        if not np.isfinite(denominator) or denominator <= 0:
+            raise ValueError('Calibration records contain no conductance information')
+        fitted = np.sum(weights * coefficients * values) / denominator
+        # The apparatus specifies this parameter's allowed range.  Clipping
+        # keeps the public model well-defined even for an unusually noisy
+        # calibration realization.
+        self.conductance = float(np.clip(fitted, 20., 80.))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.conductance)
