-"""Current SCGF model and calibration interface."""
+"""SCGF model and calibration interface for the half-filled exclusion ring.
+
+In the weakly asymmetric, half-filled limit described in ``README.md``, the
+scaled current SCGF is
+
+    psi(E, lambda; D) = D * lambda * (lambda + 2 * E) / 4.
+
+The dependence on the apparatus parameter is therefore linear, which also
+makes its Gaussian calibration a one-parameter weighted least-squares fit.
+"""
 import numpy as np
 
+
 def predict_at(experiments, diffusivity):
+    """Return the asymptotic SCGF for a sequence of experiment inputs."""
     field = np.asarray([e["field"] for e in experiments], dtype=float)
     bias = np.asarray([e["bias"] for e in experiments], dtype=float)
-    return diffusivity*bias*(bias+2*field)/4
+    return np.asarray(diffusivity * bias * (bias + 2.0 * field) / 4.0)
 
 
 class Model:
@@ -12,7 +23,37 @@
         self.diffusivity = 1.
 
     def fit(self, records):
-        raise NotImplementedError("Fit diffusivity from the calibration records.")
+        """Fit ``diffusivity`` using the reported Gaussian uncertainties.
+
+        For observations ``y_i = D*x_i + noise_i``, where ``x_i`` is the
+        parameter-free SCGF, the maximum-likelihood estimate is
+
+            D = sum(x_i*y_i/sigma_i**2) / sum(x_i**2/sigma_i**2).
+
+        The clipping is both the documented parameter constraint and a guard
+        against an extrapolated estimate leaving the supported domain.
+        """
+        if not records:
+            # Keep the documented default when there is no calibration data.
+            self.diffusivity = 1.0
+            return self
+
+        inputs = [record["input"] for record in records]
+        x = predict_at(inputs, 1.0)
+        y = np.asarray([record["value"] for record in records], dtype=float)
+        sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+
+        weights = 1.0 / np.square(sigma)
+        denominator = np.sum(weights * np.square(x))
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            estimate = 1.0
+        else:
+            estimate = np.sum(weights * x * y) / denominator
+            if not np.isfinite(estimate):
+                estimate = 1.0
+
+        self.diffusivity = float(np.clip(estimate, 0.8, 1.2))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
