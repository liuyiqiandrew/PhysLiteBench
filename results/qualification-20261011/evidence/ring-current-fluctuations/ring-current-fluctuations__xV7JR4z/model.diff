-"""Current SCGF model and calibration interface."""
+"""SCGF model and calibration interface for the weakly asymmetric ring."""
 import numpy as np
 
+
 def predict_at(experiments, diffusivity):
-    field = np.asarray([e["field"] for e in experiments], dtype=float)
-    bias = np.asarray([e["bias"] for e in experiments], dtype=float)
-    return diffusivity*bias*(bias+2*field)/4
+    """Evaluate the leading large-ring SCGF at a collection of inputs.
+
+    In the scaling in the problem statement, the weak asymmetry contributes
+    the dimensionless field ``E`` and the exponential current tilt contributes
+    ``lambda``.  At half filling their combined leading SCGF is
+
+        D * ((E + lambda)**2 - E**2) / 4.
+
+    The explicit empty-input branch also guarantees a one-dimensional float
+    array for an empty list.
+    """
+    if not experiments:
+        return np.empty(0, dtype=float)
+
+    field = np.asarray([experiment["field"] for experiment in experiments], dtype=float)
+    bias = np.asarray([experiment["bias"] for experiment in experiments], dtype=float)
+    return np.asarray(diffusivity * bias * (bias + 2.0 * field) / 4.0, dtype=float)
 
 
 class Model:
@@ -12,7 +27,35 @@
         self.diffusivity = 1.
 
     def fit(self, records):
-        raise NotImplementedError("Fit diffusivity from the calibration records.")
+        """Fit the common rate prefactor and return ``self``.
+
+        The calibration errors are independent Gaussian errors with supplied
+        standard deviations, so the maximum-likelihood estimate is the
+        inverse-variance weighted least-squares estimate.  Clipping is only a
+        safeguard for the required public parameter domain.
+        """
+        if not records:
+            # There is no information to update the initial in-domain value.
+            return self
+
+        inputs = [record["input"] for record in records]
+        design = predict_at(inputs, 1.0)
+        values = np.asarray([record["value"] for record in records], dtype=float)
+        sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+
+        if not (np.isfinite(design).all() and np.isfinite(values).all()):
+            raise ValueError("Calibration inputs and values must be finite.")
+        if not (np.isfinite(sigma).all() and (sigma > 0).all()):
+            raise ValueError("Calibration standard deviations must be positive and finite.")
+
+        weights = 1.0 / np.square(sigma)
+        denominator = np.sum(weights * np.square(design))
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError("Calibration records do not identify diffusivity.")
+
+        estimate = np.sum(weights * design * values) / denominator
+        self.diffusivity = float(np.clip(estimate, 0.8, 1.2))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
