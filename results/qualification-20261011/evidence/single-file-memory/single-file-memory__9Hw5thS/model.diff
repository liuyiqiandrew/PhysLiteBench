 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Return the long-time covariance coefficient for one experiment.
+
+    The coefficient is homogeneous in the square root of time and in the
+    square root of the particle diffusivity.  Keeping the calculation in
+    scalar form also makes this helper useful independently of ``Model``.
+    """
+    diffusivity = float(diffusivity)
+    density = float(density)
+    time_a = float(time_a)
+    time_b = float(time_b)
+    return (np.sqrt(diffusivity / (2.0 * np.pi)) / density
+            * (np.sqrt(time_a) + np.sqrt(time_b)
+               - np.sqrt(abs(time_a - time_b))))
 
 
