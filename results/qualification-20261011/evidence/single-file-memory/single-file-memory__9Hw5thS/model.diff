@@ -18,7 +30,47 @@
         self.diffusivity = None
 
     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Estimate the common diffusivity from calibration observations.
+
+        Since the prediction is linear in ``sqrt(diffusivity)``, the Gaussian
+        maximum-likelihood estimate has a direct weighted least-squares
+        solution.  The physical range in the specification is applied after
+        fitting so noisy calibration data cannot produce an invalid model.
+        """
+        design = []
+        values = []
+        weights = []
+
+        for record in records:
+            experiment = record["input"]
+            density = float(experiment["density"])
+            time_a = float(experiment["time_a"])
+            time_b = float(experiment["time_b"])
+            value = float(record["value"])
+            sigma = float(record.get("sigma", 0.002))
+
+            # covariance(D, ...) = sqrt(D) * covariance(1, ...).
+            basis = covariance(1.0, density, time_a, time_b)
+            if not np.isfinite(basis) or not np.isfinite(value):
+                raise ValueError("Calibration records must contain finite values.")
+            if not np.isfinite(sigma) or sigma <= 0.0:
+                raise ValueError("Calibration sigma values must be positive and finite.")
+
+            design.append(basis)
+            values.append(value)
+            weights.append(1.0 / sigma**2)
+
+        design = np.asarray(design, dtype=float)
+        values = np.asarray(values, dtype=float)
+        weights = np.asarray(weights, dtype=float)
+        denominator = np.sum(weights * design**2)
+        if design.size == 0 or not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError("At least one valid calibration record is required.")
+
+        sqrt_diffusivity = np.sum(weights * design * values) / denominator
+        sqrt_diffusivity = np.clip(sqrt_diffusivity, np.sqrt(0.8), np.sqrt(1.2))
+        self.diffusivity = float(sqrt_diffusivity**2)
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
