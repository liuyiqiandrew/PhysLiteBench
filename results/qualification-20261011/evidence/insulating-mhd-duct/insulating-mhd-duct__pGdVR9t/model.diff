+        """Estimate the liquid viscosity from calibration records.
+
+        The forward model is linear in the applied pressure gradient, but
+        nonlinear in viscosity through the decay rates of the modes.  The
+        calibration uncertainties are independent and known, so the maximum
+        likelihood estimate is the bounded weighted least-squares minimum.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError('at least one calibration record is required')
+
+        experiments = [record['input'] for record in records]
+        values = np.asarray([record['value'] for record in records], dtype=float)
+        sigmas = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(values).all() or
+                not np.isfinite(sigmas).all() or np.any(sigmas <= 0)):
+            raise ValueError('calibration values and sigmas must be finite, with sigma > 0')
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = (self.predict(experiments) - values) / sigmas
+            return float(residual @ residual)
+
+        lower, upper = 0.006, 0.018
+        result = minimize_scalar(
+            objective, bounds=(lower, upper), method='bounded',
+            options={'xatol': 1e-11},
+        )
+
+        # A bounded minimizer normally cannot improve on an endpoint only
+        # when the minimum is at a bound.  Check both explicitly so the
+        # documented viscosity interval is respected in that case as well.
+        candidates = [(float(result.fun), float(result.x))]
+        candidates.extend((objective(bound), bound) for bound in (lower, upper))
+        _, best_viscosity = min(candidates, key=lambda item: item[0])
+        self.viscosity = best_viscosity
+        return self
 
