     def fit(self, records):
-        raise NotImplementedError
+        """Estimate the viscosity from the calibration measurements.
+
+        The measurement errors are independent Gaussians with known standard
+        deviations, so the maximum-likelihood estimate minimizes the weighted
+        sum of squared residuals.  There is only one unknown parameter and
+        the stated physical interval provides a convenient bounded search.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError('at least one calibration record is required')
+
+        experiments = [record['input'] for record in records]
+        measured = np.asarray([record['value'] for record in records], float)
+        uncertainty = np.asarray([record['sigma'] for record in records], float)
+        if (not np.isfinite(measured).all() or
+                not np.isfinite(uncertainty).all() or
+                np.any(uncertainty <= 0)):
+            raise ValueError('calibration values and sigma must be finite, with sigma > 0')
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = ((self.predict(experiments) - measured) / uncertainty)
+            return float(residual @ residual)
+
+        result = minimize_scalar(
+            objective,
+            bounds=(0.006, 0.018),
+            method='bounded',
+            options={'xatol': 1e-12},
+        )
+        if not result.success or not np.isfinite(result.x):
+            raise RuntimeError('viscosity fit did not converge')
+        self.viscosity = float(np.clip(result.x, 0.006, 0.018))
+        return self
 
