+        """Estimate the common dynamic viscosity from calibration records.
+
+        Each record is a scalar Gaussian observation with known standard
+        deviation.  Since viscosity is the only unknown parameter, the
+        maximum-likelihood estimate is the bounded minimum of the weighted
+        sum of squared prediction residuals.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("at least one calibration record is required")
+
+        experiments = [record["input"] for record in records]
+        observed = np.asarray([record["value"] for record in records], dtype=float)
+        uncertainty = np.asarray([record["sigma"] for record in records], dtype=float)
+        if (not np.all(np.isfinite(observed)) or
+                not np.all(np.isfinite(uncertainty)) or
+                np.any(uncertainty <= 0)):
+            raise ValueError("calibration values must be finite and sigma positive")
+
+        def objective(viscosity):
+            self.viscosity = float(viscosity)
+            residual = (self.predict(experiments) - observed) / uncertainty
+            return float(residual @ residual)
+
+        result = minimize_scalar(
+            objective, bounds=(0.006, 0.018), method="bounded",
+            options={"xatol": 1e-10},
+        )
+        # Include both physical endpoints in case the likelihood is minimized
+        # at a boundary (bounded minimization itself stays strictly inside).
+        candidates = [(result.fun, float(result.x))]
+        for endpoint in (0.006, 0.018):
+            candidates.append((objective(endpoint), endpoint))
+        self.viscosity = min(candidates, key=lambda item: item[0])[1]
+        return self
 
