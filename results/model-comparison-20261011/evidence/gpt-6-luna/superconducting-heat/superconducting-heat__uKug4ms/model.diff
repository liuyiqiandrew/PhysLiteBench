     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the common normal-state conductance to the supplied readouts.
+
+        Conductance is the only fitted apparatus parameter.  The records carry
+        independent Gaussian uncertainties, so the objective is the usual
+        uncertainty-weighted sum of squared residuals.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError('At least one calibration record is required.')
+        values = np.asarray([float(r['value']) for r in records])
+        sigmas = np.asarray([float(r['sigma']) for r in records])
+        if np.any(~np.isfinite(values)) or np.any(~np.isfinite(sigmas)) or np.any(sigmas <= 0):
+            raise ValueError('Calibration values and uncertainties must be finite, with positive uncertainties.')
+        experiments = [r['input'] for r in records]
+
+        def objective(conductance):
+            residual = (predict_at(experiments, float(conductance)) - values) / sigmas
+            return float(residual @ residual)
+
+        # The apparatus specification bounds its sole unknown to 20–80 µS.
+        answer = minimize_scalar(objective, bounds=(20., 80.), method='bounded',
+                                 options={'xatol': 1e-9, 'maxiter': 200})
+        candidates = [(float(answer.fun), float(answer.x)),
+                      (objective(20.), 20.), (objective(80.), 80.)]
+        self.conductance = min(candidates)[1]
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.conductance)
