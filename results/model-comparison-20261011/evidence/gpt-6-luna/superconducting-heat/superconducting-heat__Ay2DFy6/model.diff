     def fit(self, records):
-        raise NotImplementedError('Fit the normal contact conductance from calibration records.')
+        """Fit the shared normal-state conductance to independent measurements."""
+        inputs = [record['input'] for record in records]
+        observed = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        if not len(records):
+            raise ValueError('At least one calibration record is required.')
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError('Calibration values must be finite and uncertainties positive.')
+
+        def objective(conductance):
+            residual = (predict_at(inputs, float(conductance))-observed)/sigma
+            return float(residual @ residual)
+
+        result = minimize_scalar(objective, bounds=(20., 80.), method='bounded',
+                                 options={'xatol': 1e-9, 'maxiter': 200})
+        # Include endpoints: the physical parameter range is closed.
+        candidates = [(float(result.fun), float(result.x)),
+                      (objective(20.), 20.), (objective(80.), 80.)]
+        self.conductance = min(candidates)[1]
+        return self
 
     def predict(self, experiments):
+        if self.conductance is None:
+            raise RuntimeError('Call fit(records) before predict(experiments).')
         return predict_at(experiments, self.conductance)
 
 
