+                observed = float(row['value'])
+                sigma = float(row['sigma'])
+            except (KeyError, TypeError, ValueError, OverflowError) as exc:
+                raise ValueError('Each calibration record needs beta, value, and sigma.') from exc
+            if (not math.isfinite(beta) or not .2 <= beta <= .6
+                    or not math.isfinite(observed)
+                    or not math.isfinite(sigma) or sigma <= 0):
+                raise ValueError('Calibration values must be finite and within their stated ranges.')
+            weight = 1.0 / (sigma * sigma)
+            numerator += weight * beta * (-observed)
+            denominator += weight * beta * beta
+
+        if denominator <= 0 or not math.isfinite(numerator) or not math.isfinite(denominator):
+            raise ValueError('Calibration records do not define a finite fit.')
+        low_sq, high_sq = (bound * bound for bound in WIDTH_INTERVAL)
+        width_sq = min(high_sq, max(low_sq, numerator / denominator))
+        self.width = math.sqrt(width_sq)
