+def gate_cumulants(e, conductance, nodes=192, count=64):
+    """Leading extensive gate-work cumulants, including fluctuating spin."""
+    if e.get('amplitude', 0.) == 0:
+        return 0., 0.
+
+    args = oscillator_arguments(e)
+    kwargs = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+                  quadratic_coupling=e.get('quadratic_coupling', 0.),
+                  momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kwargs)
+    mu = state['mu']
+    tl, tr = args[:2]
+    dl, dr, ch = prepare(*args, nodes=nodes, count=count,
+                         window=state['search_bound'], **kwargs)
+    energy, other, measure, sl, sr, pair, work, _, pf, pb, injection = ch
+    f = expit((sl*mu[0]-energy)/tl)
+    g = expit((sr*mu[1]-other)/tr)
+    fp = sl*f*(1-f)/tl
+    gp = sr*g*(1-g)/tr
+    plus = measure*np.where(pair, pf*(1-f)*(1-g), pf*f*(1-g))
+    minus = measure*np.where(pair, pb*f*g, pb*g*(1-f))
+
+    # The first counting-field correction to the spin conjugate variable.
+    # The drift Jacobian includes tunnel injection and stochastic spin flips.
+    rate_l = measure*np.where(pair, -fp*(pf*(1-g)+pb*g),
+                              fp*(pf*(1-g)+pb*g))
+    rate_r = -measure*gp*np.where(pair, pf*(1-f)+pb*f,
+                                  pf*f+pb*(1-f))
+    heat_gradient = np.array([np.sum(work[:, None]*rate_l),
+                              np.sum(work[:, None]*rate_r)])
+    p1 = -np.linalg.solve(state['jacobian'].T, heat_gradient)
+    mark = (work + injection@p1)[:, None]
+
+    # ∂_p H=0 gives the first change of stationary spin potential under the
+    # counting field. This is needed even for the leading third cumulant.
+    driving = injection.T@np.sum((plus+minus)*mark, axis=1)
+    ratio = QUASIPARTICLE_DENSITY / (NORMAL_POLARIZATION_TIME*
+                                     RATE_CONVERSION*conductance)
+    flip_data = []
+    x, w = leggauss(160)
+    for j, (temp, delta, pol) in enumerate(zip((tl, tr), (dl, dr), mu)):
+        upper = delta + max(80*temp, 6*abs(pol))
+        ee = delta + (x+1)*(upper-delta)/2
+        mm = w*(upper-delta)*ratio/4
+        up = expit((pol-ee)/temp)
+        down = expit((-pol-ee)/temp)
+        up_rate = mm*up*(1-down)
+        down_rate = mm*down*(1-up)
+        flip_data.append((temp, up, down, mm, up_rate, down_rate))
+        driving[j] += 4*p1[j]*np.sum(up_rate+down_rate)
+    mu1 = -np.linalg.solve(state['jacobian'], driving)
+
+    noise = np.sum((plus+minus)*mark**2)
+    third = np.sum((plus-minus)*mark**3)
+
+    f1 = fp*mu1[0]
+    g1 = gp*mu1[1]
+    f2 = (mu1[0]/tl)**2*f*(1-f)*(1-2*f)
+    g2 = (mu1[1]/tr)**2*g*(1-g)*(1-2*g)
+    plus1 = measure*pf*np.where(pair,
+        -f1*(1-g)-(1-f)*g1, f1*(1-g)-f*g1)
+    minus1 = measure*pb*np.where(pair,
+        f1*g+f*g1, g1*(1-f)-g*f1)
+    plus2 = measure*pf*np.where(pair,
+        -f2*(1-g)+2*f1*g1-(1-f)*g2,
+        f2*(1-g)-2*f1*g1-f*g2)
+    minus2 = measure*pb*np.where(pair,
+        f2*g+2*f1*g1+f*g2,
+        g2*(1-f)-2*g1*f1-g*f2)
+    third += 3*np.sum((plus1+minus1)*mark**2)
+    third += 3*np.sum((plus2-minus2)*mark)
+
+    for j, (temp, up, down, mm, up_rate, down_rate) in enumerate(flip_data):
+        flip_mark = -2*p1[j]
