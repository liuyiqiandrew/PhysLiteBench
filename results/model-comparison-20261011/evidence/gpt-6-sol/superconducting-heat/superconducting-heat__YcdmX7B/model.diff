+        d1 = -mu1[j]*down*(1-down)/temp
+        u2 = (mu1[j]/temp)**2*up*(1-up)*(1-2*up)
+        d2 = (mu1[j]/temp)**2*down*(1-down)*(1-2*down)
+        up1 = mm*(u1*(1-down)-up*d1)
+        down1 = mm*(d1*(1-up)-down*u1)
