 import numpy as np
+from scipy.optimize import brentq
+from scipy.special import ellipe, ellipk, elliprf, elliprj
+
+
+_CRITICAL_FIELD = 2.0 * np.pi
+
+
+def _elliptic_pi(n, m):
+    """Complete elliptic integral of the third kind, with parameter ``m``."""
+    return elliprf(0.0, 1.0 - m, 1.0) + n * elliprj(
+        0.0, 1.0 - m, 1.0, 1.0 - n
+    ) / 3.0
+
+
+def _wave_scgf(field, shifted_bias):
+    """Unit-diffusivity SCGF on the phase-separated branch.
+
+    At half filling the optimal density wave is stationary. Writing its
+    density as (1 + u)/2 gives u = sqrt(m) sn(4 K(p) x | p), with m = p b
+    and b = (4 K(p)/field)^2. The period and counting-field conditions fix
+    p; the resulting SCGF reduces to the expression below.
+    """
+    target = abs(shifted_bias)
+    end = brentq(lambda p: 4.0 * ellipk(p) - field, 0.0, 1.0 - 1e-14)
+
+    def counting_field(p):
+        k = ellipk(p)
+        b = (4.0 * k / field) ** 2
+        m = p * b
+        integral = _elliptic_pi(m, p) / k
+        return field * np.sqrt(max(0.0, (1.0 - m) * (1.0 - b))) * integral
+
+    if target == 0.0:
+        p = end
+    else:
+        p = brentq(lambda p: counting_field(p) - target, 0.0, end)
+
+    k = ellipk(p)
+    b = (4.0 * k / field) ** 2
+    m = p * b
+    mean_u_squared = b * (k - ellipe(p)) / k
+    return field**2 * (2.0 * mean_u_squared - m - b) / 4.0
+
 
