+def gate_statistics(e, conductance, nodes=192, count=64):
+    """Leading extensive, long-time gate cumulants, including spin feedback.
+
+    The tilted jump Hamiltonian is H(mu,p,z)=sum r(mu)*expm1(v.p+z*w).
+    Its stationary saddle gives the extensive cumulant generator. Although
+    spin density is the physical state variable, its monotone map to mu
+    leaves this stationary saddle unchanged; no susceptibility is needed.
+
+    Differentiating H_mu=H_p=0 at z=0 gives the counting response p1 and
+    the state response mu1. The third derivative includes both the rate
+    gradients and curvature, in addition to screened Poisson skewness.
+    """
+    if e.get('amplitude', 0.) == 0:
+        return dict(noise=0., third=0., shot=0., screened_poisson=0.)
+    args = oscillator_arguments(e)
+    kwargs = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+                  quadratic_coupling=e.get('quadratic_coupling', 0.),
+                  momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kwargs)
+    dl, dr, channels = prepare(*args, nodes=nodes, count=count,
+                               window=state['search_bound'], **kwargs)
+    rates, gradient, hessian, jumps, work = event_rate_derivatives(
+        *args[:2], (dl, dr), channels, state['mu'], conductance)
+    jacobian = jumps.T @ gradient
+    p1 = -np.linalg.solve(jacobian.T, work @ gradient)
+    mark = work + jumps @ p1
+    mu1 = -np.linalg.solve(jacobian, jumps.T @ (rates * mark))
+
+    noise = rates @ mark**2
+    bare = rates @ mark**3
+    modulation = 3 * (gradient @ mu1) @ mark**2
+    curvature = 3 * np.einsum('i,ijk,j,k->', mark, hessian, mu1, mu1)
+    rate_scale = RATE_CONVERSION * conductance
+    noise_scale = rate_scale * (KB * 1e12)**2
+    third_scale = rate_scale * (KB * 1e12)**3
+    return dict(noise=float(noise * noise_scale),
+                third=float((bare + modulation + curvature) * third_scale),
+                shot=float((rates @ work**2) * noise_scale),
+                screened_poisson=float(bare * third_scale),
+                count_response=p1.tolist(), state_response=mu1.tolist(),
+                mu=state['mu'].tolist())
+
+
+def gate_third(e, conductance, nodes=192, count=64):
+    return gate_statistics(e, conductance, nodes, count)
+
+
+def predict_at(experiments, conductance):
+    values = []
+    for experiment in experiments:
+        statistic = experiment.get('statistic', 'mean')
+        if statistic in ('gate_noise', 'gate_third'):
+            cumulants = gate_statistics(experiment, conductance)
+            value = cumulants['noise' if statistic == 'gate_noise' else 'third']
+        elif statistic == 'mean':
+            value = mean_heat(experiment, conductance)
+        elif statistic == 'phase_contrast':
+            other = dict(experiment, phase=experiment['phase'] + np.pi)
+            value = (mean_heat(experiment, conductance) - mean_heat(other, conductance)) / 2
+        else:
+            raise ValueError('Unknown statistic: ' + str(statistic))
         values.append(value)
