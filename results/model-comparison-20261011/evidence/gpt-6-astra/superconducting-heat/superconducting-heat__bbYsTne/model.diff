+def event_rate_derivatives(left, right, gaps, channels, mu, conductance):
+    """Integrated event rates and their first two spin-potential derivatives.
+
+    Rates are in units of RATE_CONVERSION * conductance. Each row is one
+    directed event, with spin jump v and gate work w (in kelvin). Keeping
+    forward and reverse events separate retains Pauli blocking in cumulants.
+    """
+    energy, other, measure, sl, sr, pair, work, _, pf, pb, injection = channels
+    f = expit((sl * mu[0] - energy) / left)
+    g = expit((sr * mu[1] - other) / right)
+    df = sl * f * (1 - f) / left
+    dg = sr * g * (1 - g) / right
+    ddf = f * (1 - f) * (1 - 2*f) / left**2
+    ddg = g * (1 - g) * (1 - 2*g) / right**2
+    rates, gradients, hessians = [], [], []
+    for backward in (False, True):
+        if backward:
+            a, da, dda = (np.where(pair, f, 1-f),
+                          np.where(pair, df, -df), np.where(pair, ddf, -ddf))
+            b, db, ddb, weight = g, dg, ddg, measure * pb
+        else:
+            a, da, dda = (np.where(pair, 1-f, f),
+                          np.where(pair, -df, df), np.where(pair, -ddf, ddf))
+            b, db, ddb, weight = 1-g, -dg, -ddg, measure * pf
+        rates.append(np.sum(weight * a * b, axis=1))
+        gradients.append(np.column_stack((np.sum(weight * da * b, axis=1),
+                                          np.sum(weight * a * db, axis=1))))
+        hessian = np.empty((len(work), 2, 2))
+        hessian[:, 0, 0] = np.sum(weight * dda * b, axis=1)
+        hessian[:, 1, 1] = np.sum(weight * a * ddb, axis=1)
+        hessian[:, 0, 1] = hessian[:, 1, 0] = np.sum(weight * da * db, axis=1)
+        hessians.append(hessian)
+    jumps = [injection, -injection]
+    marks = [work, -work]
+
+    # N(E)/tau(E) = 1/tau_n, so the flip integral has no gap-edge
+    # singularity. Each up->down event changes S by -2, and conversely.
+    ratio = QUASIPARTICLE_DENSITY / (NORMAL_POLARIZATION_TIME *
+                                    RATE_CONVERSION * conductance)
+    for j, (temperature, delta, polarization) in enumerate(zip((left, right), gaps, mu)):
+        width = max(80 * temperature, abs(polarization) - delta + 40 * temperature)
+        ee = delta + (NODES + 1) * width / 2
+        weight = WEIGHTS * width * ratio / 4
+        for spin in (1, -1):
+            a = expit((spin * polarization - ee) / temperature)
+            b = expit((-spin * polarization - ee) / temperature)
+            da = spin * a * (1-a) / temperature
+            db = -spin * b * (1-b) / temperature
+            dda = a * (1-a) * (1-2*a) / temperature**2
+            ddb = b * (1-b) * (1-2*b) / temperature**2
+            rate = np.sum(weight * a * (1-b))
+            gradient = np.zeros((1, 2))
+            gradient[0, j] = np.sum(weight * (da * (1-b) - a * db))
+            hessian = np.zeros((1, 2, 2))
+            hessian[0, j, j] = np.sum(weight * (dda * (1-b) - 2*da*db - a*ddb))
+            jump = np.zeros((1, 2))
+            jump[0, j] = -2 * spin
+            rates.append(np.array([rate]))
+            gradients.append(gradient)
+            hessians.append(hessian)
+            jumps.append(jump)
+            marks.append(np.zeros(1))
+    return tuple(np.concatenate(items) for items in
+                 (rates, gradients, hessians, jumps, marks))
