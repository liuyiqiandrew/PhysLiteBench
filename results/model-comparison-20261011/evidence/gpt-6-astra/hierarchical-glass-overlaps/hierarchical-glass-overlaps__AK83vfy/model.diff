     def fit(self, records):
-        raise NotImplementedError('Fit width from the calibration records.')
+        """Fit width by constrained Gaussian maximum likelihood.
+
+        Every calibration beta is below the first critical beta, even
+        at width=1.2. Thus the mean is -beta*width**2, and weighted least
+        squares is a one-parameter linear fit in width squared.
+        """
+        readings = []
+        for row in records:
+            beta = float(row['input']['beta'])
+            measured = float(row['value'])
+            sigma = float(row['sigma'])
+            if not math.isfinite(beta) or not .2 <= beta <= .6:
+                raise ValueError('Outside the stated calibration temperature range.')
+            if not math.isfinite(measured):
+                raise ValueError('Calibration values must be finite.')
+            if not math.isfinite(sigma) or sigma <= 0:
+                raise ValueError('Calibration sigma must be finite and positive.')
+            readings.append((beta, measured, sigma))
+        if not readings:
+            raise ValueError('Supply at least one calibration reading.')
+
+        # Rescaling all inverse-variance weights preserves the optimum.
+        scale = min(sigma for _, _, sigma in readings)
+        weighted = [(beta, measured, (scale/sigma)**2)
+                    for beta, measured, sigma in readings]
+        numerator = -math.fsum(weight*beta*measured
+                               for beta, measured, weight in weighted)
+        denominator = math.fsum(weight*beta*beta
+                                 for beta, _, weight in weighted)
+        squared = numerator/denominator
+        lo, hi = WIDTH_INTERVAL
+        self.width = math.sqrt(min(hi*hi, max(lo*lo, squared)))
+        return self
 
