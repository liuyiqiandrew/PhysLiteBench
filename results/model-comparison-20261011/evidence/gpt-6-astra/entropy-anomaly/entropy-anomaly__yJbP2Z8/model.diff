+def limiting_state(e, friction, points=129):
+    phase, derivative = spatial_grid(points)
+    d = derivative * e["wavenumber"]
+    dx = 2 * np.pi / points
+    factors, gx, gy, q = contact_parameters(e, friction)
+    count = len(gx)
+    force = (e["force_x"], e["force_y"])
+    magnetic = e["magnetic"]
+    local_t = e["temperature"] * (1 + e["contrast"] * np.cos(phase))
+    temperatures = factors[:, None] * local_t
+
+    # Fast second moments per unit spatial density and base temperature.
+    unit0 = {(0, 0): np.ones((count, 1)) / count}
+    unit2 = solve_moments(2, unit0, factors[:, None], gx, gy, magnetic, q)
+    _, a1 = moment_operator(1, gx, gy, magnetic, q)
+    force_source = np.tile(np.array(force) / count, count)
+    diff_source = np.column_stack((unit2[2, 0][:, 0], unit2[1, 1][:, 0])).ravel()
+    velocity = -np.linalg.solve(a1, force_source).reshape(count, 2).sum(axis=0)
+    diffusion = -np.linalg.solve(a1, diff_source).reshape(count, 2).sum(axis=0)
+
+    # Constant spatial current: j_x = velocity_x*rho - diffusion_x*(T*rho)'.
+    # Solve for both rho and j_x, imposing integral rho d(phase) = 1.  This
+    # normalized single-cell representation already includes all x periods
+    # and the uniform y distribution.
+    operator = np.empty((points + 1, points + 1))
+    operator[:points, :points] = (
+        velocity[0] * np.eye(points) - diffusion[0] * d * local_t[None, :]
+    )
+    operator[:points, points] = -1.
+    operator[points, :points] = dx
+    operator[points, points] = 0.
+    rhs = np.zeros(points + 1)
+    rhs[-1] = 1.
+    density = np.linalg.solve(operator, rhs)[:points]
+
+    zeroth = {(0, 0): np.tile(density / count, (count, 1))}
+    second = solve_moments(2, zeroth, temperatures, gx, gy, magnetic, q)
+    fourth = solve_moments(4, second, temperatures, gx, gy, magnetic, q)
+    first = solve_moments(1, {}, temperatures, gx, gy, magnetic, q,
+                          d, force, zeroth, second)
+    third = solve_moments(3, first, temperatures, gx, gy, magnetic, q,
+                          d, force, second, fourth)
+
+    # At order m, contact continuity requires Q*n^(2) = d_x*j_s.
+    # The total density correction is unnecessary: its entropy contribution
+    # is exactly canceled by the measured-residence background subtraction.
+    # Choose the zero-sum solution, but retain contact population differences.
+    population_source = (d @ first[1, 0].T).T
+    population_source -= population_source.mean(axis=0)
+    population = np.linalg.solve(q + np.ones_like(q) / count, population_source)
+    population -= population.mean(axis=0)
+    density_correction = {(0, 0): population}
+    second_correction = solve_moments(
+        2, density_correction, temperatures, gx, gy, magnetic, q,
+        d, force, first, third,
+    )
+
+    # Ito form of the stated Stratonovich calorimetry is
+    # sum_s,i gamma_i,s * (M_ii,s / T_s - n_s) / m.
+    # The uniform force-free background is exactly background_coefficient/m.
+    background_coefficient = float(np.sum(
+        gx * (unit2[2, 0][:, 0] / factors - 1 / count)
+        + gy * (unit2[0, 2][:, 0] / factors - 1 / count)
+    ))
+    local = np.sum(
+        gx[:, None] * (second_correction[2, 0] / temperatures - population)
+        + gy[:, None] * (second_correction[0, 2] / temperatures - population),
+        axis=0,
+    ) - background_coefficient * population.sum(axis=0)
+    return dict(
+        value=float(dx * local.sum()), local=local, phase=phase, density=density,
+        diffusion=diffusion, velocity=velocity, dx=dx, first=first, second=second,
+        density_correction=density_correction, second_correction=second_correction,
+        temperatures=temperatures, background_coefficient=background_coefficient,
+    )
