+def moment_operator(degree, gx, gy, magnetic, q):
+    """Fast drift/contact operator on contact-resolved monomial moments."""
+    basis = [(p, degree - p) for p in range(degree, -1, -1)]
+    lookup = {pair: i for i, pair in enumerate(basis)}
+    a = np.kron(q, np.eye(degree + 1))
+    for s in range(len(gx)):
+        for i, (p, n) in enumerate(basis):
+            row = s * (degree + 1) + i
+            a[row, row] -= p * gx[s] + n * gy[s]
+            if p:
+                a[row, s * (degree + 1) + lookup[p - 1, n + 1]] += p * magnetic
+            if n:
+                a[row, s * (degree + 1) + lookup[p + 1, n - 1]] -= n * magnetic
+    return basis, a
