+    def fit(self, records):
+        """Fit inverse friction by Gaussian weighted least squares.
+
+        The documented calibration has equal baths and no magnetic field,
+        making predictions exactly linear in inverse friction.
+        """
+        records = list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required.")
+        base = coefficients([r["input"] for r in records], friction=1.)
+        sigma = np.array([r["sigma"] for r in records], dtype=float)
+        observed = np.array([r["value"] for r in records], dtype=float)
+        if not np.all(np.isfinite(sigma) & (sigma > 0)):
+            raise ValueError("Calibration uncertainties must be finite and positive.")
+        if not np.all(np.isfinite(observed)):
+            raise ValueError("Calibration values must be finite.")
+        design = base / sigma
+        information = design @ design
+        if not np.isfinite(information) or information <= 0:
+            raise ValueError("Calibration does not identify friction.")
+        inverse_friction = (design @ (observed / sigma)) / information
+        self.friction = float(1 / np.clip(inverse_friction, 1 / 1.6, 1 / .7))
+        return self
+
+    def predict(self, experiments):
+        if self.friction is None:
+            raise RuntimeError("Fit the model before predicting.")
+        return coefficients(experiments, self.friction)
