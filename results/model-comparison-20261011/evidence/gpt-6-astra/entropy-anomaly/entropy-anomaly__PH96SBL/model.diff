+        """Fit the common drag by weighted least squares on calibration data.
+
+        Calibration has identical baths and zero magnetic field.  Every
+        rate is then exactly proportional to 1/friction, so the Gaussian
+        likelihood is a one-parameter linear least-squares problem.
+        """
+        records=list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required.")
+        unit=coefficients([r['input'] for r in records],1.)
+        values=np.asarray([r['value'] for r in records],dtype=float)
+        sigma=np.asarray([r['sigma'] for r in records],dtype=float)
+        if not (np.isfinite(values).all() and np.isfinite(sigma).all() and (sigma>0).all()):
+            raise ValueError("Calibration values and positive uncertainties must be finite.")
+        weighted_unit=unit/sigma
+        information=float(weighted_unit@weighted_unit)
+        if not information>0:
+            raise ValueError("Calibration does not identify the friction.")
+        inverse_friction=float(weighted_unit@(values/sigma))/information
+        self.friction=float(1/np.clip(inverse_friction,1/1.6,1/.7))
+        return self
