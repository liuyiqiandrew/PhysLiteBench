+@lru_cache(16)
+def periodic_derivatives(n):
+    """Fourier differentiation on an odd, equally spaced periodic grid."""
+    wave = np.fft.fftfreq(n, 1/n)
+    basis = np.fft.fft(np.eye(n), axis=0)
+    dx = np.fft.ifft(1j*wave[:, None]*basis, axis=0).real
+    dxx = np.fft.ifft(-wave[:, None]**2*basis, axis=0).real
+    return dx, dxx
+
+
+@lru_cache(512)
+def channel_coefficients(gamma,zeta,kappa,T,Tb,B0,B1,phase,V,rate,
+                         drag_contrast,temperature_contrast,n,
+                         transverse_drive,drive_phase,fluid_anisotropy,fluid_axis):
+    """Homogenized drift, diffusion, and unsymmetrized velocity integral."""
+    x = np.arange(n)*2*np.pi/n
+    velocity = np.empty((n, 2))
+    diffusion = np.empty((n, 2, 2))
+    integrated = np.empty((n, 2, 2))
+    for j, angle in enumerate(x):
+        b = B0+B1*np.cos(angle+phase)
+        bp = -B1*np.sin(angle+phase)
+        M,D,c,_,K = valve_cell(gamma,zeta,kappa,T,Tb,b,rate,
+                              drag_contrast,temperature_contrast,
+                              fluid_anisotropy,fluid_axis)
+        force = np.array([V*np.sin(angle),
+                          transverse_drive*np.cos(angle+drive_phase)])
+        velocity[j] = M@force+bp*c
+        diffusion[j] = D
+        integrated[j] = K
+    return x, velocity, diffusion, integrated
+
+
+def channel_stationary(velocity, diffusion):
+    """Return stationary grid masses and the normalized Poisson solver."""
+    n = len(velocity)
+    dx, dxx = periodic_derivatives(n)
+    generator = -dx*velocity[:, 0]+dxx*diffusion[:, 0, 0]
+    system = generator.copy()
+    system[0] = 1.
+    factor = lu_factor(system)
+    rhs = np.zeros(n)
+    rhs[0] = 1.
+    p = lu_solve(factor, rhs)
+    return dx, factor, p
+
+
+@lru_cache(512)
+def valve_moments(gamma,zeta=1.,kappa=.7,T=.5,Tb=1.4,B0=.6,B1=.9,phase=.8,V=.8,rate=.7,drag_contrast=.6,temperature_contrast=.5,n=129,transverse_drive=0.,drive_phase=0.,fluid_anisotropy=0.,fluid_axis=0.):
+    x, velocity, diffusion, _ = channel_coefficients(
+        gamma,zeta,kappa,T,Tb,B0,B1,phase,V,rate,drag_contrast,
+        temperature_contrast,n,transverse_drive,drive_phase,
+        fluid_anisotropy,fluid_axis)
+    _, _, p = channel_stationary(velocity, diffusion)
+    return np.array([p@a for k in [1,2,3]
+                     for a in [np.cos(k*x),np.sin(k*x)]])
+
+
+@lru_cache(512)
+def circulation(gamma,zeta=1.,kappa=.7,T=.5,Tb=1.4,B0=.6,B1=.9,phase=.8,V=.8,rate=.7,drag_contrast=.6,temperature_contrast=.5,n=129,harmonic=1,quadrature='cos',transverse_drive=0.,drive_phase=0.,fluid_anisotropy=0.,fluid_axis=0.):
+    x, velocity, diffusion, integrated = channel_coefficients(
+        gamma,zeta,kappa,T,Tb,B0,B1,phase,V,rate,drag_contrast,
+        temperature_contrast,n,transverse_drive,drive_phase,
+        fluid_anisotropy,fluid_axis)
+    if quadrature == 'cos':
+        weight = np.cos(harmonic*x)
+        derivative = -harmonic*np.sin(harmonic*x)
+    else:
+        weight = np.sin(harmonic*x)
+        derivative = harmonic*np.cos(harmonic*x)
+
+    # The finite-mass mechanical record retains the antisymmetric part of K.
+    # Its Ito drift is a*b_y + a'*K_yx, while its diffusion is a^2*D_yy.
+    g = weight*velocity[:, 1]+derivative*integrated[:, 1, 0]
+    h = weight**2*diffusion[:, 1, 1]
+    dx, factor, p = channel_stationary(velocity, diffusion)
+
+    # Forward tilted generator: L(k) = L + k*A1 + k^2*A2/2.
+    # d<X,Y>/dt = 2*a*D_xy supplies a derivative term in A1.  Keeping
+    # this shared noise is essential for both the second and third cumulants.
+    A1 = np.diag(g)-dx*(2*weight*diffusion[:, 0, 1])
+    A2 = 2*h
+    c1 = float(g@p)
+    rhs = c1*p-A1@p
+    rhs[0] = 0.
+    r1 = lu_solve(factor, rhs)
+    c2 = float(A2@p+2*g@r1)
+    rhs = c2*p+2*c1*r1-2*A1@r1-A2*p
+    rhs[0] = 0.
+    r2 = lu_solve(factor, rhs)
+    c3 = float(3*g@r2+3*A2@r1)
     return np.array([c1,c2,c3])
 
