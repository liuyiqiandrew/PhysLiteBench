         self.diffusivity = None
 
     def fit(self,data):
-        raise NotImplementedError('Fit the common ionic diffusion scale from calibration.')
+        """Fit the common diffusion scale to the single-salt preparations.
+
+        In these preparations the absent cation is identically zero, so the
+        association reaction is inactive and electroneutrality fixes the
+        anion concentration.  The two measured channels therefore diffuse
+        independently with ambipolar diffusivities 4D/3 and 8D/3.
+        """
+        x=np.asarray(data['x'],dtype=float)
+        t=np.asarray(data['t'],dtype=float)
+        initial=np.asarray(data['initial'],dtype=float)
+        observed=np.asarray(data['concentration'],dtype=float)
+        sigma=np.asarray(data['sigma'],dtype=float)
+        if initial.ndim!=3 or observed.ndim!=4 or sigma.shape!=observed.shape:
+            raise ValueError('Calibration arrays have incompatible shapes.')
+        if observed.shape[0]!=initial.shape[0] or observed.shape[1:]!=(len(t),len(x),2):
+            raise ValueError('Calibration arrays do not match x and t.')
+
+        # Minimize the Gaussian weighted residual in log(D), which keeps the
+        # fitted scale positive and behaves well across several orders of
+        # magnitude.
+        def objective(log_diffusivity):
+            self.diffusivity=float(np.exp(log_diffusivity))
+            residual=[]
+            for run,profile in enumerate(initial):
+                prediction=self._binary(t,x,profile)
+                residual.append(((prediction-observed[run])/sigma[run]).ravel())
+            residual=np.concatenate(residual)
+            return float(residual@residual)
+
+        result=minimize_scalar(objective,bounds=(np.log(1e-14),np.log(1e-6)),
+                               method='bounded',options={'xatol':1e-11})
+        if not result.success or not np.isfinite(result.fun):
+            raise RuntimeError('Could not fit the diffusion scale.')
+        self.diffusivity=float(np.exp(result.x))
+        return self
 
     def _binary(self,t,x,initial):
         t,x,initial=np.asarray(t),np.asarray(x),np.asarray(initial)
