+        initial = np.asarray(data['initial'], dtype=float)
+        measured = np.asarray(data['concentration'], dtype=float)
+        sigma = np.asarray(data['sigma'], dtype=float)
+
+        # With only A or only B present, association is absent.  Charge
+        # neutrality makes their effective diffusivities 4D/3 and 8D/3.
+        n = len(x) - 1
+        laplacian_rates = 4 / (x[1] - x[0])**2 * np.sin(
+            np.arange(n + 1) * np.pi / (2 * n)
+        )**2
+        coefficients = dct(initial, type=1, axis=1)
+        unit_rates = laplacian_rates[None, None, :, None] * np.array(
+            [4 / 3, 8 / 3]
+        )[None, None, None, :]
+
+        def weighted_error(log_diffusivity):
+            decay = np.exp(-np.exp(log_diffusivity) * t[None, :, None, None]
+                           * unit_rates)
+            predicted = idct(coefficients[:, None] * decay, type=1, axis=2)
+            residual = (predicted - measured) / sigma
+            return np.sum(residual * residual)
+
+        result = minimize_scalar(weighted_error, bounds=(np.log(1e-14),
+                                np.log(1e-6)), method='bounded',
+                                options={'xatol': 1e-12})
+        if not result.success:
+            raise RuntimeError('Diffusivity calibration failed')
+        self.diffusivity = float(np.exp(result.x))
+        return self
 
