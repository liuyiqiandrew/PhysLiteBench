+@lru_cache(4)
+def mixed_magnetic_operator(nx=X_MODES, ny=Y_MODES):
+    """Return the Bx*By part of the insulating-wall Lorentz operator.
+
+    ``qx`` and ``qy`` above are the two diagonal parts of the magnetic
+    damping operator.  They are enough when the field is parallel to a wall,
+    but a general in-plane field also couples the odd--odd velocity modes to
+    the even--even modes.  This is the (symmetric) cross term.
+
+    The expression follows by expanding the electric potential in Neumann
+    cosine modes, eliminating it from Ohm's law, and projecting back onto
+    the sine velocity modes.  It is kept separate since it is identically
+    unused for the axis-aligned calibration experiments.
+    """
+    m, n, _, _, _, _ = operators(nx, ny)
+    # For positive integer a,b, C(a,b) is the mean of cos(a*pi*x)
+    # times sin(b*pi*x) on the unit interval.  In the expression below the
+    # first argument is always non-zero, so there is no constant-mode case.
+    source_m = m[None, :]
+    target_m = m[:, None]
+    target_n = n[:, None]
+    source_n = n[None, :]
+
+    cm = np.zeros((len(m), len(m)))
+    mask_m = (source_m + target_m) % 2 == 1
+    np.divide(2 * target_m, np.pi * (target_m**2 - source_m**2),
+              out=cm, where=mask_m)
+
+    cn = np.zeros((len(m), len(m)))
+    mask_n = (target_n + source_n) % 2 == 1
+    np.divide(2 * source_n, np.pi * (source_n**2 - target_n**2),
+              out=cn, where=mask_n)
+
+    # This is Gy.T K^-1 Gx; its transpose supplies Gx.T K^-1 Gy.
+    k2 = (source_m * np.pi / WIDTH)**2 + (target_n * np.pi / HEIGHT)**2
+    first = (4 * (target_n * np.pi / HEIGHT) * (source_m * np.pi / WIDTH)
+             * cm * cn / k2)
+    return first + first.T
+
