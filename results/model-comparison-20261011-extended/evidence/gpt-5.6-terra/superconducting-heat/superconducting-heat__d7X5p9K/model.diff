+        The calibration records use the unmodulated, oscillator-decoupled
+        contact.  In that limit the stationary heat current is exactly linear
+        in the normal conductance, so solving the one-parameter weighted
+        regression directly is both more accurate and considerably less
+        expensive than repeatedly running a nonlinear optimiser.
+        """
+        if not records:
+            raise ValueError("fit requires at least one calibration record")
+
+        inputs = [record['input'] for record in records]
+        observed = np.asarray([record['value'] for record in records], dtype=float)
+        sigma = np.asarray([record['sigma'] for record in records], dtype=float)
+        if (not np.isfinite(observed).all() or not np.isfinite(sigma).all()
+                or np.any(sigma <= 0)):
+            raise ValueError("calibration values and sigmas must be finite, with sigma > 0")
+
+        weights = sigma ** -2
+        bare_calibration = all(
+            item.get('statistic', 'mean') == 'mean'
+            and item.get('amplitude', 0.) == 0.
+            and item.get('oscillator_coupling', 0.) == 0.
+            and item.get('secondary_coupling', 0.) == 0.
+            and item.get('quadratic_coupling', 0.) == 0.
+            and item.get('momentum_coupling', 0.) == 0.
+            for item in inputs
+        )
+        if bare_calibration:
+            # Evaluate at one microsiemens; this preserves the documented
+            # units and avoids optimiser noise for the supplied calibration.
+            design = np.asarray(r4_predict_at(inputs, 1.0), dtype=float)
