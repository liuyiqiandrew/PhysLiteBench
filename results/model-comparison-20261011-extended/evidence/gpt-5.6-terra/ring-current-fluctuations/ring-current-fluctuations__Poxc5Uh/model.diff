+"""SCGF model for the weakly asymmetric exclusion process on a ring.
+
+At half filling the leading large-ring SCGF is
+
+    psi(E, lambda; D) = D * lambda * (lambda + 2 E) / 4.
+
+``D`` is the sole unknown common rate scale, so calibration is a weighted
+linear least-squares problem rather than a numerical simulation problem.
+"""
+
 import numpy as np
 
+
+_MIN_DIFFUSIVITY = 0.8
+_MAX_DIFFUSIVITY = 1.2
+
+
 def predict_at(experiments, diffusivity):
-    field = np.asarray([e["field"] for e in experiments], dtype=float)
