-    return diffusivity*bias*(bias+2*field)/4
+    """Return raw SCGF values for an iterable of documented input mappings."""
+    # Constructing the arrays this way gives the specified (0,) output for an
+    # empty list, while retaining a compact vectorized implementation.
+    field = np.asarray([item["field"] for item in experiments], dtype=float)
+    bias = np.asarray([item["bias"] for item in experiments], dtype=float)
+    return float(diffusivity) * bias * (bias + 2.0 * field) / 4.0
 
 
