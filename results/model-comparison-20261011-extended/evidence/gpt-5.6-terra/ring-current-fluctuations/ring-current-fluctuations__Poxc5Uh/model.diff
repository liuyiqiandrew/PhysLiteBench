-        raise NotImplementedError("Fit diffusivity from the calibration records.")
+        """Estimate the common diffusivity by inverse-variance regression.
+
+        Each calibration record has mean ``diffusivity * x``, where
+        ``x = bias * (bias + 2 * field) / 4``. Known independent Gaussian
+        errors make the weighted least-squares estimator the maximum-
+        likelihood estimate.
+        """
+        records = list(records)
+        if not records:
+            # There is no evidence with which to update the valid initial
+            # value. Keeping it also makes fitting an empty batch benign.
+            return self
+
+        inputs = [record["input"] for record in records]
+        response = np.asarray([record["value"] for record in records], dtype=float)
+        sigma = np.asarray([record["sigma"] for record in records], dtype=float)
+        design = predict_at(inputs, 1.0)
+
+        if (not np.isfinite(response).all() or not np.isfinite(sigma).all()
+                or not np.isfinite(design).all() or np.any(sigma <= 0.0)):
+            raise ValueError("calibration records require finite values and positive sigma")
+
+        weights = 1.0 / np.square(sigma)
+        denominator = float(np.dot(weights, np.square(design)))
+        if not np.isfinite(denominator) or denominator <= 0.0:
+            raise ValueError("calibration records do not identify diffusivity")
+
+        estimate = float(np.dot(weights * design, response) / denominator)
+        # The supported physical calibration range is part of the model
+        # contract, so use the constrained maximum-likelihood estimate.
+        self.diffusivity = float(np.clip(estimate, _MIN_DIFFUSIVITY, _MAX_DIFFUSIVITY))
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
