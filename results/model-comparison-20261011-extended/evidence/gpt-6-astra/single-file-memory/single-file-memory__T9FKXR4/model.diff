     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Fit sqrt(D) by Gaussian weighted least squares within D's bounds."""
+        records = list(records)
+        if not records:
+            raise ValueError("At least one calibration record is required.")
+
+        factors = predict_at((r["input"] for r in records), 1.0)
+        values = np.asarray([r["value"] for r in records], dtype=float)
+        sigma = np.asarray([r["sigma"] for r in records], dtype=float)
+        if not (
+            np.isfinite(factors).all() and (factors > 0).all()
+            and np.isfinite(values).all()
+            and np.isfinite(sigma).all() and (sigma > 0).all()
+        ):
+            raise ValueError("Calibration requires finite values and positive factors and sigma.")
+
+        # The covariance is linear in sqrt(D), with no additive offset.
+        design = factors / sigma
+        amplitude = np.dot(design, values / sigma) / np.dot(design, design)
+        amplitude = np.clip(amplitude, np.sqrt(0.8), np.sqrt(1.2))
+        self.diffusivity = float(np.clip(amplitude**2, 0.8, 1.2))
+        return self
 
