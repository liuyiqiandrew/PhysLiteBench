 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Long-time tagged covariance for the deterministic initial lattice.
+
+    Initial density fluctuations vanish. Integrating the diffusive current
+    noise gives (2*D/density) times the integral, from 0 to min(t, s), of
+    [4*pi*D*(t+s-2*u)]**(-1/2). This yields the expression below, including
+    the equal-time variance sqrt(2*D*t/pi)/density.
+    """
+    return np.sqrt(diffusivity / np.pi) / density * (
+        np.sqrt(time_a + time_b) - np.sqrt(abs(time_a - time_b))
+    )
 
 
