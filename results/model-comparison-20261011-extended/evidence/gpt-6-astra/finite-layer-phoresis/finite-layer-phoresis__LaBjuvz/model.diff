+def response(radius, width, strength, slip):
+    """Velocity divided by concentration gradient, at unit viscosity.
+
+    The reciprocal translating-sphere flow has radial factor
+        H(r) = 3*a*d/(2*r) - a**3/(2*(1+3*b/a)*r**3),
+    with drag 6*pi*eta*a*d and d = (1+2*b/a)/(1+3*b/a).
+    Combining fluid forcing with the reaction on the sphere gives the
+    radial weight r**2*(1-H)/d. Its stable, factored decomposition is
+        (r-a)**2*(2*r+a)/(2*r) + b/(a+2*b)*(r**2-a**3/r).
+    Thus slip affects both the force weighting and the drag. No thin-layer
+    approximation is made, and the surface reaction cancels at H(a)=1.
+    """
+    if strength == 0:
+        return 0.0
+    no_slip, slip_part = _response_integrals(radius, width, strength)
+    return no_slip + slip / (radius + 2 * slip) * slip_part
 
 
