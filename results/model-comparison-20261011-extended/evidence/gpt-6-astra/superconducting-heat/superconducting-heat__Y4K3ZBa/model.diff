+def _event_rates(left, right, channels, mu, gaps, ratio):
+    """Rates and their first two mu derivatives, in RATE_CONVERSION*G units.
+
+    Each row is a forward/reverse event pair with opposite spin/work marks.
+    The equal-energy flip DOS cancels its energy-dependent relaxation time.
+    """
+    energy, other, measure, sl, sr, pair, work, _, pf, pb, injection = channels
+    f = expit((sl*mu[0]-energy)/left)
+    g = expit((sr*mu[1]-other)/right)
+    df, dg = sl*f*(1-f)/left, sr*g*(1-g)/right
+    ddf, ddg = f*(1-f)*(1-2*f)/left**2, g*(1-g)*(1-2*g)/right**2
+    a = np.where(pair, 1-f, f)
+    da, dda = np.where(pair, -df, df), np.where(pair, -ddf, ddf)
+
+    def product(a, da, dda, b, db, ddb, weight):
+        rate = np.sum(weight*a*b, axis=1)
+        gradient = np.column_stack((np.sum(weight*da*b, axis=1),
+                                    np.sum(weight*a*db, axis=1)))
+        hessian = np.empty((len(rate), 2, 2))
+        hessian[:, 0, 0] = np.sum(weight*dda*b, axis=1)
+        hessian[:, 1, 1] = np.sum(weight*a*ddb, axis=1)
+        hessian[:, 0, 1] = hessian[:, 1, 0] = np.sum(weight*da*db, axis=1)
+        return rate, gradient, hessian
+
+    forward = product(a, da, dda, 1-g, -dg, -ddg, measure*pf)
+    backward = product(1-a, -da, -dda, g, dg, ddg, measure*pb)
+    rates = [forward[0], backward[0]]
+    gradients = [forward[1], backward[1]]
+    hessians = [forward[2], backward[2]]
+    spins, works = [injection, -injection], [work, -work]
+
+    for j, (temperature, delta, polarization) in enumerate(zip((left, right), gaps, mu)):
+        # These integrands are smooth (no BCS edge singularity).
+        span = 80*temperature + 6*abs(polarization)
+        energy = delta + (NODES+1)*span/2
+        measure = WEIGHTS*span/2*ratio/2
+        for spin in (1, -1):
+            u = expit((spin*polarization-energy)/temperature)
+            v = expit((-spin*polarization-energy)/temperature)
+            du = spin*u*(1-u)/temperature
+            dv = -spin*v*(1-v)/temperature
+            ddu = u*(1-u)*(1-2*u)/temperature**2
+            ddv = v*(1-v)*(1-2*v)/temperature**2
+            gradient, hessian = np.zeros((1, 2)), np.zeros((1, 2, 2))
+            gradient[0, j] = measure @ (du*(1-v)-u*dv)
+            hessian[0, j, j] = measure @ (ddu*(1-v)-2*du*dv-u*ddv)
+            jump = np.zeros((1, 2))
+            jump[0, j] = -2*spin
+            rates.append(np.array([measure @ (u*(1-v))]))
+            gradients.append(gradient)
+            hessians.append(hessian)
+            spins.append(jump)
+            works.append(np.zeros(1))
+    return tuple(np.concatenate(items) for items in (rates, gradients, hessians, spins, works))
