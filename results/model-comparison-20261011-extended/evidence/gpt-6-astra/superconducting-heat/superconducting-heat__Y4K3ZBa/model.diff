+def _gate_cumulants(args, conductance, secondary, quadratic, momentum, nodes, count):
+    """Leading extensive long-time cumulants from the tilted jump Hamiltonian.
+
+    H(mu,p,z) = sum_e r_e(mu) [exp(p.v_e + z*w_e)-1].
+    Its stationary saddle gives the macroscopic scaled cumulant generator.
+    Using mu rather than S as state coordinates is legitimate at this saddle:
+    dS/dmu is nonsingular and cancels out of the zero-frequency response.
+    """
+    if args[3] == 0:
+        return dict(noise=0., third=0., shot=0., screened_poisson=0.)
+    kwargs = dict(secondary_coupling=secondary, quadratic_coupling=quadratic,
+                  momentum_coupling=momentum)
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kwargs)
+    dl, dr, channels = prepare(*args, nodes=nodes, count=count,
+                              window=state['search_bound'], **kwargs)
+    ratio = QUASIPARTICLE_DENSITY/(NORMAL_POLARIZATION_TIME*RATE_CONVERSION*conductance)
+    rates, gradient, hessian, jumps, work = _event_rates(
+        *args[:2], channels, state['mu'], (dl, dr), ratio)
+    jacobian = jumps.T @ gradient
+    # First derivatives of the conjugate spin field and the tilted spin state.
+    p1 = -np.linalg.solve(jacobian.T, work @ gradient)
+    mark = work + jumps @ p1
+    mu1 = -np.linalg.solve(jacobian, jumps.T @ (rates*mark))
+    noise = rates @ mark**2
+    poisson_third = rates @ mark**3
+    # Rate modulation and nonlinear spin feedback both survive the size limit.
+    modulation = 3 * (mark**2 @ gradient) @ mu1
+    curvature = 3 * np.einsum('e,eij,i,j->', mark, hessian, mu1, mu1)
+    third = poisson_third + modulation + curvature
+    rate_scale = RATE_CONVERSION*conductance
+    return dict(noise=float(noise*rate_scale*(KB*1e12)**2),
+                third=float(third*rate_scale*(KB*1e12)**3),
+                shot=float((rates @ work**2)*rate_scale*(KB*1e12)**2),
+                screened_poisson=float(poisson_third*rate_scale*(KB*1e12)**3),
+                count_response=p1.tolist(), state_response=mu1.tolist())
+
