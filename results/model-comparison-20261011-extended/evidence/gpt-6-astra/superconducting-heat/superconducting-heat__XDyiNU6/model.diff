+def event_moments(left, right, gaps, channels, mu, ratio):
+    """Integrated bidirectional event rates and their spin-potential derivatives.
+
+    Rates are divided by RATE_CONVERSION * conductance. Each row is a
+    transition and its reverse, with the listed spin and gate-work increments
+    referring to the forward event. The last two rows are local spin flips.
+    """
+    energy, other, measure, sl, sr, pair, work, recoil, pf, pb, injection = channels
+    f = expit((sl*mu[0]-energy)/left)
+    g = expit((sr*mu[1]-other)/right)
+    df, dg = sl*f*(1-f)/left, sr*g*(1-g)/right
+    ddf, ddg = f*(1-f)*(1-2*f)/left**2, g*(1-g)*(1-2*g)/right**2
+
+    a, da, dda = np.where(pair, 1-f, f), np.where(pair, -df, df), np.where(pair, -ddf, ddf)
+    b, db, ddb = 1-g, -dg, -ddg
+    c, dc, ddc = 1-a, -da, -dda
+    d, dd, ddd = g, dg, ddg
+    plus, minus = pf*a*b, pb*c*d
+    net = np.sum(measure*(plus-minus), axis=1)
+    activity = np.sum(measure*(plus+minus), axis=1)
+    net_gradient = np.column_stack((
+        np.sum(measure*(pf*da*b-pb*dc*d), axis=1),
+        np.sum(measure*(pf*a*db-pb*c*dd), axis=1)))
+    activity_gradient = np.column_stack((
+        np.sum(measure*(pf*da*b+pb*dc*d), axis=1),
+        np.sum(measure*(pf*a*db+pb*c*dd), axis=1)))
+    net_hessian = np.empty((len(net), 2, 2))
+    net_hessian[:, 0, 0] = np.sum(measure*(pf*dda*b-pb*ddc*d), axis=1)
+    net_hessian[:, 1, 1] = np.sum(measure*(pf*a*ddb-pb*c*ddd), axis=1)
+    net_hessian[:, 0, 1] = net_hessian[:, 1, 0] = np.sum(measure*(pf*da*db-pb*dc*dd), axis=1)
+
+    flip_net, flip_activity = np.zeros(2), np.zeros(2)
+    flip_gradient, flip_activity_gradient = np.zeros((2, 2)), np.zeros((2, 2))
+    flip_hessian = np.zeros((2, 2, 2))
+    for j, (temperature, delta, pol) in enumerate(zip((left, right), gaps, mu)):
+        # N(E)/tau(E) = 1/tau_n, so no BCS density remains in
+        # these equal-energy spin-flip integrals. Forward flips change S by -2.
+        loss, slope = spin_loss(temperature, delta, pol)
+        up, down = expit((pol-delta)/temperature), expit((-pol-delta)/temperature)
+        curvature = (up*(1-up)-down*(1-down))/temperature
+        x = pol/temperature
+        if abs(x) < 1e-4:
+            f0 = expit(-delta/temperature)
+            slope0 = 2*f0
+            cubic0 = 2*f0*(1-f0)*(1-2*f0)/temperature**2
+            coefficient = slope0/(3*temperature) + temperature*cubic0/6
+            intensity = temperature*slope0 + coefficient*pol**2
+            intensity_derivative = 2*coefficient*pol
+        else:
+            coth = 1/np.tanh(x)
+            intensity = loss*coth
+            intensity_derivative = slope*coth-loss*(coth*coth-1)/temperature
+        flip_net[j] = ratio/2*loss
+        flip_activity[j] = ratio/2*intensity
+        flip_gradient[j, j] = ratio/2*slope
+        flip_activity_gradient[j, j] = ratio/2*intensity_derivative
+        flip_hessian[j, j, j] = ratio/2*curvature
+
+    return (np.r_[net, flip_net], np.r_[activity, flip_activity],
+            np.concatenate((net_gradient, flip_gradient)),
+            np.concatenate((activity_gradient, flip_activity_gradient)),
+            np.concatenate((net_hessian, flip_hessian)),
+            np.vstack((injection, -2*np.eye(2))), np.r_[work, 0., 0.])
+
