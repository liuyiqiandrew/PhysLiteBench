+def gate_statistics(e, conductance, nodes=192, count=64):
+    """Leading extensive long-time cumulants of the fluctuating spin process.
+
+    The tilted jump Hamiltonian is H(mu,p,k) = sum r(mu)
+    [exp(p.deltaS + k.work)-1]. Its stationary saddle gives the macroscopic
+    cumulant rate. Spin potentials may parameterize the saddle in place of
+    spin numbers: the susceptibility is invertible and cancels from the
+    stationary equations H_mu=H_p=0.
+
+    Differentiating those equations once gives the count response p1 and
+    the state response mu1. The third derivative of H includes both the
+    derivative of the event activity and the curvature of the spin drift.
+    These terms retain the rate feedback omitted by screened Poisson counts.
+    """
+    if e.get('amplitude', 0.) == 0:
+        return dict(noise=0., third=0., shot=0., screened_poisson=0.)
+    args = oscillator_arguments(e)
+    kwargs = dict(secondary_coupling=e.get('secondary_coupling', 0.),
+                  quadratic_coupling=e.get('quadratic_coupling', 0.),
+                  momentum_coupling=e.get('momentum_coupling', 0.))
+    state = stationary(*args, conductance, nodes=nodes, count=count, **kwargs)
+    dl, dr, channels = prepare(*args, nodes=nodes, count=count,
+                              window=state['search_bound'], **kwargs)
+    ratio = QUASIPARTICLE_DENSITY/(NORMAL_POLARIZATION_TIME*RATE_CONVERSION*conductance)
+    net, activity, gradient, activity_gradient, hessian, injection, work = event_moments(
+        args[0], args[1], (dl, dr), channels, state['mu'], ratio)
+    drift_jacobian = injection.T @ gradient
+    work_gradient = work @ gradient
+    p1 = -np.linalg.solve(drift_jacobian.T, work_gradient)
+    mark = work + injection @ p1
+    mu1 = -np.linalg.solve(drift_jacobian, injection.T @ (activity*mark))
+
+    noise = activity @ mark**2
+    poisson_third = net @ mark**3
+    activity_feedback = 3*(mark**2 @ activity_gradient) @ mu1
+    drift_feedback = 3*np.einsum('i,ijk,j,k', mark, hessian, mu1, mu1)
+    third = poisson_third + activity_feedback + drift_feedback
+    rate_scale = RATE_CONVERSION*conductance
+    noise_scale, third_scale = rate_scale*(KB*1e12)**2, rate_scale*(KB*1e12)**3
+    return dict(noise=float(noise*noise_scale), third=float(third*third_scale),
+                shot=float((activity @ work**2)*noise_scale),
+                screened_poisson=float(poisson_third*third_scale),
+                activity_feedback=float(activity_feedback*third_scale),
+                drift_feedback=float(drift_feedback*third_scale),
+                count_response=p1.tolist(), state_response=mu1.tolist(),
+                mu=state['mu'].tolist())
+
+
+def gate_third(e, conductance, nodes=192, count=64):
+    return gate_statistics(e, conductance, nodes, count)
+
