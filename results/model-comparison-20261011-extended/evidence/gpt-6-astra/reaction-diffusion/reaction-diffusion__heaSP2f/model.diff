+def fluctuation_matrices(totals, diffusivity):
+    """Equilibrium susceptibility and zero-current constituent mobility.
+
+    Ideal species populations have covariance diag(c). Conditioning on zero
+    charge gives a Schur complement; mapping to conserved constituents then
+    includes fluctuations of the equilibrium cluster population. Association
+    events themselves conserve these constituents and add no separate noise.
+
+    The same charge projection applied to diag(D_i*c_i) removes the Brownian
+    charge current as well as the deterministic current.
+    """
+    concentration = equilibrium(totals)
+    population = np.diag(concentration)
+    population_charge = population @ CHARGE
+    conditional = population - np.outer(population_charge, population_charge) / (
+        CHARGE @ population_charge
+    )
+    susceptibility = CONSTITUENTS @ conditional @ CONSTITUENTS.T
+
+    mobile = np.diag(diffusivity * RELATIVE_DIFFUSIVITY * concentration)
+    mobile_charge = mobile @ CHARGE
+    constrained = mobile - np.outer(mobile_charge, mobile_charge) / (CHARGE @ mobile_charge)
+    mobility = CONSTITUENTS @ constrained @ CONSTITUENTS.T
+    return susceptibility, mobility
+
+
+def equilibrium_correlations(t, totals, harmonic, diffusivity):
+    """S(t) = exp(-q^2 M chi^-1 t) chi, evaluated symmetrically."""
+    covariance, mobility = fluctuation_matrices(totals, diffusivity)
+    # Generalized eigenvectors obey V.T @ chi @ V = I. Thus chi @ V is
+    # a covariance factor, and all decay rates are real and nonnegative.
+    rates, vectors = eigh(mobility, covariance)
+    factors = covariance @ vectors
+    q_squared = (harmonic * np.pi / CELL_LENGTH)**2
+    decay = np.exp(-np.asarray(t, dtype=float)[:, None] * q_squared * rates)
+    return np.einsum('ik,tk,jk->tij', factors, decay, factors)
+
 
