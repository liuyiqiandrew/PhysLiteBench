+    """Return free A, B, C and bound P at prescribed total A and B.
+
+    The scalar mass-action equation is strictly increasing in P on
+    [0, min(total_A, total_B)]. Newton iteration from zero approaches its
+    unique physical root from below.
+    """
+    total = np.asarray(total, dtype=float)
+    a, b = total[..., 0], total[..., 1]
+    bound = np.zeros_like(a)
+    for _ in range(64):
+        free_a, free_b = a - bound, b - bound
+        anion = free_a + free_b
+        value = bound - ASSOCIATION * free_a * free_b * anion**2
+        derivative = 1 + ASSOCIATION * (anion**3 + 4 * free_a * free_b * anion)
+        updated = np.clip(bound - value / derivative, 0., np.minimum(a, b))
+        if np.all(np.abs(updated - bound) <= 1e-14 * (1 + np.abs(bound))):
+            bound = updated
+            break
+        bound = updated
+    return np.stack((a - bound, b - bound, a + b - 2 * bound, bound), axis=-1)
