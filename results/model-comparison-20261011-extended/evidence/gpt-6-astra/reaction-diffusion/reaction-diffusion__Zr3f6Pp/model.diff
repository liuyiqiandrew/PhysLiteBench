+def equilibrium_correlations(t, totals, harmonic, diffusivity):
+    """Return exp(-q^2 M C^-1 t) C in a symmetric, stable representation."""
+    covariance, mobility = fluctuation_matrices(totals, diffusivity)
+    root = cholesky(covariance, lower=True)
+    left = solve_triangular(root, mobility, lower=True)
+    symmetric_rate = solve_triangular(root, left.T, lower=True).T
+    rates, vectors = eigh(symmetric_rate)
+    modes = root @ vectors
+    decay = np.exp(-np.asarray(t)[:, None] * (harmonic * np.pi / .001)**2
+                   * rates[None, :])
+    return np.einsum("ik,tk,jk->tij", modes, decay, modes)
