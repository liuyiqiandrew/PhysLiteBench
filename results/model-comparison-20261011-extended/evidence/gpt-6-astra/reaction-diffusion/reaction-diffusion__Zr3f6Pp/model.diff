+        """Maximum-likelihood fit of the single diffusion scale.
+
+        The calibration contains binary electrolytes, whose zero-current
+        diffusion coefficients are 4D/3 (A,C) and 8D/3 (B,C).
+        """
+        t = np.asarray(data["t"], dtype=float)
+        x = np.asarray(data["x"], dtype=float)
+        initial = np.asarray(data["initial"], dtype=float)
+        observed = np.asarray(data["concentration"], dtype=float)
+        sigma = np.asarray(data["sigma"], dtype=float)
+        if np.any(sigma <= 0) or not np.all(np.isfinite(sigma)):
+            raise ValueError("Calibration uncertainties must be positive and finite.")
+
+        # Optimize a dimensionless logarithm to keep D positive and avoid
+        # absolute optimizer tolerances on a parameter of order 1e-9.
+        positive_times = t[t > 0]
+        if not len(positive_times):
+            raise ValueError("Calibration requires positive observation times.")
+        scale = (x[-1] - x[0])**2 / np.max(positive_times)
+
+        def objective(log_scale):
+            self.diffusivity = scale * np.exp(log_scale)
+            predicted = np.array([self.predict(t, x, profile)
+                                  for profile in initial])
+            residual = (predicted - observed) / sigma
+            return np.sum(residual**2)
+
+        result = minimize_scalar(objective, bounds=(-20., 20.),
+                                 method="bounded",
+                                 options={"xatol": 1e-10})
+        if not result.success:
+            raise RuntimeError("Diffusivity fit failed: " + result.message)
+        self.diffusivity = float(scale * np.exp(result.x))
+        return self
 
