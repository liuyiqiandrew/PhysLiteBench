     def fit(self, records):
-        raise NotImplementedError('Implement calibration fitting.')
+        """Infer the uniform dynamic viscosity from calibration records.
+
+        The response is linear in ``1/viscosity`` about a fixed concentration
+        gradient, so the maximum-likelihood estimate with independent Gaussian
+        errors is a one-parameter weighted least-squares problem with the
+        closed form
+
+            viscosity = sum(a_i^2 / sigma_i^2) / sum(a_i y_i / sigma_i^2),
+
+        where ``a_i`` is the reduced response of record ``i`` and ``y_i`` its
+        measured value.
+        """
+        a = np.empty(len(records), dtype=float)
+        y = np.empty(len(records), dtype=float)
+        w = np.empty(len(records), dtype=float)
+        for i, record in enumerate(records):
+            a[i] = _reduced_response(record['input'])
+            y[i] = float(record['value'])
+            sigma = float(record.get('sigma', DEFAULT_SIGMA))
+            w[i] = 1.0 / sigma ** 2
+
+        denom = np.sum(w * a * y)
+        numer = np.sum(w * a * a)
+        if numer <= 0.0 or denom == 0.0:
+            # Degenerate calibration (no measurable response); fall back to the
+            # midpoint of the admissible viscosity range.
+            self.viscosity = 1.2
+        else:
+            self.viscosity = numer / denom
+        return self
 
     def predict(self, experiments):
+        if self.viscosity is None:
+            raise RuntimeError('Model must be fitted before predicting.')
         return predict_at(experiments, self.viscosity)
