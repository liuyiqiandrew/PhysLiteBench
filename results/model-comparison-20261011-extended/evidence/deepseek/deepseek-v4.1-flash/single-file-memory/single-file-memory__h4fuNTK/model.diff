--- starter/model.py
+++ submission/model.py
@@ -1,16 +1,52 @@
+"""Model of the limiting tagged-particle covariance in single-file diffusion.
+
+Identical Brownian point particles diffuse on a line with reflecting
+collisions, starting from the lattice ``j / density``.  Tracking the particle
+at the origin, the displacement fluctuations of the tagged particle are
+subdiffusive: the process is self-similar with Hurst exponent ``1/4``.  Hence
+in the limit ``lambda -> infinity`` the rescaled two-time covariance
+
+    lim_{lambda->infinity} Cov[X(lambda*time_a), X(lambda*time_b)] / sqrt(lambda)
+
+has the fractional-Brownian-motion time structure
+``sqrt(time_a) + sqrt(time_b) - sqrt(|time_a - time_b|)``.  The overall scale
+depends on the common diffusivity ``D`` and on the density.
+"""
+
 import numpy as np
+
+_TWO_PI = 2.0 * np.pi
+# Documented admissible range for the unknown common diffusivity.
+_D_MIN = 0.8
+_D_MAX = 1.2
 
 
 def covariance(diffusivity, density, time_a, time_b):
-    return np.sqrt(diffusivity/(2*np.pi))/density * (np.sqrt(time_a)+np.sqrt(time_b)-np.sqrt(abs(time_a-time_b)))
+    """Limiting covariance coefficient for one experiment.
+
+    The tagged-particle limit is a Hurst-1/4 self-similar process, so the
+    time dependence is ``sqrt(a) + sqrt(b) - sqrt(|a - b|)`` and the scale is
+    ``sqrt(D / (2*pi)) / density``.
+    """
+    time_a = float(time_a)
+    time_b = float(time_b)
+    shape = np.sqrt(time_a) + np.sqrt(time_b) - np.sqrt(abs(time_a - time_b))
+    return np.sqrt(float(diffusivity) / _TWO_PI) / float(density) * shape
 
 
 def predict_at(experiments, diffusivity):
     return np.asarray([
-        covariance(float(diffusivity), float(e["density"]),
+        covariance(diffusivity, float(e["density"]),
                    float(e["time_a"]), float(e["time_b"]))
         for e in experiments
     ], dtype=float)
+
+
+def _shape_factor(time_a, time_b):
+    """fBM(H=1/4) time structure for one experiment."""
+    time_a = float(time_a)
+    time_b = float(time_b)
+    return np.sqrt(time_a) + np.sqrt(time_b) - np.sqrt(abs(time_a - time_b))
 
 
 class Model:
@@ -18,7 +54,45 @@
         self.diffusivity = None
 
     def fit(self, records):
-        raise NotImplementedError("Fit the common diffusivity from the calibration records.")
+        """Infer the common diffusivity from calibration records.
+
+        Because ``value = sqrt(D) * shape / (density * sqrt(2*pi))`` is linear
+        in ``sqrt(D)``, the maximum-likelihood estimate under the known
+        Gaussian instrument noise ``sigma`` is a weighted least-squares fit of
+        that single parameter.
+        """
+        records = list(records)
+        if not records:
+            self.diffusivity = 0.5 * (_D_MIN + _D_MAX)
+            return self
+
+        weights = np.empty(len(records), dtype=float)
+        design = np.empty(len(records), dtype=float)
+        values = np.empty(len(records), dtype=float)
+
+        for i, record in enumerate(records):
+            inp = record["input"]
+            sigma = float(record.get("sigma", 1.0))
+            weights[i] = 1.0 / (sigma * sigma)
+            design[i] = _shape_factor(inp["time_a"], inp["time_b"]) / (
+                float(inp["density"]) * np.sqrt(_TWO_PI)
+            )
+            values[i] = float(record["value"])
+
+        denom = float(np.sum(weights * design * design))
+        if not np.isfinite(denom) or denom <= 0.0:
+            self.diffusivity = 0.5 * (_D_MIN + _D_MAX)
+            return self
+
+        sqrt_d = float(np.sum(weights * design * values)) / denom
+        if not np.isfinite(sqrt_d) or sqrt_d < 0.0:
+            sqrt_d = 0.0
+
+        diffusivity = sqrt_d * sqrt_d
+        # Respect the documented physical range.
+        diffusivity = min(max(diffusivity, _D_MIN), _D_MAX)
+        self.diffusivity = diffusivity
+        return self
 
     def predict(self, experiments):
         return predict_at(experiments, self.diffusivity)
