+def _bound_contribution(pole, temperature, contact, sine, band_energy,
+                        weights):
+    """Contribution of one final bound state.
+
+    If Z is the orbital weight of the bound state, its initial occupation is
+    Z times [1 + V**2 q], where q is the thermal chain resolvent squared.
+    The readout adds another factor Z from the orbital component.
+    """
+    derivative = (1-abs(pole)/np.sqrt(pole**2-4))/2
+    orbital_weight = 1/(1-contact**2*derivative)
+    filling = expit(-band_energy/temperature)
+    q = float(weights@(
+        (2/np.pi)*sine**2*filling/(pole-band_energy)**2))
+    return orbital_weight**2*(1+contact**2*q)
 
 
