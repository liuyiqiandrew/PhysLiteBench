 def _occupation(energy, temperature, contact):
+    """Thermodynamic-limit, infinite-time orbital occupation.
+
+    The continuum part is the spectral weight of the orbital multiplied by
+    the occupation of the initially uncoupled chain.  For sufficiently large
+    contact there are also one or two bound states outside the chain band.
+    Their occupation cannot be replaced by a Fermi function: the contact is
+    switched on suddenly and there is no relaxation.  The bound-state
+    occupation is therefore computed from its overlap with the initial
+    orbital and with the initial thermal chain.
+    """
+    energy = float(energy)
+    temperature = float(temperature)
+    contact = float(contact)
