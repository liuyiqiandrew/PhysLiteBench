+def impedance(e, viscosity):
+    """Rotational hydrodynamic impedance of the sphere."""
+
+    a = float(e["radius"])
+    z = _dimensionless_z(e, viscosity)
+    eta = float(viscosity)
+    return 8.0 * np.pi * eta * a**3 * (1.0 + z * z / (3.0 * (1.0 + z)))
+
+
+def _temperature_weight(z):
+    """Return the coefficient multiplying ``rise`` in the effective T.
+
+    For a unit-amplitude rotational flow, let rho=r/a.  Its only nonzero
+    strain component is proportional to
+
+        exp(-z*(rho-1))/(1+z) *
+        (z**2/rho + 3*z/rho**2 + 3/rho**3).
+
+    The noise spectrum weights this strain squared by T(rho).  Since
+    T=ambient+rise/rho, the needed coefficient is the ratio of the integrals
+    with rho and rho**2 as their radial volume weights.
+    """
+
+    if abs(z) == 0.0:
+        # q = -3/rho**3, so the ratio is
+        # (9*integral rho^-5)/(9*integral rho^-4) = (9/4)/3.
+        return 0.75
+
+    rho = _quad_rho
+    q = (
+        np.exp(-z * (rho - 1.0))
+        / (1.0 + z)
+        * (z * z / rho + 3.0 * z / rho**2 + 3.0 / rho**3)
+    )
+    weight = _quad_w * _quad_jacobian
+    numerator = np.sum(weight * rho * np.abs(q) ** 2)
+    denominator = np.sum(weight * rho**2 * np.abs(q) ** 2)
+    return float(numerator / denominator)
+
+
+def spectrum(e, viscosity):
+    """Two-sided connected torque spectrum at one experiment."""
+
+    z = _dimensionless_z(e, viscosity)
+    effective_temperature = float(e["ambient"]) + float(e["rise"]) * _temperature_weight(z)
+    return float(2.0 * effective_temperature * np.real(impedance(e, viscosity)))
+
+
+def predict_at(experiments, viscosity):
+    """Evaluate spectra in input order and return a one-dimensional array."""
+
+    return np.asarray([spectrum(e, viscosity) for e in experiments], dtype=float)
+
+
+def _objective(viscosity, experiments, values, sigmas):
+    residual = (predict_at(experiments, viscosity) - values) / sigmas
+    return float(np.dot(residual, residual))
 
 
