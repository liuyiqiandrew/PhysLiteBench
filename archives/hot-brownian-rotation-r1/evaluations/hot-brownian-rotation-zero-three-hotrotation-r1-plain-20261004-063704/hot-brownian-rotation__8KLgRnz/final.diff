+# Gauss--Legendre nodes on [0, infinity), written as rho = 1 + u/(1-u).
+# This gives very accurate integrals for the rational, exponentially decaying
+# functions in the rotational Stokes solution over the stated frequency range.
+_quad_x, _quad_w = np.polynomial.legendre.leggauss(128)
+_quad_u = (_quad_x + 1.0) / 2.0
+_quad_w = _quad_w / 2.0
+_quad_rho = 1.0 + _quad_u / (1.0 - _quad_u)
+_quad_jacobian = 1.0 / (1.0 - _quad_u) ** 2
 
 
