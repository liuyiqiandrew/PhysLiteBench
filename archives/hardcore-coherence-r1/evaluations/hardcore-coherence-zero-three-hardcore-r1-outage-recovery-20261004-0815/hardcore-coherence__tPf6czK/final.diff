+def _make_basis():
+    """Make all three-particle occupation states and an index lookup."""
+    basis = []
+    for mask in range(1 << SITES):
+        if mask.bit_count() == PARTICLES:
+            basis.append(mask)
+    return tuple(basis), {mask: index for index, mask in enumerate(basis)}
+
