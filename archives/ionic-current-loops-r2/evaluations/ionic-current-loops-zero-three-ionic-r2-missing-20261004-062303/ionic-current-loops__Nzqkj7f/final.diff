+@lru_cache(maxsize=128)
+def fields(key, points=257):
+    """Return the preparation fields and their unit-diffusivity changes.
+
+    ``key`` contains only the four preparation arrays, so preparations can be
+    reused across detector choices and calibration records.  The spectral
+    grid is exact for the input trigonometric profiles and resolves the
+    smooth rational electric-field expression to far beyond the requested
+    detector modes.
+    """
+
+    experiment = json.loads(key)
+    x = np.arange(points, dtype=float) * (2.0 * np.pi / points)
+    modes = np.fft.fftfreq(points, 1.0 / points)
+
+    c01 = np.array(
+        [
+            experiment["means"][i]
+            + experiment["amplitudes"][i]
+            * np.cos(experiment["waves"][i] * x + experiment["phases"][i])
+            for i in (0, 1)
+        ],
+        dtype=float,
+    )
+    c = np.vstack((c01, c01.sum(axis=0)))
+
+    gradient = np.fft.ifft(
+        1j * modes * np.fft.fft(c, axis=1), axis=1
+    ).real
+
+    # With E positive in the direction of increasing x,
+    #     J_i / D = -r_i c_i' + z_i r_i c_i E.
+    # Charge conservation makes the total current constant:
+    #     I / D = -A + K E,
+    # where A=sum(z_i r_i c_i') and K=sum(r_i c_i).
+    conductivity = RATIOS @ c
+    diffusion_charge_gradient = (RATIOS * CHARGES) @ gradient
+    zero_current_field = diffusion_charge_gradient / conductivity
+
+    # No changing magnetic flux means the electrostatic voltage around the
+    # ring is zero.  Thus mean(E)=0, which determines the constant current.
+    current = -np.mean(zero_current_field) / np.mean(1.0 / conductivity)
+    electric = zero_current_field + current / conductivity
+
+    flux = (
+        -RATIOS[:, None] * gradient
+        + (RATIOS * CHARGES)[:, None] * c * electric
+    )
+    change = -np.fft.ifft(
+        1j * modes * np.fft.fft(flux, axis=1), axis=1
+    ).real
+
+    return x, c, electric, flux, change
 
 
