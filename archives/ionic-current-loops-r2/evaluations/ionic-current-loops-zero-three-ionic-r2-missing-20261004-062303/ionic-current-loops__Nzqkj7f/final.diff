+def _preparation_key(experiment):
+    return json.dumps(
+        {
+            name: experiment[name]
+            for name in ("means", "amplitudes", "waves", "phases")
+        },
+        sort_keys=True,
+        separators=(",", ":"),
+    )
+
+
+def predict_at(experiments, diffusivity):
+    """Predict the requested signed Fourier rates for a diffusivity."""
+
+    out = []
+    for experiment in experiments:
+        _, _, _, _, change = fields(_preparation_key(experiment))
+        points = change.shape[1]
+        x = np.arange(points, dtype=float) * (2.0 * np.pi / points)
+        weight = np.cos(
+            experiment["detector"] * x + experiment["detector_phase"]
+        )
+
+        # The documented coefficient is (1/pi) integral(change*cos), and
+        # the grid mean is (1/(2*pi)) integral(...).
+        out.append(
+            2.0
+            * diffusivity
+            * np.mean(change[experiment["species"]] * weight)
+        )
+
+    return np.asarray(out, dtype=float)
 
 
